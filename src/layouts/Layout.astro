---
import '../styles/global.css';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
	type?: string;
}

const { 
	title = "Chocolates Taboada | El Verdadero Chocolate Boliviano",
	description = "Producto 100% nacional. Conoce el verdadero Chocolate Boliviano, hecho en Bolivia desde la primera hasta la última etapa. Tradición desde 1903.",
	image = "/img/agostocbba.webp",
	url = "https://chocolatestaboada.pro",
	type = "website"
} = Astro.props;

const absoluteImageUrl = image.startsWith('http') ? image : `https://chocolatestaboada.pro${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />

		<!-- OPEN GRAPH / WHATSAPP / FACEBOOK / TELEGRAM -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:image:secure_url" content={absoluteImageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content="Chocolates Taboada" />
		<meta property="og:locale" content="es_BO" />

		<!-- TWITTER / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />

		<script is:inline>
			window.GLOBAL_API_URL = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' 
			  ? 'http://127.0.0.1:8001/api/v1' 
			  : 'https://sales-system-aptb.onrender.com/api/v1';

			// INSTANT VIEWPORT ANCHORING FOR DIRECT CATALOG / CATEGORY / PRODUCT LINKS
			(function() {
				try {
					var p = window.location.pathname.toLowerCase();
					var h = window.location.hash.toLowerCase();
					var isDirectCatalog = p.includes('/catalogo') || h.includes('cajas-especiales') || p.startsWith('/producto');
					if (isDirectCatalog) {
						if ('scrollRestoration' in history) {
							history.scrollRestoration = 'manual';
						}
						var jumpToCatalog = function() {
							var target = document.getElementById('cajas-especiales-nav') || document.getElementById('cajas-especiales');
							if (target) {
								target.scrollIntoView({ behavior: 'auto', block: 'start' });
							}
						};
						if (document.readyState === 'loading') {
							document.addEventListener('DOMContentLoaded', jumpToCatalog, { once: true });
						} else {
							jumpToCatalog();
						}
					}
				} catch(e) {}
			})();
		</script>

		<!-- PRECONNECT & DNS PREFETCH -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="dns-prefetch" href="https://sales-system-aptb.onrender.com">
		<link rel="dns-prefetch" href="https://freeipapi.com">

		<!-- PRELOAD CRITICAL HERO IMAGE -->
		<link rel="preload" as="image" href="/img/agostocbba.webp" type="image/webp" fetchpriority="high" />

		<!-- OPTIMIZED NON-RENDER-BLOCKING GOOGLE FONTS -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;0,900;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Pinyon+Script&display=swap" />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;0,900;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Pinyon+Script&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;0,900;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Pinyon+Script&display=swap" rel="stylesheet"></noscript>

		<!-- DEFERRED GOOGLE ANALYTICS (GTAG) TO PREVENT RENDER-BLOCKING -->
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  function loadGtag() {
		    const script = document.createElement('script');
		    script.async = true;
		    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-DKEQG7G6YN';
		    document.head.appendChild(script);
		    gtag('config', 'G-DKEQG7G6YN');
		  }

		  if ('requestIdleCallback' in window) {
		    requestIdleCallback(loadGtag, { timeout: 2000 });
		  } else {
		    window.addEventListener('load', loadGtag, { once: true });
		  }
		</script>
	</head>
	<body class="bg-warm-white text-chocolate font-sans antialiased min-h-screen flex flex-col overflow-x-hidden">
		<slot />
	</body>
</html>
