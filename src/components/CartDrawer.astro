---
// CartDrawer.astro - Componente Oficial de Carrito de Compras para Chocolates Taboada
---

<!-- FONDO OSCURO CON BACKDROP BLUR -->
<div
  id="cart-drawer-overlay"
  class="fixed inset-0 z-[99990] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-400"
></div>

<!-- PANEL DESLIZANTE DEL CARRITO (SLIDE-OVER DRAWER COMPACTO Y ELEGANTE) -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 z-[99999] h-full w-[360px] max-w-[88vw] sm:w-[410px] bg-[#FAF5F0] text-[#2A1612] shadow-[-15px_0_45px_rgba(0,0,0,0.4)] transform translate-x-full transition-transform duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-between overflow-hidden border-l border-[#2A1612]/10"
>
  
  <!-- CABECERA DEL CARRITO COMPACTA -->
  <div class="flex items-center justify-between px-4 py-3 sm:px-6 sm:py-4 border-b border-[#2A1612]/10 bg-[#F3ECE3]">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#2A1612]/5 flex items-center justify-center text-[#dcb041]">
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-[#8f6c49]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold font-serif text-[#2A1612] leading-tight">Mi Carrito</h2>
        <span id="cart-drawer-count-subtitle" class="text-[11px] text-[#5D4037]/75 font-semibold block">0 productos seleccionados</span>
      </div>
    </div>

    <button
      id="cart-drawer-close-btn"
      type="button"
      class="w-8 h-8 rounded-full bg-black/5 hover:bg-black/10 text-[#2A1612] flex items-center justify-center transition-all duration-200 cursor-pointer hover:rotate-90"
      aria-label="Cerrar carrito"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- LISTA CONTENEDORA DE PRODUCTOS (SCROLLABLE) -->
  <div id="cart-drawer-items-list" class="flex-1 overflow-y-auto p-3.5 sm:p-4 space-y-2.5">
    <!-- Los elementos se renderizan dinámicamente mediante JS -->
  </div>

  <!-- SECCIÓN INFERIOR DE RESUMEN Y CHECKOUT (COMPACTO Y FINO) -->
  <div class="border-t border-[#2A1612]/10 bg-[#F3ECE3] p-4 sm:p-5 space-y-2.5 sm:space-y-3 shadow-[0_-10px_25px_rgba(0,0,0,0.05)]">
    
    <!-- DESGLOSE DE VALORES -->
    <div class="space-y-1.5 text-xs sm:text-sm font-sans">
      <div class="flex justify-between items-center text-[#5D4037]">
        <span class="font-medium">Subtotal</span>
        <span id="cart-drawer-subtotal" class="font-bold text-[#2A1612]">Bs. 0.00</span>
      </div>
      <div class="flex justify-between items-center text-[#5D4037] text-[11px] sm:text-xs">
        <span class="font-medium">Costo de Envío</span>
        <span class="px-2 py-0.5 text-[10px] sm:text-[11px] bg-[#dcb041]/15 text-[#2A1612] border border-[#dcb041]/40 font-extrabold rounded-full flex items-center gap-1">
          <svg class="w-2.5 h-2.5 text-[#8f6c49]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          Depende de la ubicación de envío
        </span>
      </div>
    </div>

    <!-- TOTAL DESTACADO (COMPACTO Y PROPORCIONADO) -->
    <div class="flex justify-between items-baseline pt-2 border-t border-[#2A1612]/10">
      <span class="text-xs font-extrabold uppercase tracking-widest text-[#5D4037]">Total</span>
      <span id="cart-drawer-total" class="text-xl sm:text-2xl font-black font-serif text-[#2A1612] drop-shadow-sm">Bs. 0.00</span>
    </div>

    <!-- BOTÓN PRINCIPAL DE CHECKOUT A WHATSAPP (DISEÑO GOLD LUXURY) -->
    <button
      id="cart-drawer-checkout-btn"
      type="button"
      class="w-full py-3.5 px-5 bg-gradient-to-r from-[#dcb041] via-[#f4c856] to-[#c99a2e] hover:from-[#f6d98d] hover:via-[#dcb041] hover:to-[#b88926] text-[#2A1612] font-black text-xs sm:text-sm rounded-full shadow-[0_8px_25px_rgba(220,176,65,0.4)] hover:shadow-[0_12px_32px_rgba(220,176,65,0.6)] transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-between cursor-pointer group relative overflow-hidden"
    >
      <!-- Brillo shimmer dinámico -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-[130%] group-hover:animate-shimmer pointer-events-none"></div>

      <div class="flex items-center gap-2.5 relative z-10">
        <div class="w-7 h-7 rounded-full bg-[#2A1612] text-[#25D366] flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-110 transition-transform">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <span id="cart-checkout-btn-text" class="tracking-wide">Finalizar Pedido por WhatsApp</span>
      </div>

      <div class="w-7 h-7 rounded-full bg-[#2A1612]/10 group-hover:bg-[#2A1612] text-[#2A1612] group-hover:text-[#f6d98d] flex items-center justify-center transition-all duration-300 relative z-10 flex-shrink-0">
        <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </div>
    </button>
    <!-- ACCIONES DE COMPARTIR CARRITO -->
    <div id="cart-share-container" class="grid grid-cols-2 gap-2 pt-0.5">
      <button
        id="cart-share-link-btn"
        type="button"
        class="py-2.5 px-3 rounded-full bg-[#FAF5F0] hover:bg-[#2A1612] border border-[#d8cbba] hover:border-[#2A1612] text-[#2A1612] hover:text-[#f6d98d] font-bold text-[11px] transition-all duration-200 cursor-pointer flex items-center justify-center gap-1.5 shadow-xs group"
        title="Copiar enlace para que otra persona vea este mismo carrito"
      >
        <svg class="w-3.5 h-3.5 text-[#8f6c49] group-hover:text-[#f6d98d] transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
        </svg>
        <span id="cart-share-link-text">Copiar Link</span>
      </button>

      <button
        id="cart-share-wa-btn"
        type="button"
        class="py-2.5 px-3 rounded-full bg-[#25D366]/10 hover:bg-[#25D366] border border-[#25D366]/30 text-[#128C7E] hover:text-white font-bold text-[11px] transition-all duration-200 cursor-pointer flex items-center justify-center gap-1.5 shadow-xs group"
        title="Compartir lista y link del carrito por WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current text-[#25D366] group-hover:text-white transition-colors" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Compartir</span>
      </button>
    </div>

    <p class="text-[9.5px] sm:text-[10px] text-center text-[#5D4037]/75 font-sans leading-tight pt-0.5">
      🔒 Tu lista de productos se enviará verificada directo al WhatsApp de nuestra fábrica.
    </p>
  </div>

</aside>

<script is:inline>
  // ── LÓGICA UNIFICADA DEL CARRITO DE COMPRAS (POR CIUDAD Y PERSISTENTE) ──

  function getCartStorageKey() {
    const city = (localStorage.getItem('taboada_selected_city') || 'cochabamba').toLowerCase();
    return 'taboada_cart_' + city;
  }

  function getCartData() {
    try {
      const key = getCartStorageKey();
      let stored = localStorage.getItem(key);
      // Migración suave desde la clave antigua global 'taboada_cart' si existe
      if (!stored && key === 'taboada_cart_cochabamba') {
        const legacy = localStorage.getItem('taboada_cart');
        if (legacy) {
          localStorage.setItem('taboada_cart_cochabamba', legacy);
          stored = legacy;
        }
      }
      if (stored) return JSON.parse(stored);
    } catch(e) {}
    return [];
  }

  function saveCartData(items) {
    const key = getCartStorageKey();
    localStorage.setItem(key, JSON.stringify(items));
    updateCartUI();
  }

  window.openCartDrawer = function() {
    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-drawer-overlay');
    if (drawer && overlay) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      try { updateCartUI(); } catch(err) {}
    }
  };

  window.closeCartDrawer = function() {
    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-drawer-overlay');
    if (drawer && overlay) {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
    }
  };

  window.toggleCartFavorite = function(id) {
    const cart = getCartData();
    const item = cart.find(i => i.id === id);
    if (item) {
      item.isFavorite = !item.isFavorite;
      saveCartData(cart);
    }
  };

  window.changeCartQuantity = function(id, delta) {
    const cart = getCartData();
    const item = cart.find(i => i.id === id);
    if (item) {
      item.quantity += delta;
      if (item.quantity <= 0) {
        window.removeCartItem(id);
      } else {
        saveCartData(cart);
      }
    }
  };

  window.removeCartItem = function(id) {
    let cart = getCartData();
    cart = cart.filter(i => i.id !== id);
    saveCartData(cart);
  };

  function trackGACart(eventName, params) {
    if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
      window.gtag('event', eventName, params || {});
    }
  }

  window.addToCart = function(itemObj) {
    let cart = getCartData();
    const existing = cart.find(i => (itemObj.id && i.id === itemObj.id) || i.name === itemObj.name);
    const qtyToAdd = itemObj.quantity || 1;
    const itemPrice = typeof itemObj.price === 'number' ? itemObj.price : parseFloat((itemObj.price || '80').replace(/[^0-9.]/g, '')) || 80;
    if (existing) {
      existing.quantity += qtyToAdd;
    } else {
      cart.push({
        id: itemObj.id || 'item-' + Date.now(),
        name: itemObj.name || 'Chocolate Taboada',
        size: itemObj.size || 'Presentación Especial',
        price: itemPrice,
        quantity: qtyToAdd,
        img: itemObj.img || '/img/produc1.png',
        isFavorite: false
      });
    }
    saveCartData(cart);
    window.openCartDrawer();

    // Telemetría GA4: Añadir al Carrito
    trackGACart('add_to_cart', {
      currency: 'BOB',
      value: itemPrice * qtyToAdd,
      items: [{
        item_id: itemObj.id,
        item_name: itemObj.name,
        price: itemPrice,
        quantity: qtyToAdd
      }]
    });
  };

  function updateCartUI() {
    const cart = getCartData();
    const listEl = document.getElementById('cart-drawer-items-list');
    const countSubtitleEl = document.getElementById('cart-drawer-count-subtitle');
    const subtotalEl = document.getElementById('cart-drawer-subtotal');
    const totalEl = document.getElementById('cart-drawer-total');
    const checkoutBtnText = document.getElementById('cart-checkout-btn-text');
    const navBadgeEls = document.querySelectorAll('.cart-nav-badge-count');
    const mainBadgeEl = document.getElementById('cart-count-badge');

    // Total count & subtotal
    const totalCount = cart.reduce((acc, item) => acc + item.quantity, 0);
    const subtotalAmount = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);

    // Actualizar insignia en Navbar y flotante
    navBadgeEls.forEach(badge => {
      badge.textContent = totalCount;
      if (totalCount > 0) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    });

    if (mainBadgeEl) {
      mainBadgeEl.textContent = totalCount;
    }

    if (countSubtitleEl) {
      countSubtitleEl.textContent = `${totalCount} ${totalCount === 1 ? 'producto seleccionado' : 'productos seleccionados'}`;
    }

    if (subtotalEl) subtotalEl.textContent = `Bs. ${subtotalAmount.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `Bs. ${subtotalAmount.toFixed(2)}`;
    if (checkoutBtnText) checkoutBtnText.textContent = `Finalizar Pedido (${totalCount})`;

    if (!listEl) return;

    const shareContainerEl = document.getElementById('cart-share-container');
    const checkoutBtn = document.getElementById('cart-drawer-checkout-btn');

    if (cart.length === 0) {
      if (shareContainerEl) shareContainerEl.classList.add('hidden');
      if (checkoutBtn) {
        checkoutBtn.classList.add('opacity-50', 'pointer-events-none');
      }
      listEl.innerHTML = `
        <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center text-[#5D4037]/70">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-black/5 flex items-center justify-center mb-3 text-[#8f6c49]">
            <svg class="w-6 h-6 sm:w-7 sm:h-7 opacity-50" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
            </svg>
          </div>
          <p class="font-serif text-base sm:text-lg font-bold text-[#2A1612]">Tu carrito está vacío</p>
          <p class="text-xs text-[#5D4037]/80 mt-1 max-w-[210px] mx-auto leading-relaxed">Explora nuestras colecciones finas de chocolate y añade tus favoritos.</p>
          <a href="/#cajas-especiales" onclick="window.closeCartDrawer()" class="mt-3.5 px-5 py-2 rounded-full bg-gradient-to-r from-[#dcb041] to-[#f4c856] text-[#2A1612] font-black text-xs inline-flex items-center gap-1.5 hover:scale-105 transition-all duration-300 shadow-md cursor-pointer">
            Explorar catálogo <span>→</span>
          </a>
        </div>
      `;
      return;
    }

    if (shareContainerEl) shareContainerEl.classList.remove('hidden');
    if (checkoutBtn) {
      checkoutBtn.classList.remove('opacity-50', 'pointer-events-none');
    }

    listEl.innerHTML = cart.map(item => `
      <div class="flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-xl bg-white border border-[#2A1612]/8 shadow-sm hover:shadow-md transition-all duration-300 group">
        
        <!-- CONTENEDOR DE IMAGEN CON BOTÓN FAVORITO -->
        <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-lg bg-[#FAF5F0] flex items-center justify-center flex-shrink-0 p-1.5 border border-[#2A1612]/5 overflow-hidden">
          <img src="${item.img}" alt="${item.name}" class="max-w-full max-h-full object-contain filter drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
          <button
            type="button"
            onclick="window.toggleCartFavorite('${item.id}')"
            class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white/85 backdrop-blur-sm flex items-center justify-center text-[10px] transition-colors hover:bg-white cursor-pointer"
            title="Favorito"
          >
            ${item.isFavorite ? '❤️' : '🤍'}
          </button>
        </div>

        <!-- DETALLES DEL PRODUCTO Y PRECIO -->
        <div class="flex-1 min-w-0">
          <h3 class="font-serif font-bold text-xs sm:text-sm text-[#2A1612] truncate leading-snug">${item.name}</h3>
          <p class="text-[10px] sm:text-[11px] text-[#5D4037]/75 font-sans mt-0.5 truncate">${item.size}</p>
          <div class="font-extrabold text-xs sm:text-sm text-[#2A1612] mt-1">Bs. ${item.price.toFixed(2)}</div>
        </div>

        <!-- CONTROLES DE CANTIDAD Y ACCIÓN ELIMINAR -->
        <div class="flex flex-col items-end gap-1.5 sm:gap-2">
          <!-- BOTÓN ELIMINAR (BASURERO) -->
          <button
            type="button"
            onclick="window.removeCartItem('${item.id}')"
            class="text-[#5D4037]/45 hover:text-red-600 transition-colors p-0.5 cursor-pointer"
            title="Eliminar producto"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
          </button>

          <!-- SELECTOR DE CANTIDAD PILL (- 1 +) -->
          <div class="flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-[#FAF5F0] border border-[#2A1612]/10 shadow-inner">
            <button
              type="button"
              onclick="window.changeCartQuantity('${item.id}', -1)"
              class="w-4 h-4 sm:w-4.5 sm:h-4.5 rounded-full flex items-center justify-center text-[10px] font-bold text-[#2A1612] hover:bg-[#2A1612]/10 transition-colors cursor-pointer"
            >-</button>
            <span class="text-[11px] sm:text-xs font-black text-[#2A1612] px-0.5 min-w-[12px] text-center">${item.quantity}</span>
            <button
              type="button"
              onclick="window.changeCartQuantity('${item.id}', 1)"
              class="w-4 h-4 sm:w-4.5 sm:h-4.5 rounded-full flex items-center justify-center text-[10px] font-bold text-[#2A1612] hover:bg-[#2A1612]/10 transition-colors cursor-pointer"
            >+</button>
          </div>
        </div>

      </div>
    `).join('');
  }

  // ── FUNCIONES DE CODIFICACIÓN Y DECODIFICACIÓN DE CARRITO COMPARTIDO ──

  function generateShareCartUrl(cart, city) {
    if (!cart || cart.length === 0) return '';
    const currentCity = city || localStorage.getItem('taboada_selected_city') || 'cochabamba';
    const payload = {
      c: currentCity,
      items: cart.map(i => ({
        i: i.id,
        n: i.name,
        s: i.size,
        p: i.price,
        q: i.quantity,
        m: i.img
      }))
    };
    const jsonStr = JSON.stringify(payload);
    const base64 = btoa(unescape(encodeURIComponent(jsonStr)));
    return `${window.location.origin}/carrito?c=${encodeURIComponent(base64)}`;
  }

  function decodeShareCartUrl(encodedStr) {
    try {
      const jsonStr = decodeURIComponent(escape(atob(decodeURIComponent(encodedStr))));
      const payload = JSON.parse(jsonStr);
      if (payload && Array.isArray(payload.items) && payload.items.length > 0) {
        return {
          city: payload.c || 'cochabamba',
          items: payload.items.map(item => ({
            id: item.i || 'item-' + Date.now(),
            name: item.n || 'Chocolate Taboada',
            size: item.s || 'Presentación Especial',
            price: Number(item.p) || 0,
            quantity: Number(item.q) || 1,
            img: item.m || '/img/produc1.png',
            isFavorite: false
          }))
        };
      }
    } catch (e) {
      console.warn('Error decodificando carrito compartido:', e);
    }
    return null;
  }

  function checkAndRestoreSharedCart() {
    const urlParams = new URLSearchParams(window.location.search);
    let encodedCart = urlParams.get('c') || urlParams.get('cart');

    if (encodedCart) {
      const decoded = decodeShareCartUrl(encodedCart);
      if (decoded && decoded.items.length > 0) {
        const targetCity = decoded.city.toLowerCase();
        localStorage.setItem('taboada_selected_city', targetCity);
        const storageKey = 'taboada_cart_' + targetCity;
        localStorage.setItem(storageKey, JSON.stringify(decoded.items));

        window.dispatchEvent(new CustomEvent('cityChanged', { detail: { city: targetCity } }));
        updateCartUI();

        setTimeout(() => {
          if (typeof window.showTaboadaToast === 'function') {
            window.showTaboadaToast('¡Carrito compartido cargado con éxito! 🍫');
          }
          window.openCartDrawer();
        }, 350);

        // Limpiar URL sin recargar
        const cleanUrl = window.location.pathname + window.location.hash;
        window.history.replaceState({}, '', cleanUrl);
      }
    }
  }

  // Disparar UI inmediatamente si el DOM ya está listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      updateCartUI();
      checkAndRestoreSharedCart();
    });
  } else {
    updateCartUI();
    checkAndRestoreSharedCart();
  }

  // Escuchar clics globales para abrir el carrito desde cualquier botón
  document.addEventListener('click', function(e) {
    var el = e.target;
    var trigger = el && el.closest ? el.closest('#navbar-cart-btn, #mobile-drawer-cart-btn, #floating-cart-btn, .nav-cart-btn-trigger, [data-action="open-cart"]') : null;
    if (trigger) {
      e.preventDefault();
      var mobileClose = document.getElementById('mobile-close-btn');
      if (mobileClose) mobileClose.click();
      window.openCartDrawer();
    }
  });

  function setupCartListeners() {
    updateCartUI();

    var overlay = document.getElementById('cart-drawer-overlay');
    var closeBtn = document.getElementById('cart-drawer-close-btn');
    var checkoutBtn = document.getElementById('cart-drawer-checkout-btn');
    var shareLinkBtn = document.getElementById('cart-share-link-btn');
    var shareLinkText = document.getElementById('cart-share-link-text');
    var shareWaBtn = document.getElementById('cart-share-wa-btn');

    if (overlay) overlay.addEventListener('click', window.closeCartDrawer);
    if (closeBtn) closeBtn.addEventListener('click', window.closeCartDrawer);

    // Copiar link del carrito
    if (shareLinkBtn) {
      shareLinkBtn.addEventListener('click', async () => {
        const cart = getCartData();
        if (cart.length === 0) return;
        const shareUrl = generateShareCartUrl(cart);

        try {
          await navigator.clipboard.writeText(shareUrl);
        } catch {
          const textarea = document.createElement("textarea");
          textarea.value = shareUrl;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          document.body.removeChild(textarea);
        }

        if (typeof window.showTaboadaToast === 'function') {
          window.showTaboadaToast('¡Enlace del carrito copiado! 🎁 Listo para compartir');
        }

        if (shareLinkText) {
          const original = shareLinkText.textContent;
          shareLinkText.textContent = '¡Copiado! ✓';
          setTimeout(() => {
            if (shareLinkText) shareLinkText.textContent = original;
          }, 2000);
        }
      });
    }

    // Compartir carrito por WhatsApp
    if (shareWaBtn) {
      shareWaBtn.addEventListener('click', () => {
        const cart = getCartData();
        if (cart.length === 0) return;
        const currentCity = (localStorage.getItem('taboada_selected_city') || 'cochabamba').toUpperCase();
        const shareUrl = generateShareCartUrl(cart);
        const total = cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);

        let msg = `🍫 *¡Hola! Te comparto esta selección de Chocolates Taboada:*\n`;
        msg += `Ciudad: *${currentCity}*\n\n`;
        cart.forEach((item, idx) => {
          msg += `${idx + 1}. *${item.name}* (${item.size}) x${item.quantity} - Bs. ${(item.price * item.quantity).toFixed(2)}\n`;
        });
        msg += `\n*Total estimado:* Bs. ${total.toFixed(2)}\n\n`;
        msg += `👉 *Toca este enlace para abrir y pedir o modificar este mismo carrito:*\n${shareUrl}`;

        const waUrl = `https://wa.me/?text=${encodeURIComponent(msg)}`;
        window.open(waUrl, '_blank');
      });
    }

    // Escuchar clics en enlaces hacia #cajas-especiales para cerrar el carrito y desplazarse al catálogo
    document.addEventListener('click', function(e) {
      var el = e.target;
      var link = el && el.closest ? el.closest('a[href*="cajas-especiales"]') : null;
      if (link) {
        window.closeCartDrawer();
        var catalogSec = document.getElementById('cajas-especiales-nav') || document.getElementById('cajas-especiales');
        if (catalogSec) {
          e.preventDefault();
          catalogSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    // Escuchar cambio de ciudad para actualizar carrito de esa ciudad automáticamente
    window.addEventListener('cityChanged', function() {
      updateCartUI();
    });

    window.addEventListener('storage', (e) => {
      if (e.key && e.key.startsWith('taboada_cart')) {
        updateCartUI();
      }
    });

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', () => {
        const cart = getCartData();
        if (cart.length === 0) return;

        const currentCity = (localStorage.getItem('taboada_selected_city') || 'cochabamba').toUpperCase();

        let msg = `Hola, me gustaría realizar el siguiente pedido de Chocolates Taboada (*${currentCity}*):\n\n`;
        cart.forEach((item, idx) => {
          msg += `${idx + 1}. *${item.name}* (${item.size}) x${item.quantity} - Bs. ${(item.price * item.quantity).toFixed(2)}\n`;
        });

        const total = cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);
        msg += `\n*Total a Pagar:* Bs. ${total.toFixed(2)}\n\n¡Quedo atento a la confirmación para la entrega!`;

        // Telemetría GA4: Conversión y Finalización de Pedido
        trackGACart('purchase', {
          transaction_id: 'ORD-' + Date.now(),
          value: total,
          currency: 'BOB',
          items: cart.map(i => ({
            item_id: i.id,
            item_name: i.name,
            price: i.price,
            quantity: i.quantity
          }))
        });
        trackGACart('whatsapp_checkout', {
          event_category: 'conversion',
          event_label: 'Finalizar Pedido WhatsApp',
          value: total,
          currency: 'BOB',
          city: currentCity
        });

        const waUrl = `https://wa.me/59162679408?text=${encodeURIComponent(msg)}`;
        window.open(waUrl, '_blank');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCartListeners);
  } else {
    setupCartListeners();
  }
</script>
