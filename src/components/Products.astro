---
---

<style is:global>
  /* ══════════════════════════════════════════════════
     CHIPS DE CATEGORÍAS en sub-panel beige
  ══════════════════════════════════════════════════ */
  #dynamic-categories-list {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.5rem !important;
    overflow-x: auto;
  }
  #dynamic-categories-list > div,
  #dynamic-categories-list > button {
    flex-shrink: 0 !important;
    width: auto !important;
  }
  /* Chip base — sobre fondo beige */
  #dynamic-categories-list .cat-btn {
    display: inline-flex !important;
    align-items: center !important;
    width: auto !important;
    padding: 0.4rem 1.1rem !important;
    border-radius: 9999px !important;
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    border: 1.5px solid #e2d5c3 !important;
    background: #ffffff !important;
    color: #7a5c45 !important;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap !important;
    text-align: center !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    box-shadow: 0 1px 3px rgba(42,22,18,0.05) !important;
  }
  #dynamic-categories-list .cat-btn:hover {
    border-color: #dcb041 !important;
    color: #2A1612 !important;
    background: #fffff8 !important;
    box-shadow: 0 2px 8px rgba(220,176,65,0.18) !important;
  }
  /* Activo — JS añade "font-black" al chip seleccionado */
  #dynamic-categories-list .cat-btn.font-black {
    background: #2A1612 !important;
    color: #dcb041 !important;
    border-color: #2A1612 !important;
    font-weight: 800 !important;
    box-shadow: 0 3px 12px rgba(42,22,18,0.25) !important;
  }
  #dynamic-categories-list .cat-floating-tooltip { display: none !important; }
  #dynamic-categories-list .cat-btn svg { display: none !important; }
  #dynamic-categories-list::-webkit-scrollbar { display: none; }
  #dynamic-categories-list { -ms-overflow-style: none; scrollbar-width: none; }

  /* ══════════════════════════════════════════════════
     OCASIÓN ACTIVA — círculo se rellena dorado
  ══════════════════════════════════════════════════ */
  .occasion-chip.occasion-active .occ-circle {
    background: #2A1612 !important;
    color: #dcb041 !important;
    border-color: #2A1612 !important;
    box-shadow: 0 0 22px rgba(42,22,18,0.3) !important;
    transform: scale(1.1);
  }
  .occasion-chip.occasion-active .occ-label {
    color: #2A1612 !important;
    font-weight: 700 !important;
  }

  /* ══════════════════════════════════════════════════
     SUB-ROW ANIMACIÓN (slide-down)
  ══════════════════════════════════════════════════ */
  #category-sub-row {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.32s ease 0.05s;
  }
  #category-sub-row.sub-row-visible {
    max-height: 320px;
    opacity: 1;
  }

  /* ══════════════════════════════════════════════════
     SPINNER
  ══════════════════════════════════════════════════ */
  @keyframes spin-catalog { to { transform: rotate(360deg); } }
  .catalog-spinner { animation: spin-catalog 0.8s linear infinite; }

  /* Botón limpiar */
  #catalog-search-clear { transition: opacity 0.2s ease; }
</style>

<!-- ════════════════════════════════════════════════
     CATÁLOGO — id="cajas-especiales" requerido por Navbar e index.astro
════════════════════════════════════════════════ -->
<section
  id="cajas-especiales"
  class="relative bg-[#FAF5F0] py-14 md:py-24 border-t border-[#e8dccb]/60 overflow-hidden"
>
  <!-- Fondos decorativos -->
  <div id="cajas-especiales-bg" class="absolute inset-0 bg-gradient-to-br from-[#FAF5F0] via-[#F3ECE3] to-[#FAF5F0] transition-all duration-500"></div>
  <div class="absolute top-0 right-0 w-[520px] h-[520px] bg-gradient-radial from-amber-100/20 to-transparent blur-[120px] opacity-50 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-radial from-[#f6d98d]/10 to-transparent blur-[100px] opacity-35 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ══════════════════════════════════════
         1. HEADER + BUSCADOR
    ══════════════════════════════════════ -->
    <div class="text-center mb-10 md:mb-14">

      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="w-10 h-px bg-[#dcb041] rounded-full"></span>
        <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-[0.3em] text-[#8f6c49]">Chocolates Taboada</span>
        <span class="w-10 h-px bg-[#dcb041] rounded-full"></span>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#2A1612] font-serif tracking-tight mb-3 leading-[1.05]">
        Catálogo
      </h2>
      <p class="text-[#5D4037]/65 text-sm sm:text-base md:text-lg max-w-lg mx-auto leading-relaxed mb-8 font-sans">
        Explora nuestros chocolates y encuentra el producto ideal para cada ocasión.
      </p>

      <!-- Buscador funcional -->
      <div class="max-w-md sm:max-w-lg mx-auto relative group">
        <label for="catalog-search-input" class="sr-only">Buscar en el catálogo</label>
        <input
          type="text"
          id="catalog-search-input"
          placeholder="Buscar chocolates, cajas, bombones..."
          autocomplete="off"
          class="w-full pl-12 pr-11 py-3.5 rounded-full border border-[#e8dccb] bg-white/95 backdrop-blur-sm text-[#2A1612] placeholder-[#b8a08a] text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-[#dcb041]/35 focus:border-[#dcb041] transition-all duration-300"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#b8a08a] pointer-events-none group-focus-within:text-[#8f6c49] transition-colors duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
        </svg>
        <button id="catalog-search-clear" type="button" aria-label="Limpiar búsqueda" style="opacity:0; pointer-events:none;"
          class="absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-[#e8dccb]/80 hover:bg-[#dcb041] text-[#5D4037] hover:text-[#2A1612] flex items-center justify-center cursor-pointer">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         2+3. NAVEGACIÓN DOS NIVELES
         Nivel 1 — Íconos circulares beige/dorado (mismo estilo Colecciones Navbar)
         Nivel 2 — Panel beige con chips dorados (slide-down)
    ══════════════════════════════════════ -->
    <div class="mb-8 rounded-3xl overflow-hidden shadow-[0_4px_32px_rgba(42,22,18,0.10)] border border-[#e2d5c3]">

      <!-- ── NIVEL 1: Barra de ocasiones con íconos circulares ── -->
      <div class="bg-white px-4 sm:px-8 py-5 border-b border-[#e8dccb]/70">
        <p class="text-[10px] font-extrabold uppercase tracking-[0.25em] text-[#8f6c49]/70 mb-5 text-center">¿Para qué ocasión?</p>

        <div class="grid grid-cols-4 sm:grid-cols-8 gap-2 sm:gap-3 items-start justify-items-center">

          <!-- 1. Regalar -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="regalar">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Regalar</span>
          </button>

          <!-- 2. Sorprender -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="sorprender">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Sorprender</span>
          </button>

          <!-- 3. Con un café -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="cafe">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Con un café</span>
          </button>

          <!-- 4. Celebraciones -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="celebracion">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Celebraciones</span>
          </button>

          <!-- 5. Compartir -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="compartir">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Compartir</span>
          </button>

          <!-- 6. Empresas -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="empresas">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m3 0h1.5M9 10.5h1.5m3 0h1.5M9 14.25h1.5m3 0h1.5M9 18h1.5m3 0h1.5" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Empresas</span>
          </button>

          <!-- 7. Niños -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="ninos">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>
            </div>
            <span class="occ-label text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight">Niños</span>
          </button>

          <!-- 8. Ver todo — círculo dorado especial -->
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-2 p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-full text-center" data-occasion="all">
            <div class="occ-circle w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#dcb041] border border-[#dcb041] flex items-center justify-center text-[#2A1612] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_25px_rgba(220,176,65,0.6)] transition-all duration-300 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
            </div>
            <span class="occ-label text-[11px] font-extrabold text-[#8f6c49] group-hover/occ:text-[#2A1612] transition-colors leading-tight">Ver todo</span>
          </button>

        </div>
      </div>

      <!-- ── NIVEL 2: Sub-row de categorías BEIGE/CREMA + DORADO (slide-down)
           ⚠️ id="dynamic-categories-list" requerido por renderCategories()
      -->
      <div id="category-sub-row">
        <div class="bg-[#FAF5F0] border-t border-[#e2d5c3] px-4 sm:px-7 py-4">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="w-5 h-px bg-[#dcb041] rounded-full"></span>
            <p class="text-[10px] font-extrabold uppercase tracking-[0.25em] text-[#8f6c49]">Tipo de producto</p>
            <span class="flex-1 h-px bg-[#e8dccb] rounded-full"></span>
          </div>
          <div id="dynamic-categories-list" class="flex flex-wrap gap-2">
            <div class="text-xs text-[#a08b7a] italic py-0.5">Cargando categorías...</div>
          </div>
        </div>
      </div>

    </div>

    <!-- ══════════════════════════════════════
         4. BARRA SUPERIOR — CONTADOR + ORDEN
    ══════════════════════════════════════ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 py-3.5 border-y border-[#e8dccb]/70">
      <p class="text-sm text-[#5D4037]/65 font-medium">
        <span id="catalog-count" class="font-black text-[#2A1612] text-base">—</span>
        <span class="ml-1">producto(s) encontrado(s)</span>
      </p>
      <div class="flex items-center gap-2.5">
        <label for="catalog-sort-select" class="text-[10px] font-extrabold uppercase tracking-wider text-[#8f6c49] whitespace-nowrap">Ordenar por</label>
        <div class="relative">
          <select id="catalog-sort-select" class="appearance-none text-sm border border-[#e8dccb] rounded-full pl-3.5 pr-9 py-1.5 bg-white text-[#2A1612] font-semibold focus:outline-none focus:ring-2 focus:ring-[#dcb041]/30 focus:border-[#dcb041] cursor-pointer transition-colors">
            <option value="default">Destacados</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="name-az">Nombre A–Z</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#8f6c49] pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         5. GRID DE PRODUCTOS
         ⚠️ id="dynamic-products-grid" requerido por renderProducts()
    ══════════════════════════════════════ -->
    <div id="dynamic-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4 md:gap-5 min-h-[450px]">
      <div class="col-span-full flex flex-col items-center justify-center py-24 gap-4">
        <div class="w-10 h-10 border-[3px] border-[#dcb041] border-t-transparent rounded-full catalog-spinner"></div>
        <p class="text-sm text-[#a08b7a] italic font-medium">Cargando colección...</p>
      </div>
    </div>

    <div id="no-products-msg" class="hidden py-24 text-center">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white/60 mb-6 shadow-inner">
        <svg class="w-12 h-12 text-[#dcb041]/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-[#2A1612] font-serif mb-2">No se encontraron productos</h3>
      <p class="text-[#5D4037]/60 font-sans text-sm">Prueba con otra categoría o busca de nuevo.</p>
    </div>

    <!-- Elementos ocultos — compatibilidad setupSidebarToggle() -->
    <aside id="cat-sidebar" class="hidden" aria-hidden="true">
      <div id="cat-sidebar-header-title"></div>
      <button id="toggle-cat-sidebar-btn" type="button" aria-hidden="true"></button>
    </aside>
    <svg id="cat-sidebar-arrow-icon" class="hidden" aria-hidden="true"></svg>
    <div id="product-grid-column" class="hidden" aria-hidden="true"></div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoriesList = document.getElementById('dynamic-categories-list');
    const productsGrid = document.getElementById('dynamic-products-grid');
    const noProductsMsg = document.getElementById('no-products-msg');
    
    let allProducts = [];
    let currentCategory = 'DESTACADOS';
    let currentCity = localStorage.getItem('taboada_selected_city') || 'cochabamba';
    
    const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:10000/api/v1";

    window.addEventListener('cityChanged', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.city) {
        currentCity = detail.city;
        renderProducts();
      }
    });

    async function loadCatalog() {
      try {
        const response = await fetch(`${apiUrl}/fidelizacion/catalog`);
        if (!response.ok) throw new Error('Error fetching catalog');
        const data = await response.json();
        if (data.status === 'success') {
          renderCategories(data.categorias);
          allProducts = data.productos;
          renderProducts();
          setupSidebarToggle();
        }
      } catch (error) {
        console.error('Error cargando catálogo:', error);
        if (productsGrid) {
          productsGrid.innerHTML = '<div class="col-span-full text-center text-red-500 py-10">Ocurrió un error al cargar el catálogo.</div>';
        }
      }
    }

    function getCategoryIcon(name) {
      return `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>`;
    }

    function getCategoryFallbackIcon() {
      return `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`;
    }

    function renderCategories(categorias) {
      if (!categoriesList) return;
      
      let html = `
        <div class="relative group/cat-tooltip flex-shrink-0 lg:flex-shrink w-full">
          <button type="button" class="cat-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-black transition-all duration-300 cursor-pointer text-left group bg-transparent text-[#2A1612] border-l-2 border-[#dcb041]" data-target="DESTACADOS">
            <span class="cat-btn-label flex-1 truncate text-xs font-sans tracking-tight">⭐ Destacados</span>
          </button>
          <span class="cat-floating-tooltip absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#2A1612] text-white text-[11px] font-bold rounded-lg shadow-xl opacity-0 pointer-events-none transition-opacity duration-200 z-50 whitespace-nowrap border border-white/10 hidden">Destacados</span>
        </div>
      `;

      categorias.forEach(cat => {
        html += `
          <div class="relative group/cat-tooltip flex-shrink-0 lg:flex-shrink w-full">
            <button type="button" class="cat-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold transition-all duration-300 cursor-pointer text-left group text-[#5D4037]/80 hover:text-[#2A1612] bg-transparent border-l-2 border-transparent" data-target="${cat.id}">
              <span class="cat-btn-label flex-1 truncate text-xs font-sans tracking-tight">${cat.name}</span>
            </button>
            <span class="cat-floating-tooltip absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#2A1612] text-white text-[11px] font-bold rounded-lg shadow-xl opacity-0 pointer-events-none transition-opacity duration-200 z-50 whitespace-nowrap border border-white/10 hidden">${cat.name}</span>
          </div>
        `;
      });
      categoriesList.innerHTML = html;

      const catBtns = categoriesList.querySelectorAll('.cat-btn');
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => {
            b.classList.remove('text-[#2A1612]', 'font-black', 'border-[#dcb041]');
            b.classList.add('text-[#5D4037]/80', 'font-semibold', 'border-transparent', 'hover:text-[#2A1612]');
          });
          btn.classList.add('text-[#2A1612]', 'font-black', 'border-[#dcb041]');
          btn.classList.remove('text-[#5D4037]/80', 'font-semibold', 'border-transparent', 'hover:text-[#2A1612]');
          currentCategory = (btn as HTMLElement).dataset.target || 'DESTACADOS';
          renderProducts();
        });
      });
    }

    function updateCatalogCount(count) {
      const countEl = document.getElementById('catalog-count');
      if (countEl) countEl.textContent = String(count);
    }

    function renderProducts() {
      if (!productsGrid) return;
      const filtered = allProducts.filter(p => {
        let matchCategory = false;
        if (currentCategory === 'DESTACADOS') {
          matchCategory = p.is_destacado === true;
        } else {
          matchCategory = p.categoria_id === currentCategory;
        }
        const cityKey = currentCity === 'la-paz' ? 'la_paz' : currentCity;
        const hasPriceForCity = p.precios && p.precios[cityKey] !== undefined;
        return matchCategory && hasPriceForCity;
      });

      if (filtered.length === 0) {
        productsGrid.innerHTML = '';
        if(noProductsMsg) noProductsMsg.classList.remove('hidden');
        updateCatalogCount(0);
        return;
      }
      if(noProductsMsg) noProductsMsg.classList.add('hidden');
      updateCatalogCount(filtered.length);
      
      let html = '';
      filtered.forEach(p => {
        const cityKey = currentCity === 'la-paz' ? 'la_paz' : currentCity;
        const price = p.precios[cityKey];
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png';
        html += buildProductCard(p, price, wappText, imgUrl);
      });
      productsGrid.innerHTML = html;
    }

    // Renderizar TODOS los productos (para "Ver todo") — función adicional, no modifica renderProducts
    function renderAllProducts() {
      if (!productsGrid) return;
      const cityKey = currentCity === 'la-paz' ? 'la_paz' : currentCity;
      const allFiltered = allProducts.filter(p => p.precios && p.precios[cityKey] !== undefined);
      if (allFiltered.length === 0) {
        productsGrid.innerHTML = '';
        if(noProductsMsg) noProductsMsg.classList.remove('hidden');
        updateCatalogCount(0);
        return;
      }
      if(noProductsMsg) noProductsMsg.classList.add('hidden');
      updateCatalogCount(allFiltered.length);
      let html = '';
      allFiltered.forEach(p => {
        const price = p.precios[cityKey];
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png';
        html += buildProductCard(p, price, wappText, imgUrl);
      });
      productsGrid.innerHTML = html;
    }

    // Plantilla de tarjeta — compartida entre renderProducts y renderAllProducts
    function buildProductCard(p, price, wappText, imgUrl) {
      return `
        <div class="product-card group relative bg-white rounded-2xl border border-[#ecddd0]/80 flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(42,22,18,0.13)]">
          ${p.is_destacado ? `<div class="absolute top-2.5 left-2.5 z-20"><span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-[#dcb041] text-[#2A1612] text-[9px] font-black uppercase tracking-wide shadow-sm">★ Destacado</span></div>` : ''}
          <div class="absolute top-2.5 right-2.5 z-20 group/tooltip">
            <button type="button" class="add-to-cart-btn w-8 h-8 bg-white/95 hover:bg-[#2A1612] hover:text-[#dcb041] border border-[#e8dccb] text-[#2A1612] rounded-full flex items-center justify-center transition-all duration-300 shadow-sm hover:scale-110 active:scale-95 cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
            </button>
            <span class="absolute right-0 -bottom-8 bg-[#2A1612] text-white text-[9px] font-bold px-2 py-1 rounded-lg shadow-lg whitespace-nowrap opacity-0 pointer-events-none group-hover/tooltip:opacity-100 transition-opacity duration-200 z-30">Añadir al carrito</span>
          </div>
          <div class="w-full bg-[#FAF5F0] h-40 sm:h-44 flex items-center justify-center p-4 sm:p-5 overflow-hidden">
            <img src="${imgUrl}" alt="${p.nombre}" loading="lazy" class="max-w-full max-h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="flex flex-col flex-1 p-3.5 sm:p-4">
            <h3 class="text-[13px] sm:text-sm font-bold text-[#2A1612] font-serif leading-snug mb-3 line-clamp-2 group-hover:text-[#7a4e2b] transition-colors duration-300">${p.nombre}</h3>
            <div class="mt-auto flex items-end justify-between gap-2">
              <div class="flex flex-col min-w-0">
                <span class="text-[9px] font-extrabold text-[#a08b7a] uppercase tracking-wider mb-0.5">Precio</span>
                <span class="text-base sm:text-lg font-black text-[#2A1612] font-serif leading-none">Bs. ${price}</span>
              </div>
              <a href="https://wa.me/59179786916?text=${wappText}" target="_blank" rel="noopener"
                class="buy-btn inline-flex items-center gap-1.5 bg-[#2A1612] hover:bg-[#dcb041] text-white hover:text-[#2A1612] font-bold text-[10px] sm:text-[11px] px-3 py-2 rounded-full transition-all duration-300 shadow-sm cursor-pointer whitespace-nowrap flex-shrink-0">
                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Comprar
              </a>
            </div>
          </div>
        </div>
      `;
    }

    function applySearchFilter(query) {
      const q = query.toLowerCase().trim();
      let visible = 0;
      document.querySelectorAll('#dynamic-products-grid .product-card').forEach(card => {
        const name = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const matches = q === '' || name.includes(q);
        (card as HTMLElement).style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      if (q !== '') updateCatalogCount(visible);
    }

    function setupSidebarToggle() {
      const catSidebar = document.getElementById('cat-sidebar');
      const toggleSidebarBtn = document.getElementById('toggle-cat-sidebar-btn');
      const arrowIcon = document.getElementById('cat-sidebar-arrow-icon');
      const headerTitle = document.getElementById('cat-sidebar-header-title');
      const productGridColumn = document.getElementById('product-grid-column');

      toggleSidebarBtn?.addEventListener('click', () => {
        const isCollapsed = catSidebar?.classList.contains('is-collapsed-sidebar');
        if (isCollapsed) {
          catSidebar?.classList.remove('is-collapsed-sidebar', 'lg:col-span-1', 'lg:w-[70px]');
          catSidebar?.classList.add('lg:col-span-2', 'w-full');
          productGridColumn?.classList.remove('lg:col-span-11');
          productGridColumn?.classList.add('lg:col-span-10');
          if (arrowIcon) arrowIcon.style.transform = 'rotate(0deg)';
          if (headerTitle) headerTitle.style.display = '';
          document.querySelectorAll('.cat-btn-label').forEach(el => (el as HTMLElement).style.display = '');
          document.querySelectorAll('.cat-btn').forEach(btn => { btn.classList.remove('justify-center'); btn.classList.add('gap-2.5'); });
        } else {
          catSidebar?.classList.add('is-collapsed-sidebar', 'lg:col-span-1', 'lg:w-[70px]');
          catSidebar?.classList.remove('lg:col-span-2', 'w-full');
          productGridColumn?.classList.remove('lg:col-span-10');
          productGridColumn?.classList.add('lg:col-span-11');
          if (arrowIcon) arrowIcon.style.transform = 'rotate(180deg)';
          if (headerTitle) headerTitle.style.display = 'none';
          document.querySelectorAll('.cat-btn-label').forEach(el => (el as HTMLElement).style.display = 'none');
          document.querySelectorAll('.cat-btn').forEach(btn => { btn.classList.add('justify-center'); btn.classList.remove('gap-2.5'); });
        }
      });
    }

    loadCatalog();

    // ════════════════════════════════════════════════════════════
    // NUEVAS INTERACCIONES — no modifican ninguna función existente
    // ════════════════════════════════════════════════════════════

    // ── Ocasión chips → revelar sub-row ──
    const occasionBtns = document.querySelectorAll('.occasion-chip');
    const categorySubRow = document.getElementById('category-sub-row');

    occasionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const occasion = (btn as HTMLElement).dataset.occasion;

        // Marcar activa visualmente
        occasionBtns.forEach(b => b.classList.remove('occasion-active'));
        btn.classList.add('occasion-active');

        // Revelar sub-row
        if (categorySubRow) categorySubRow.classList.add('sub-row-visible');

        // "Ver todo" → todos los productos
        if (occasion === 'all') {
          categoriesList?.querySelectorAll('.cat-btn').forEach(b => {
            b.classList.remove('text-[#2A1612]', 'font-black', 'border-[#dcb041]');
            b.classList.add('text-[#5D4037]/80', 'font-semibold', 'border-transparent', 'hover:text-[#2A1612]');
          });
          renderAllProducts();
        }
      });
    });

    // ── Buscador funcional ──
    const searchInput = document.getElementById('catalog-search-input') as HTMLInputElement;
    const searchClearBtn = document.getElementById('catalog-search-clear');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const val = searchInput.value;
        if (searchClearBtn) {
          (searchClearBtn as HTMLElement).style.opacity = val.length > 0 ? '1' : '0';
          (searchClearBtn as HTMLElement).style.pointerEvents = val.length > 0 ? 'auto' : 'none';
        }
        applySearchFilter(val);
      });
    }

    if (searchClearBtn && searchInput) {
      searchClearBtn.addEventListener('click', () => {
        searchInput.value = '';
        (searchClearBtn as HTMLElement).style.opacity = '0';
        (searchClearBtn as HTMLElement).style.pointerEvents = 'none';
        document.querySelectorAll('#dynamic-products-grid .product-card').forEach(card => {
          (card as HTMLElement).style.display = '';
        });
        const total = document.querySelectorAll('#dynamic-products-grid .product-card').length;
        updateCatalogCount(total);
        searchInput.focus();
      });
    }

    // ── Re-aplicar búsqueda cuando el grid cambia ──
    if (productsGrid && searchInput) {
      const gridObserver = new MutationObserver(() => {
        if (searchInput.value.trim()) setTimeout(() => applySearchFilter(searchInput.value), 0);
      });
      gridObserver.observe(productsGrid, { childList: true });
    }

  });
</script>
