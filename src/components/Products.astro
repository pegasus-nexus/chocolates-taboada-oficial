---
---

<style is:global>
  /* ══════════════════════════════════════════════════
     CHIPS DE CATEGORÍAS en sub-panel beige
  ══════════════════════════════════════════════════ */
  #dynamic-categories-list {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.35rem !important;
    max-height: 110px;
    overflow-y: auto;
    padding-bottom: 2px;
  }
  @media (min-width: 640px) {
    #dynamic-categories-list {
      gap: 0.5rem !important;
      max-height: 160px;
    }
  }

  /* Chip base — sobre fondo beige */
  #dynamic-categories-list .cat-btn {
    display: inline-flex !important;
    align-items: center !important;
    width: auto !important;
    padding: 0.25rem 0.65rem !important;
    border-radius: 9999px !important;
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    border: 1px solid #e2d5c3 !important;
    background: #ffffff !important;
    color: #5D4037 !important;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap !important;
    text-align: center !important;
    text-transform: none !important;
    box-shadow: 0 1px 2px rgba(42,22,18,0.04) !important;
  }
  @media (min-width: 640px) {
    #dynamic-categories-list .cat-btn {
      padding: 0.35rem 0.95rem !important;
      font-size: 0.8rem !important;
      border-width: 1.5px !important;
    }
  }

  #dynamic-categories-list .cat-btn:hover {
    border-color: #dcb041 !important;
    color: #2A1612 !important;
    background: #fffdf9 !important;
    box-shadow: 0 2px 6px rgba(220,176,65,0.15) !important;
  }

  /* Activo — chip seleccionado */
  #dynamic-categories-list .cat-btn.cat-active,
  #dynamic-categories-list .cat-btn.font-black {
    background: #2A1612 !important;
    color: #f6d98d !important;
    border-color: #2A1612 !important;
    font-weight: 800 !important;
    box-shadow: 0 2px 8px rgba(42,22,18,0.25) !important;
  }

  /* Custom scrollbar discreta para categorías */
  #dynamic-categories-list::-webkit-scrollbar { width: 3px; }
  #dynamic-categories-list::-webkit-scrollbar-track { background: transparent; }
  #dynamic-categories-list::-webkit-scrollbar-thumb { background: #dcb041; border-radius: 4px; }

  /* ══════════════════════════════════════════════════
     OCASIÓN ACTIVA — círculo se rellena dorado
  ══════════════════════════════════════════════════ */
  .occasion-chip {
    transition: transform 0.2s ease;
  }
  .occasion-chip:hover {
    transform: translateY(-2px);
  }
  .occasion-chip.occasion-active .occ-circle {
    background: #2A1612 !important;
    color: #dcb041 !important;
    border-color: #dcb041 !important;
    box-shadow: 0 0 16px rgba(220,176,65,0.35) !important;
    transform: scale(1.08);
  }
  .occasion-chip.occasion-active .occ-label {
    color: #2A1612 !important;
    font-weight: 800 !important;
  }

  /* ══════════════════════════════════════════════════
     SUB-ROW ANIMACIÓN (slide-down)
  ══════════════════════════════════════════════════ */
  #category-sub-row {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.32s ease 0.05s;
  }
  #category-sub-row.sub-row-visible {
    max-height: 450px;
    opacity: 1;
  }

  /* ══════════════════════════════════════════════════
     SPINNER
  ══════════════════════════════════════════════════ */
  @keyframes spin-catalog { to { transform: rotate(360deg); } }
  .catalog-spinner { animation: spin-catalog 0.8s linear infinite; }

  /* Botón limpiar */
  #catalog-search-clear { transition: opacity 0.2s ease; }
</style>

<!-- ════════════════════════════════════════════════
     CATÁLOGO — id="cajas-especiales" requerido por Navbar e index.astro
════════════════════════════════════════════════ -->
<section
  id="cajas-especiales"
  class="relative bg-[#FAF5F0] py-4 sm:py-10 md:py-16 border-t border-[#e8dccb]/60 overflow-hidden"
>
  <!-- Fondos decorativos -->
  <div id="cajas-especiales-bg" class="absolute inset-0 bg-gradient-to-br from-[#FAF5F0] via-[#F3ECE3] to-[#FAF5F0] transition-all duration-500"></div>
  <div class="absolute top-0 right-0 w-[520px] h-[520px] bg-gradient-radial from-amber-100/20 to-transparent blur-[120px] opacity-50 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-radial from-[#f6d98d]/10 to-transparent blur-[100px] opacity-35 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">

    <!-- ══════════════════════════════════════
         1. HEADER + BUSCADOR
    ══════════════════════════════════════ -->
    <div class="text-center mb-4 sm:mb-8 md:mb-10">

      <div class="flex items-center justify-center gap-2.5 mb-2 sm:mb-3">
        <span class="w-8 sm:w-10 h-px bg-[#dcb041] rounded-full"></span>
        <span class="text-[9px] sm:text-[11px] font-extrabold uppercase tracking-[0.25em] sm:tracking-[0.3em] text-[#5e4225]">Chocolates Taboada</span>
        <span class="w-8 sm:w-10 h-px bg-[#dcb041] rounded-full"></span>
      </div>

      <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-[#2A1612] font-serif tracking-tight mb-2 sm:mb-3 leading-[1.05]">
        Catálogo
      </h2>
      <p class="text-[#4a3219] text-xs sm:text-base md:text-lg max-w-lg mx-auto leading-relaxed mb-4 sm:mb-6 font-sans">
        Explora nuestros chocolates y encuentra el producto ideal para cada ocasión.
      </p>

      <!-- Buscador funcional -->
      <div class="max-w-md sm:max-w-lg mx-auto relative group">
        <label for="catalog-search-input" class="sr-only">Buscar en el catálogo</label>
        <input
          type="text"
          id="catalog-search-input"
          placeholder="Buscar chocolates, cajas, bombones..."
          autocomplete="off"
          class="w-full pl-11 sm:pl-12 pr-10 sm:pr-11 py-2.5 sm:py-3.5 rounded-full border border-[#e8dccb] bg-white/95 backdrop-blur-sm text-[#2A1612] placeholder-[#b8a08a] text-xs sm:text-sm font-medium shadow-xs focus:outline-none focus:ring-2 focus:ring-[#dcb041]/35 focus:border-[#dcb041] transition-all duration-300"
        />
        <svg class="absolute left-3.5 sm:left-4 top-1/2 -translate-y-1/2 w-4 h-4 sm:w-5 sm:h-5 text-[#b8a08a] pointer-events-none group-focus-within:text-[#8f6c49] transition-colors duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
        </svg>
        <button id="catalog-search-clear" type="button" aria-label="Limpiar búsqueda" style="opacity:0; pointer-events:none;"
          class="absolute right-2.5 sm:right-3 top-1/2 -translate-y-1/2 w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-[#e8dccb]/80 hover:bg-[#dcb041] text-[#5D4037] hover:text-[#2A1612] flex items-center justify-center cursor-pointer">
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         2+3. NAVEGACIÓN DOS NIVELES
         Nivel 1 — Íconos circulares beige/dorado (mismo estilo Colecciones Navbar)
         Nivel 2 — Panel beige con chips dorados (slide-down)
    ══════════════════════════════════════ -->
    <div class="mb-3 sm:mb-6 rounded-2xl sm:rounded-3xl overflow-hidden shadow-[0_2px_18px_rgba(42,22,18,0.06)] border border-[#e2d5c3]">

      <!-- ── NIVEL 1: Barra de ocasiones con íconos circulares (Dinámico por WebCollections) ── -->
      <div id="collections-section" class="bg-white px-3 sm:px-8 py-2.5 sm:py-4 border-b border-[#e8dccb]/70 hidden">
        <p class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-[#5e4225] mb-2 sm:mb-4 text-center">Comprar por ocasión</p>

        <div id="dynamic-collections-list" class="flex sm:grid sm:grid-cols-8 gap-1.5 sm:gap-3 items-start justify-items-center overflow-x-auto pb-1.5 scrollbar-none">
          <!-- Colecciones dinámicas renderizadas desde JS -->
        </div>
      </div>

      <!-- ── NIVEL 2: Sub-row de categorías BEIGE/CREMA + DORADO (slide-down)
           ⚠️ id="dynamic-categories-list" requerido por renderCategories()
      -->
      <div id="category-sub-row">
        <div class="bg-[#FAF5F0] border-t border-[#e2d5c3] px-2.5 sm:px-6 py-2 sm:py-3.5">
          <div class="flex items-center gap-2 mb-1.5 sm:mb-2.5">
            <span class="w-4 sm:w-5 h-px bg-[#dcb041] rounded-full"></span>
            <p class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-[#5e4225]">Tipo de producto</p>
            <span class="flex-1 h-px bg-[#e8dccb] rounded-full"></span>
          </div>
          <div id="dynamic-categories-list" class="flex flex-wrap gap-1.5 sm:gap-2">
            <div class="h-6 sm:h-7 w-16 sm:w-20 bg-[#e8dccb]/70 rounded-full"></div>
            <div class="h-6 sm:h-7 w-20 sm:w-24 bg-[#e8dccb]/70 rounded-full"></div>
            <div class="h-6 sm:h-7 w-14 sm:w-16 bg-[#e8dccb]/70 rounded-full"></div>
            <div class="h-6 sm:h-7 w-24 sm:w-28 bg-[#e8dccb]/70 rounded-full"></div>
            <div class="h-6 sm:h-7 w-16 sm:w-20 bg-[#e8dccb]/70 rounded-full"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- ══════════════════════════════════════
         4. BARRA SUPERIOR — CONTADOR + ORDEN
    ══════════════════════════════════════ -->
    <div id="catalog-products-view" class="scroll-mt-20 sm:scroll-mt-28"></div>
    <div class="flex flex-row items-center justify-between gap-2 mb-3 sm:mb-5 py-2 sm:py-3 border-y border-[#e8dccb]/70">
      <p class="text-xs sm:text-sm text-[#5D4037]/75 font-medium">
        <span class="mr-1">Mostrando</span>
        <span id="catalog-count" class="font-black text-[#2A1612] text-sm sm:text-base">—</span>
        <span class="ml-1">productos</span>
      </p>
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <label for="catalog-sort-select" class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider text-[#8f6c49] whitespace-nowrap">Ordenar por</label>
        <div class="relative">
          <select id="catalog-sort-select" class="appearance-none text-xs sm:text-sm border border-[#e8dccb] rounded-full pl-3 pr-7 sm:pr-9 py-1 sm:py-1.5 bg-white text-[#2A1612] font-semibold focus:outline-none focus:ring-2 focus:ring-[#dcb041]/30 focus:border-[#dcb041] cursor-pointer transition-colors">
            <option value="default">Destacados</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="name-az">Nombre A–Z</option>
          </select>
          <svg class="absolute right-2.5 sm:right-3 top-1/2 -translate-y-1/2 w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#8f6c49] pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         5. ESTADO DE CARGA Y GRID DE PRODUCTOS
    ══════════════════════════════════════ -->
    <!-- ESTADO DE CARGA ANIMADO CON CHOCOLATE -->
    <div id="catalog-loading-state" class="py-4 sm:py-10 text-center flex flex-col items-center justify-center min-h-[120px] sm:min-h-[200px]">
      <div class="relative w-12 h-12 sm:w-16 sm:h-16 mb-2 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-[#2A1612] via-[#5D4037] to-[#dcb041] opacity-25 animate-ping"></div>
        <div class="relative w-10 h-10 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-[#2A1612] to-[#3D1E15] border border-[#dcb041]/50 flex items-center justify-center shadow-[0_6px_16px_rgba(42,22,18,0.25)] transform hover:rotate-6 transition-transform">
          <svg class="w-5 h-5 sm:w-7 sm:h-7 text-[#dcb041] animate-pulse" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-8 4h3v3h-3V7zm0 5h3v3h-3v-3zM6 7h3v3H6V7zm0 5h3v3H6v-3zm0 5h3v2H6v-2zm5 2v-2h3v2h-3zm8-2h-3v-3h3v3zm0-5h-3V7h3v3zm0 7h-3v-2h3v2z" />
          </svg>
        </div>
      </div>
      <h3 class="text-sm sm:text-lg font-serif font-bold text-[#2A1612] mb-0.5 flex items-center gap-1.5 justify-center">
        <span>Cargando productos deliciosos</span>
        <span class="inline-flex gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#dcb041] animate-bounce" style="animation-delay: 0s;"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#dcb041] animate-bounce" style="animation-delay: 0.15s;"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#dcb041] animate-bounce" style="animation-delay: 0.3s;"></span>
        </span>
      </h3>
      <p class="text-[10px] sm:text-xs text-[#8f6c49] font-medium tracking-wide">Preparando la selección de Chocolates Taboada...</p>
    </div>

    <div id="dynamic-products-grid" class="hidden grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-5 md:gap-6 min-h-[120px]">
    </div>

    <!-- BOTÓN VER MÁS PRODUCTOS (CARGA PROGRESIVA DE 10 EN 10) -->
    <div id="catalog-load-more-wrapper" class="hidden mt-6 sm:mt-10 text-center flex flex-col items-center justify-center gap-2.5">
      <button
        id="catalog-load-more-btn"
        type="button"
        class="inline-flex items-center gap-2.5 px-7 py-3 sm:px-9 sm:py-3.5 rounded-full bg-[#2A1612] hover:bg-[#dcb041] text-[#FAF5F0] hover:text-[#2A1612] text-xs sm:text-sm font-extrabold shadow-[0_6px_20px_rgba(42,22,18,0.25)] hover:shadow-[0_8px_25px_rgba(220,176,65,0.4)] transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer group"
      >
        <span>Ver más productos</span>
        <svg class="w-4 h-4 text-[#dcb041] group-hover:text-[#2A1612] group-hover:translate-y-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
      <span id="catalog-load-more-info" class="text-[11px] sm:text-xs text-[#5D4037]/75 font-semibold"></span>
    </div>

    <div id="no-products-msg" class="hidden py-4 sm:py-8 text-center">
      <div class="inline-flex items-center justify-center w-10 h-10 sm:w-16 sm:h-16 rounded-full bg-white/60 mb-2 shadow-inner">
        <svg class="w-5 h-5 sm:w-8 sm:h-8 text-[#dcb041]/60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>
      <h3 class="text-sm sm:text-lg font-bold text-[#2A1612] font-serif mb-0.5">No se encontraron productos</h3>
      <p class="text-[#5D4037]/60 font-sans text-[11px] sm:text-xs">Prueba con otra categoría o busca de nuevo.</p>
    </div>

    <!-- Elementos ocultos — compatibilidad setupSidebarToggle() -->
    <aside id="cat-sidebar" class="hidden" aria-hidden="true">
      <div id="cat-sidebar-header-title"></div>
      <button id="toggle-cat-sidebar-btn" type="button" aria-hidden="true"></button>
    </aside>
    <svg id="cat-sidebar-arrow-icon" class="hidden" aria-hidden="true"></svg>
    <div id="product-grid-column" class="hidden" aria-hidden="true"></div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const collectionsSection = document.getElementById('collections-section');
    const collectionsList = document.getElementById('dynamic-collections-list');
    const categoriesList = document.getElementById('dynamic-categories-list');
    const productsGrid = document.getElementById('dynamic-products-grid');
    const noProductsMsg = document.getElementById('no-products-msg');
    
    let allProducts = [];
    let allCategories = [];
    let allCollections = [];
    
    let currentCategory = 'DESTACADOS';
    let currentCity = localStorage.getItem('taboada_selected_city') || 'cochabamba';
    
    const apiUrl = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' 
      ? 'http://127.0.0.1:8001/api/v1' 
      : 'https://app.pegasus-nexus.com/api/v1';

    function getProductPrice(p, city) {
      if (!p) return 0;
      if (typeof p.precio === 'number' && p.precio > 0) return p.precio;
      if (p.precios) {
        if (city === 'la-paz' || city === 'lapaz' || city === 'la_paz') {
          return p.precios.la_paz ?? p.precios.lapaz ?? p.precios.lp ?? p.precios.cochabamba ?? p.precios.cocha ?? 0;
        }
        return p.precios.cochabamba ?? p.precios.cocha ?? p.precios.cbba ?? p.precios.la_paz ?? p.precios.lapaz ?? 0;
      }
      return 0;
    }

    window.addEventListener('cityChanged', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.city) {
        currentCity = detail.city;
        renderProducts();
      }
    });

    async function loadCatalog() {
      try {
        const response = await fetch(`${apiUrl}/fidelizacion/catalog`);
        if (!response.ok) throw new Error('Error fetching catalog');
        const data = await response.json();
        if (data.status === 'success') {
          allProducts = data.productos || [];
          allCategories = data.categorias || [];
          allCollections = data.colecciones || [];
          
          if (allCollections.length > 0 && collectionsSection && collectionsList) {
            collectionsSection.classList.remove('hidden');
            renderCollections();

            // Auto-seleccionar ocasión y categoría desde la URL
            const segments = window.location.pathname.split('/').filter(Boolean).map(s => decodeURIComponent(s));
            let targetOccasionName = '';
            let targetCategoryName = '';

            if (segments[0] && segments[0].toLowerCase() === 'catalogo') {
              targetOccasionName = segments[1] || '';
              targetCategoryName = segments[2] || '';
            } else {
              targetOccasionName = segments[0] || '';
              targetCategoryName = segments[1] || '';
            }

            // Si viene /Catalogo/Tabletas o /Tabletas, verificar si es categoría
            if (targetOccasionName && !targetCategoryName) {
              const isCol = allCollections.some(c => c.name.toLowerCase() === targetOccasionName.toLowerCase());
              const isCat = allCategories.some(c => c.name.toLowerCase() === targetOccasionName.toLowerCase() || String(c.id).toLowerCase() === targetOccasionName.toLowerCase());
              if (!isCol && isCat) {
                targetCategoryName = targetOccasionName;
                targetOccasionName = '';
              }
            }

            if (targetOccasionName) {
              const isVertodo = targetOccasionName.toLowerCase().includes('vertodo') || 
                                targetOccasionName.toLowerCase().includes('ver todo');
              const matchedCol = allCollections.find(c => c.name.toLowerCase() === targetOccasionName.toLowerCase()) ||
                (isVertodo ? { id: 'all', name: 'Catalogo' } : null);

              if (matchedCol) {
                const btn = collectionsList.querySelector(`[data-collection-id="${matchedCol.id}"]`);
                if (btn) {
                  (btn as HTMLElement).click();
                }
              }
            } else {
              const allBtn = collectionsList.querySelector(`[data-collection-id="all"]`);
              if (allBtn) (allBtn as HTMLElement).click();
            }

            if (targetCategoryName) {
              setTimeout(() => {
                const catBtns = categoriesList.querySelectorAll('.cat-btn');
                const matchedCat = allCategories.find(c =>
                  c.name.toLowerCase() === targetCategoryName.toLowerCase() ||
                  String(c.id).toLowerCase() === targetCategoryName.toLowerCase()
                );
                if (matchedCat) {
                  const targetCatBtn = Array.from(catBtns).find(b => (b as HTMLElement).dataset.target === String(matchedCat.id));
                  if (targetCatBtn) (targetCatBtn as HTMLElement).click();
                }
              }, 100);
            }

            const currentPathLower = window.location.pathname.toLowerCase();
            const isCatalogRoute = currentPathLower.includes('catalogo') || 
                                  currentPathLower.includes('vertodo') || 
                                  currentPathLower.includes('ver todo') || 
                                  window.location.hash.includes('cajas-especiales') ||
                                  window.location.search.includes('cat=') ||
                                  Boolean(targetOccasionName || targetCategoryName);

            if (isCatalogRoute) {
              setTimeout(() => {
                scrollToProducts(true);
              }, 350);
            }
          } else if (collectionsSection) {
            collectionsSection.classList.add('hidden');
          }
          
          renderCategories(allCategories);
          renderProducts();
          setupSidebarToggle();
        }
      } catch (error) {
        console.error('Error cargando catálogo:', error);
        if (loadingState) loadingState.classList.add('hidden');
        if (productsGrid) {
          productsGrid.classList.remove('hidden');
          productsGrid.innerHTML = '<div class="col-span-full text-center text-red-500 py-6 text-sm">Ocurrió un error al cargar el catálogo.</div>';
        }
      }
    }

    function renderCollections() {
      if (!collectionsList) return;
      let html = '';
      
      allCollections.forEach(col => {
        const iconSrc = col.image_url || 'https://api.iconify.design/lucide:gift.svg?color=%238f6c49';
        html += `
          <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-1.5 p-1.5 sm:p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-auto min-w-[62px] sm:w-full text-center flex-shrink-0" data-collection-id="${col.id}">
            <div class="occ-circle w-10 h-10 sm:w-13 sm:h-13 rounded-full bg-[#FAF5F0] border border-[#e8dccb] flex items-center justify-center text-[#8f6c49] group-hover/occ:bg-[#dcb041] group-hover/occ:text-[#2A1612] group-hover/occ:border-[#dcb041] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_20px_rgba(220,176,65,0.4)] transition-all duration-300 flex-shrink-0 overflow-hidden">
              <img src="${iconSrc}" alt="" aria-hidden="true" class="w-5 h-5 sm:w-6 sm:h-6 object-contain" onError="this.src='https://api.iconify.design/lucide:star.svg?color=%23dcb041'" />
            </div>
            <span class="occ-label text-[10px] sm:text-[11px] font-semibold text-[#5D4037]/80 group-hover/occ:text-[#2A1612] transition-colors leading-tight whitespace-nowrap sm:whitespace-normal">${col.name}</span>
          </button>
        `;
      });

      html += `
        <button type="button" class="occasion-chip group/occ flex flex-col items-center gap-1.5 p-1.5 sm:p-2 rounded-2xl hover:bg-[#FAF5F0] transition-all duration-300 cursor-pointer w-auto min-w-[62px] sm:w-full text-center flex-shrink-0" data-collection-id="all">
          <div class="occ-circle w-10 h-10 sm:w-13 sm:h-13 rounded-full bg-[#dcb041] border border-[#dcb041] flex items-center justify-center text-[#2A1612] group-hover/occ:scale-110 group-hover/occ:shadow-[0_0_25px_rgba(220,176,65,0.6)] transition-all duration-300 flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
          </div>
          <span class="occ-label text-[10px] sm:text-[11px] font-extrabold text-[#8f6c49] group-hover/occ:text-[#2A1612] transition-colors leading-tight whitespace-nowrap sm:whitespace-normal">Ver todo</span>
        </button>
      `;

      collectionsList.innerHTML = html;

      const occasionBtns = collectionsList.querySelectorAll('.occasion-chip');
      const categorySubRow = document.getElementById('category-sub-row');

      occasionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const colId = (btn as HTMLElement).dataset.collectionId;
          occasionBtns.forEach(b => b.classList.remove('occasion-active'));
          btn.classList.add('occasion-active');
          if (categorySubRow) categorySubRow.classList.add('sub-row-visible');

          if (colId === 'all') {
            let newUrl = '/Catalogo';
            if (currentCategory && currentCategory !== 'DESTACADOS') {
              const matchedCat = allCategories.find(c => String(c.id) === currentCategory);
              if (matchedCat) newUrl += '/' + encodeURIComponent(matchedCat.name);
            }
            window.history.pushState({}, '', newUrl);
            renderCategories(allCategories);
            renderAllProducts(true);
          } else {
            const col = allCollections.find(c => c.id === colId);
            if (col && col.categories_ids) {
              let newUrl = '/Catalogo/' + encodeURIComponent(col.name);
              if (currentCategory && currentCategory !== 'DESTACADOS') {
                const matchedCat = allCategories.find(c => String(c.id) === currentCategory);
                if (matchedCat && col.categories_ids.includes(matchedCat.id)) {
                  newUrl += '/' + encodeURIComponent(matchedCat.name);
                }
              }
              window.history.pushState({}, '', newUrl);
              
              const filteredCats = allCategories.filter(c => col.categories_ids.includes(c.id));
              renderCategories(filteredCats);
              renderProducts(true);
            }
          }
          setTimeout(() => {
            scrollToProducts(true);
          }, 80);
        });
      });
    }

    function getCategoryIcon(name) {
      return `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>`;
    }

    function getCategoryFallbackIcon() {
      return `<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`;
    }

    function renderCategories(categorias) {
      if (!categoriesList) return;
      categoriesList.classList.remove('animate-pulse');
      
      const isDestacadosActive = currentCategory === 'DESTACADOS';
      let html = `
        <button type="button" class="cat-btn ${isDestacadosActive ? 'cat-active font-black' : 'font-semibold'}" data-target="DESTACADOS">
          <span class="cat-btn-label">⭐ Destacados</span>
        </button>
      `;

      categorias.forEach(cat => {
        const isActive = String(cat.id) === currentCategory;
        html += `
          <button type="button" class="cat-btn ${isActive ? 'cat-active font-black' : 'font-semibold'}" data-target="${cat.id}">
            <span class="cat-btn-label">${cat.name}</span>
          </button>
        `;
      });
      categoriesList.innerHTML = html;

      const catBtns = categoriesList.querySelectorAll('.cat-btn');
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => {
            b.classList.remove('cat-active', 'font-black');
            b.classList.add('font-semibold');
          });
          btn.classList.add('cat-active', 'font-black');
          btn.classList.remove('font-semibold');
          currentCategory = (btn as HTMLElement).dataset.target || 'DESTACADOS';

          // Actualizar URL dinámicamente: /Catalogo, /Catalogo/Regala, /Catalogo/Regala/Tabletas, /Catalogo/Tabletas
          const activeOccasionBtn = collectionsList ? collectionsList.querySelector('.occasion-active') : null;
          let activeOccasionName = '';
          if (activeOccasionBtn) {
            const colId = (activeOccasionBtn as HTMLElement).dataset.collectionId;
            if (colId !== 'all') {
              const matchedCol = allCollections.find(c => c.id === colId);
              if (matchedCol) activeOccasionName = matchedCol.name;
            }
          }

          let newUrl = '/Catalogo';
          if (activeOccasionName) {
            newUrl += '/' + encodeURIComponent(activeOccasionName);
          }

          if (currentCategory !== 'DESTACADOS') {
            const matchedCat = allCategories.find(c => String(c.id) === currentCategory);
            const catSlug = matchedCat ? matchedCat.name : currentCategory;
            newUrl += '/' + encodeURIComponent(catSlug);
          }

          window.history.pushState({}, '', newUrl);

          renderProducts(true);
          setTimeout(() => {
            scrollToProducts(true);
          }, 80);
        });
      });
    }

    function scrollToProducts(smooth = true) {
      const target = document.getElementById('catalog-products-view') || document.getElementById('dynamic-products-grid') || document.getElementById('cajas-especiales');
      if (target) {
        target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      }
    }

    const ITEMS_PER_PAGE = 10;
    let currentVisibleLimit = 10;
    let currentFilteredProducts = [];

    const loadMoreWrapper = document.getElementById('catalog-load-more-wrapper');
    const loadMoreBtn = document.getElementById('catalog-load-more-btn');
    const loadMoreInfo = document.getElementById('catalog-load-more-info');

    function updateCatalogCount(shown, total) {
      const countEl = document.getElementById('catalog-count');
      if (countEl) {
        if (total !== undefined && total > shown) {
          countEl.textContent = `${shown} de ${total}`;
        } else {
          countEl.textContent = String(shown);
        }
      }
    }

    function updateLoadMoreUI(totalCount) {
      if (!loadMoreWrapper) return;
      if (currentVisibleLimit < totalCount) {
        loadMoreWrapper.classList.remove('hidden');
        loadMoreWrapper.classList.add('flex');
        if (loadMoreInfo) {
          const remaining = totalCount - currentVisibleLimit;
          loadMoreInfo.textContent = `Quedan ${remaining} producto${remaining === 1 ? '' : 's'} por descubrir`;
        }
      } else {
        loadMoreWrapper.classList.add('hidden');
        loadMoreWrapper.classList.remove('flex');
      }
    }

    const loadingState = document.getElementById('catalog-loading-state');

    function renderProducts(resetPagination = true) {
      if (!productsGrid) return;
      if (loadingState) loadingState.classList.add('hidden');
      productsGrid.classList.remove('hidden');

      if (resetPagination) {
        currentVisibleLimit = ITEMS_PER_PAGE;
      }

      let filtered = allProducts.filter(p => {
        let matchCategory = false;
        if (currentCategory === 'DESTACADOS' || currentCategory === 'default') {
          matchCategory = p.is_destacado === true || p.is_destacado === 1 || p.is_destacado === 'true' || p.destacado === true || p.destacado === 1 || p.destacado === 'true';
        } else {
          matchCategory = String(p.categoria_id) === String(currentCategory);
        }
        return matchCategory;
      });

      // Si en destacados ningún producto viene con flag is_destacado, mostrar todos los productos
      if ((currentCategory === 'DESTACADOS' || currentCategory === 'default') && filtered.length === 0) {
        filtered = [...allProducts];
      }

      currentFilteredProducts = filtered;

      if (filtered.length === 0) {
        productsGrid.innerHTML = '';
        if(noProductsMsg) noProductsMsg.classList.remove('hidden');
        if(loadMoreWrapper) {
          loadMoreWrapper.classList.add('hidden');
          loadMoreWrapper.classList.remove('flex');
        }
        updateCatalogCount(0, 0);
        return;
      }
      if(noProductsMsg) noProductsMsg.classList.add('hidden');

      const visibleList = filtered.slice(0, currentVisibleLimit);
      updateCatalogCount(visibleList.length, filtered.length);
      
      let html = '';
      visibleList.forEach(p => {
        const price = getProductPrice(p, currentCity);
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png';
        html += buildProductCard(p, price, wappText, imgUrl);
      });
      productsGrid.innerHTML = html;

      updateLoadMoreUI(filtered.length);
    }

    // Renderizar TODOS los productos (para "Ver todo") con paginación inicial de 10
    function renderAllProducts(resetPagination = true) {
      if (!productsGrid) return;
      if (loadingState) loadingState.classList.add('hidden');
      productsGrid.classList.remove('hidden');

      if (resetPagination) {
        currentVisibleLimit = ITEMS_PER_PAGE;
      }

      currentFilteredProducts = allProducts;

      if (allProducts.length === 0) {
        productsGrid.innerHTML = '';
        if(noProductsMsg) noProductsMsg.classList.remove('hidden');
        if(loadMoreWrapper) {
          loadMoreWrapper.classList.add('hidden');
          loadMoreWrapper.classList.remove('flex');
        }
        updateCatalogCount(0, 0);
        return;
      }
      if(noProductsMsg) noProductsMsg.classList.add('hidden');

      const visibleList = allProducts.slice(0, currentVisibleLimit);
      updateCatalogCount(visibleList.length, allProducts.length);

      let html = '';
      visibleList.forEach(p => {
        const price = getProductPrice(p, currentCity);
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png';
        html += buildProductCard(p, price, wappText, imgUrl);
      });
      productsGrid.innerHTML = html;

      updateLoadMoreUI(allProducts.length);
    }

    // Event listener para el botón "Ver más productos"
    loadMoreBtn?.addEventListener('click', () => {
      currentVisibleLimit += ITEMS_PER_PAGE;
      const visibleList = currentFilteredProducts.slice(0, currentVisibleLimit);
      
      let html = '';
      visibleList.forEach(p => {
        const price = getProductPrice(p, currentCity);
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png';
        html += buildProductCard(p, price, wappText, imgUrl);
      });
      productsGrid.innerHTML = html;

      updateCatalogCount(visibleList.length, currentFilteredProducts.length);
      updateLoadMoreUI(currentFilteredProducts.length);
    });

    // Plantilla de tarjeta — compartida entre renderProducts y renderAllProducts
    function buildProductCard(p, price, wappText, imgUrl) {
      const cochaPrice = p.precios?.cochabamba || p.precios?.cocha || price;
      const lapazPrice = p.precios?.la_paz || p.precios?.lapaz || price;
      const prodId = p.id || p.nombre.toLowerCase().replace(/\s+/g, '-');
      const prodName = p.nombre.replace(/"/g, '&quot;');
      const prodSize = (p.tamano || 'Presentación Especial').replace(/"/g, '&quot;');
      const prodDesc = (p.descripcion || p.detalles || p.resumen || '').replace(/"/g, '&quot;');

      return `
        <div
          class="product-card group relative bg-white rounded-2xl border border-[#ecddd0]/80 flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_45px_rgba(42,22,18,0.14)] cursor-pointer"
          data-id="${prodId}"
          data-name="${prodName}"
          data-size="${prodSize}"
          data-img="${imgUrl}"
