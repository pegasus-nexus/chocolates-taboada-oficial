---
---

<style is:global>
  /* ──────────────────────────────────────────────────
     CSS overrides for JS-injected category chips
     (renderCategories() injects .cat-btn elements)
  ────────────────────────────────────────────────── */
  #dynamic-categories-list {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.5rem !important;
    overflow-x: auto;
    padding-bottom: 2px;
  }
  #dynamic-categories-list > div,
  #dynamic-categories-list > button {
    flex-shrink: 0 !important;
    width: auto !important;
  }
  /* Base chip style (overrides Tailwind w-full, rounded-lg, etc.) */
  #dynamic-categories-list .cat-btn {
    display: inline-flex !important;
    align-items: center !important;
    width: auto !important;
    padding: 0.4rem 1.1rem !important;
    border-radius: 9999px !important;
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    border: 1.5px solid #e2d5c3 !important;
    background: rgba(255, 255, 255, 0.9) !important;
    color: #7a5c45 !important;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap !important;
    text-align: center !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    box-shadow: 0 1px 3px rgba(42, 22, 18, 0.06);
  }
  #dynamic-categories-list .cat-btn:hover {
    border-color: #dcb041 !important;
    color: #2A1612 !important;
    background: #ffffff !important;
    box-shadow: 0 2px 8px rgba(220, 176, 65, 0.2);
  }
  /* Active state — JS adds class "font-black" to the selected chip */
  #dynamic-categories-list .cat-btn.font-black {
    background: #2A1612 !important;
    color: #dcb041 !important;
    border-color: #2A1612 !important;
    font-weight: 800 !important;
    box-shadow: 0 4px 12px rgba(42, 22, 18, 0.25) !important;
  }
  /* Hide old tooltip & icon (not needed in chip layout) */
  #dynamic-categories-list .cat-floating-tooltip {
    display: none !important;
  }
  #dynamic-categories-list .cat-btn svg {
    display: none !important;
  }
  /* Hide scrollbar */
  #dynamic-categories-list::-webkit-scrollbar { display: none; }
  #dynamic-categories-list { -ms-overflow-style: none; scrollbar-width: none; }

  /* Loading spinner animation */
  @keyframes spin-catalog { to { transform: rotate(360deg); } }
  .catalog-spinner { animation: spin-catalog 0.8s linear infinite; }
</style>

<!-- ════════════════════════════════════════════════
     SECCIÓN: CATÁLOGO  (id="cajas-especiales" REQUERIDO)
════════════════════════════════════════════════ -->
<section
  id="cajas-especiales"
  class="relative bg-[#FAF5F0] py-14 md:py-24 border-t border-[#e8dccb]/60 overflow-hidden"
>
  <!-- Fondo decorativo (conservado — index.astro lo referencia) -->
  <div
    id="cajas-especiales-bg"
    class="absolute inset-0 bg-gradient-to-br from-[#FAF5F0] via-[#F3ECE3] to-[#FAF5F0] transition-all duration-500"
  ></div>
  <!-- Glow superior derecho -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-radial from-amber-100/25 to-transparent blur-[120px] opacity-50 pointer-events-none"
  ></div>
  <!-- Glow inferior izquierdo -->
  <div
    class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-radial from-[#f6d98d]/10 to-transparent blur-[100px] opacity-40 pointer-events-none"
  ></div>

  <!-- ── CONTENEDOR PRINCIPAL ── -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ══════════════════════════════════════════
         SECCIÓN 1 — HEADER + BUSCADOR
    ══════════════════════════════════════════ -->
    <div class="text-center mb-10 md:mb-14">

      <!-- Eyebrow label -->
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="w-10 h-px bg-[#dcb041] rounded-full"></span>
        <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-[0.3em] text-[#8f6c49]">
          Chocolates Taboada
        </span>
        <span class="w-10 h-px bg-[#dcb041] rounded-full"></span>
      </div>

      <!-- Título principal -->
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#2A1612] font-serif tracking-tight mb-3 leading-[1.05]">
        Catálogo
      </h2>
      <p class="text-[#5D4037]/65 text-sm sm:text-base md:text-lg max-w-lg mx-auto leading-relaxed mb-8 font-sans">
        Explora nuestros chocolates y encuentra el producto ideal para cada ocasión.
      </p>

      <!-- Buscador visual (UI preparada — no conectado al backend) -->
      <div class="max-w-md sm:max-w-lg mx-auto relative group">
        <label for="catalog-search-input" class="sr-only">Buscar en el catálogo</label>
        <input
          type="text"
          id="catalog-search-input"
          placeholder="Buscar chocolates, cajas de regalo..."
          autocomplete="off"
          class="w-full pl-12 pr-5 py-3.5 rounded-full border border-[#e8dccb] bg-white/95 backdrop-blur text-[#2A1612] placeholder-[#b8a08a] text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-[#dcb041]/30 focus:border-[#dcb041] transition-all duration-300"
        />
        <svg
          class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#b8a08a] pointer-events-none group-focus-within:text-[#dcb041] transition-colors"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
        </svg>
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         SECCIÓN 2 — FILTROS POR OCASIÓN (visual)
         Botones estáticos — sin lógica de backend
    ══════════════════════════════════════════ -->
    <div class="mb-7">
      <p class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#8f6c49] mb-3">
        Para cada ocasión
      </p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">🎁 Regalar</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">❤️ Sorprender</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">☕ Con un café</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">🎉 Celebraciones</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">👨‍👩‍👧 Compartir</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">🏢 Empresas</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-white border border-[#e8dccb] text-[#5D4037] hover:border-[#dcb041] hover:text-[#2A1612] hover:shadow-sm transition-all duration-200 cursor-pointer shadow-sm">👶 Niños</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-extrabold bg-[#2A1612] border border-[#2A1612] text-[#dcb041] hover:bg-[#3d200f] hover:shadow transition-all duration-200 cursor-pointer shadow-sm">⭐ Ver todo</button>
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         SECCIÓN 3 — FILTROS POR TIPO (desde API)
         renderCategories() inyecta los .cat-btn aquí
         ⚠️ No mover ni renombrar este div
    ══════════════════════════════════════════ -->
    <div class="mb-8">
      <p class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#8f6c49] mb-3">
        Filtrar por tipo de producto
      </p>
      <!-- ⚠️ id="dynamic-categories-list" requerido por renderCategories() -->
      <div id="dynamic-categories-list" class="flex flex-wrap gap-2">
        <div class="text-xs italic text-[#a08b7a] py-1 px-1">Cargando categorías...</div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         SECCIÓN 4 — BARRA SUPERIOR: COUNT + SORT
         (Sort es UI preparada — sin lógica backend)
    ══════════════════════════════════════════ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 py-3.5 border-y border-[#e8dccb]/70">
      <!-- Contador de productos (actualizado por renderProducts()) -->
      <p class="text-sm text-[#5D4037]/65 font-medium">
        <span id="catalog-count" class="font-black text-[#2A1612] text-base">—</span>
        <span class="ml-1">producto(s) encontrado(s)</span>
      </p>

      <!-- Selector de orden (UI preparada) -->
      <div class="flex items-center gap-2.5">
        <label for="catalog-sort-select" class="text-[10px] font-extrabold uppercase tracking-wider text-[#8f6c49] whitespace-nowrap">
          Ordenar por
        </label>
        <div class="relative">
          <select
            id="catalog-sort-select"
            class="appearance-none text-sm border border-[#e8dccb] rounded-full pl-3.5 pr-9 py-1.5 bg-white text-[#2A1612] font-semibold focus:outline-none focus:ring-2 focus:ring-[#dcb041]/30 focus:border-[#dcb041] cursor-pointer transition-colors"
          >
            <option value="default">Destacados</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="name-az">Nombre A–Z</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#8f6c49] pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         SECCIÓN 5 — GRID DE PRODUCTOS
         ⚠️ id="dynamic-products-grid" requerido por renderProducts()
    ══════════════════════════════════════════ -->
    <div
      id="dynamic-products-grid"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4 md:gap-5 min-h-[450px]"
    >
      <!-- Estado de carga inicial -->
      <div class="col-span-full flex flex-col items-center justify-center py-24 gap-4">
        <div class="w-10 h-10 border-[3px] border-[#dcb041] border-t-transparent rounded-full catalog-spinner"></div>
        <p class="text-sm text-[#a08b7a] italic font-medium">Cargando colección...</p>
      </div>
    </div>

    <!-- Mensaje sin productos (⚠️ id="no-products-msg" requerido) -->
    <div id="no-products-msg" class="hidden py-24 text-center">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white/60 mb-6 shadow-inner">
        <svg class="w-12 h-12 text-[#dcb041]/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-[#2A1612] font-serif mb-2">No se encontraron productos</h3>
      <p class="text-[#5D4037]/60 font-sans text-sm">Prueba seleccionando otra categoría.</p>
    </div>

    <!-- ══════════════════════════════════════════
         ELEMENTOS OCULTOS — Compatibilidad JS
         El script de setupSidebarToggle usa optional
         chaining (?.) así que no rompe si están vacíos.
         Se conservan para que getElementById() no devuelva null.
    ══════════════════════════════════════════ -->
    <aside id="cat-sidebar" class="hidden" aria-hidden="true">
      <div id="cat-sidebar-header-title"></div>
      <button id="toggle-cat-sidebar-btn" type="button" aria-hidden="true"></button>
    </aside>
    <svg id="cat-sidebar-arrow-icon" class="hidden" aria-hidden="true"></svg>
    <div id="product-grid-column" class="hidden" aria-hidden="true"></div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoriesList = document.getElementById('dynamic-categories-list');
    const productsGrid = document.getElementById('dynamic-products-grid');
    const noProductsMsg = document.getElementById('no-products-msg');
    
    let allProducts = [];
    let currentCategory = 'DESTACADOS';
    let currentCity = localStorage.getItem('taboada_selected_city') || 'cochabamba';
    
    // Obtenemos la URL de la API
    const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:10000/api/v1";

    // Detectar cambios de ciudad
    window.addEventListener('cityChanged', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.city) {
        currentCity = detail.city;
        renderProducts();
      }
    });

    async function loadCatalog() {
      try {
        const response = await fetch(`${apiUrl}/fidelizacion/catalog`);
        if (!response.ok) throw new Error('Error fetching catalog');
        
        const data = await response.json();
        
        if (data.status === 'success') {
          // Filtrar categorías que no tienen productos si es necesario (opcional)
          renderCategories(data.categorias);
          allProducts = data.productos;
          renderProducts();
          setupSidebarToggle();
        }
      } catch (error) {
        console.error('Error cargando catálogo:', error);
        if (productsGrid) {
          productsGrid.innerHTML = '<div class="col-span-full text-center text-red-500 py-10">Ocurrió un error al cargar el catálogo.</div>';
        }
      }
    }

    function getCategoryIcon(name) {
      // Retorna un SVG string en base al nombre
      return `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>`;
    }

    function getCategoryFallbackIcon() {
        return `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`;
    }

    function renderCategories(categorias) {
      if (!categoriesList) return;
      
      // Chip "Destacados" — activo por defecto (font-black = selector CSS activo)
      let html = `
        <div class="relative group/cat-tooltip flex-shrink-0 lg:flex-shrink w-full">
          <button
            type="button"
            class="cat-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-black transition-all duration-300 cursor-pointer text-left group bg-transparent text-[#2A1612] border-l-2 border-[#dcb041]"
            data-target="DESTACADOS"
          >
            <span class="cat-btn-label flex-1 truncate text-xs font-sans tracking-tight">⭐ Destacados</span>
          </button>
          <span class="cat-floating-tooltip absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#2A1612] text-white text-[11px] font-bold rounded-lg shadow-xl opacity-0 pointer-events-none transition-opacity duration-200 z-50 whitespace-nowrap border border-white/10 hidden group-hover/cat-tooltip:opacity-100">
            Destacados
          </span>
        </div>
      `;

      categorias.forEach(cat => {
        html += `
          <div class="relative group/cat-tooltip flex-shrink-0 lg:flex-shrink w-full">
            <button
              type="button"
              class="cat-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold transition-all duration-300 cursor-pointer text-left group text-[#5D4037]/80 hover:text-[#2A1612] bg-transparent border-l-2 border-transparent"
              data-target="${cat.id}"
            >
              <span class="cat-btn-label flex-1 truncate text-xs font-sans tracking-tight">${cat.name}</span>
            </button>
            <span class="cat-floating-tooltip absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#2A1612] text-white text-[11px] font-bold rounded-lg shadow-xl opacity-0 pointer-events-none transition-opacity duration-200 z-50 whitespace-nowrap border border-white/10 hidden group-hover/cat-tooltip:opacity-100">
              ${cat.name}
            </span>
          </div>
        `;
      });
      categoriesList.innerHTML = html;

      // Eventos de click en categorías
      const catBtns = categoriesList.querySelectorAll('.cat-btn');
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remover activo de todos
          catBtns.forEach(b => {
            b.classList.remove('text-[#2A1612]', 'font-black', 'border-[#dcb041]');
            b.classList.add('text-[#5D4037]/80', 'font-semibold', 'border-transparent', 'hover:text-[#2A1612]');
          });
          // Añadir activo al clickeado
          btn.classList.add('text-[#2A1612]', 'font-black', 'border-[#dcb041]');
          btn.classList.remove('text-[#5D4037]/80', 'font-semibold', 'border-transparent', 'hover:text-[#2A1612]');
          
          currentCategory = (btn as HTMLElement).dataset.target || 'DESTACADOS';
          renderProducts();
        });
      });
    }

    // Actualiza el contador visual de productos (nuevo helper, no modifica lógica)
    function updateCatalogCount(count) {
      const countEl = document.getElementById('catalog-count');
      if (countEl) countEl.textContent = String(count);
    }

    function renderProducts() {
      if (!productsGrid) return;
      
      const filtered = allProducts.filter(p => {
        let matchCategory = false;
        if (currentCategory === 'DESTACADOS') {
          matchCategory = p.is_destacado === true;
        } else {
          matchCategory = p.categoria_id === currentCategory;
        }
        const cityKey = currentCity === 'la-paz' ? 'la_paz' : currentCity;
        const hasPriceForCity = p.precios && p.precios[cityKey] !== undefined;
        return matchCategory && hasPriceForCity;
      });

      if (filtered.length === 0) {
        productsGrid.innerHTML = '';
        if(noProductsMsg) noProductsMsg.classList.remove('hidden');
        updateCatalogCount(0);
        return;
      }
      
      if(noProductsMsg) noProductsMsg.classList.add('hidden');
      updateCatalogCount(filtered.length);
      
      let html = '';
      filtered.forEach(p => {
        const cityKey = currentCity === 'la-paz' ? 'la_paz' : currentCity;
        const price = p.precios[cityKey];
        const wappText = encodeURIComponent(`Hola, quiero comprar el producto: ${p.nombre}`);
        const imgUrl = p.imagen || '/img/produc1.png'; // Fallback
        const desc = p.descripcion || 'El verdadero sabor del cacao seleccionado.';
        
        html += `
          <div class="product-card group relative bg-white rounded-2xl border border-[#ecddd0]/80 flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(42,22,18,0.13)]">

            ${p.is_destacado ? `
            <div class="absolute top-2.5 left-2.5 z-20">
              <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-[#dcb041] text-[#2A1612] text-[9px] font-black uppercase tracking-wide shadow-sm">★ Destacado</span>
            </div>` : ''}

            <!-- Botón añadir al carrito (clase add-to-cart-btn conservada íntegramente) -->
            <div class="absolute top-2.5 right-2.5 z-20 group/tooltip">
              <button
                type="button"
                class="add-to-cart-btn w-8 h-8 bg-white/95 hover:bg-[#2A1612] hover:text-[#dcb041] border border-[#e8dccb] text-[#2A1612] rounded-full flex items-center justify-center transition-all duration-300 shadow-sm hover:scale-110 active:scale-95 cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
              </button>
              <span class="absolute right-0 -bottom-8 bg-[#2A1612] text-white text-[9px] font-bold px-2 py-1 rounded-lg shadow-lg whitespace-nowrap opacity-0 pointer-events-none group-hover/tooltip:opacity-100 transition-opacity duration-200 z-30">
                Añadir al carrito
              </span>
            </div>

            <!-- Imagen del producto -->
            <div class="w-full bg-[#FAF5F0] h-40 sm:h-44 flex items-center justify-center p-4 sm:p-5 overflow-hidden">
              <img
                src="${imgUrl}"
                alt="${p.nombre}"
                loading="lazy"
                class="max-w-full max-h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-500"
              />
            </div>

