---
// Navbar.astro - Componente de Navegación Reutilizable Oficial de Chocolates Taboada
import RegisterModal from './RegisterModal.astro';
import CartDrawer from './CartDrawer.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";
---

<nav
  id="main-navbar"
  class="fixed top-0 left-0 w-full z-[999] transition-all duration-500 bg-transparent border-b border-transparent hover:bg-white/10"
>
  <div class="max-w-[1280px] mx-auto flex items-center justify-between h-[85px] md:h-[95px] px-6 lg:px-12 relative">
    
    <!-- LOGO IZQUIERDO -->
    <div class="flex items-center">
      <a href="/">
        <img
          src="/img/taboada-logo.png"
          alt="Taboada"
          class="h-[50px] md:h-[65px] object-contain transition-transform duration-300 hover:scale-105"
        />
      </a>
    </div>

    <!-- ENLACES CENTRALES (Desktop) -->
    <div class="hidden md:flex items-center gap-7 lg:gap-10 ml-8 lg:ml-16">
      <!-- INICIO -->
      <a
        href="/"
        class={`relative group py-2 font-bold text-sm tracking-wide transition-colors duration-300 ${currentPath === '/' ? 'text-[#dcb041]' : 'text-white/90 hover:text-[#dcb041]'}`}
      >
        Inicio
        <span class={`absolute bottom-[-2px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#dcb041] rounded-full transition-all duration-300 ease-out ${currentPath === '/' ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
      </a>

      <!-- NOSOTROS -->
      <a
        href="/nosotros"
        class={`relative group py-2 font-bold text-sm tracking-wide transition-colors duration-300 ${currentPath === '/nosotros' ? 'text-[#dcb041]' : 'text-white/90 hover:text-[#dcb041]'}`}
      >
        Nosotros
        <span class={`absolute bottom-[-2px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#dcb041] rounded-full transition-all duration-300 ease-out ${currentPath === '/nosotros' ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
      </a>

      <!-- COLECCIONES (Dropdown) -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1 text-white/90 hover:text-[#dcb041] font-bold text-sm tracking-wide transition-colors duration-300 cursor-pointer">
          Colecciones
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <span class="absolute bottom-[-2px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#dcb041] rounded-full scale-0 group-hover:scale-100 transition-all duration-300 ease-out"></span>
        
        <!-- CONTENIDO DROPDOWN (MEGA-MENU HORIZONTAL ELEGANTE CAFÉ CHOCOLATE + BEIGE + DORADO) -->
        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-[820px] lg:w-[920px] max-w-[95vw] rounded-3xl bg-[#2A1612]/98 border border-[#dcb041]/30 shadow-[0_25px_60px_rgba(0,0,0,0.65)] backdrop-blur-2xl p-6 md:p-7 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[1000] translate-y-2 group-hover:translate-y-0">
          
          <!-- TITULO HEADER -->
          <div class="px-2 pb-3 mb-5 text-xs font-extrabold tracking-widest uppercase text-[#dcb041] border-b border-[#FAF5F0]/15 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-[#dcb041]/20 flex items-center justify-center text-[#dcb041]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21" /></svg>
              </div>
              <span class="font-serif tracking-wider text-sm">Colecciones & Ocasiones Especiales</span>
            </div>
            <span class="text-xs text-[#FAF5F0]/60 font-serif italic">Elige tu momento ideal</span>
          </div>

          <!-- GRID HORIZONTAL DE 7 ÍCONOS CIRCULARES BEIGE/DORADO CON TEXTO MÁS GRANDE -->
          <div class="grid grid-cols-4 sm:grid-cols-7 gap-3 md:gap-4 items-start justify-items-center">
            
            <!-- 1. Sorprender a alguien -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Sorprender a alguien</span>
            </a>

            <!-- 2. Disfrutar con un café -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Disfrutar con un café</span>
            </a>

            <!-- 3. Celebraciones y eventos -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Celebraciones y eventos</span>
            </a>

            <!-- 4. Compartir en familia -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Compartir en familia</span>
            </a>

            <!-- 5. Empresas y regalos corporativos -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5s0 0 0 0m3 0h1.5s0 0 0 0M9 10.5h1.5s0 0 0 0m3 0h1.5s0 0 0 0M9 14.25h1.5s0 0 0 0m3 0h1.5s0 0 0 0M9 18h1.5s0 0 0 0m3 0h1.5s0 0 0 0" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Regalos corporativos</span>
            </a>

            <!-- 6. Niños -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_25px_rgba(220,176,65,0.5)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>
              </div>
              <span class="text-xs md:text-sm font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight max-w-[110px]">Para Niños</span>
            </a>

            <!-- 7. Ver todo el catálogo -->
            <a href="/#cajas-especiales" class="flex flex-col items-center gap-3 p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-full bg-[#dcb041] text-[#2A1612] flex items-center justify-center group-hover/item:scale-110 group-hover/item:shadow-[0_0_30px_rgba(220,176,65,0.7)] transition-all duration-300 flex-shrink-0">
                <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
              </div>
              <span class="text-xs md:text-sm font-extrabold text-[#dcb041] group-hover/item:text-[#FAF5F0] transition-colors leading-tight max-w-[110px]">Ver Catálogo →</span>
            </a>

          </div>
        </div>
      </div>

      <!-- COMUNIDAD (Mega-Menú Horizontal) -->
      <div class="relative group py-2">
        <button type="button" class={`flex items-center gap-1 font-bold text-sm tracking-wide transition-colors duration-300 cursor-pointer ${(currentPath === '/beneficios' || currentPath === '/adulto-mayor') ? 'text-[#dcb041]' : 'text-white/90 hover:text-[#dcb041]'}`}>
          Comunidad
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <span class={`absolute bottom-[-2px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#dcb041] rounded-full transition-all duration-300 ease-out ${(currentPath === '/beneficios' || currentPath === '/adulto-mayor') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>

        <!-- CONTENIDO DROPDOWN HORIZONTAL COMUNIDAD -->
        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-[500px] md:w-[580px] max-w-[95vw] rounded-3xl bg-[#2A1612]/98 border border-[#dcb041]/30 shadow-[0_25px_60px_rgba(0,0,0,0.65)] backdrop-blur-2xl p-6 md:p-7 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[1000] translate-y-2 group-hover:translate-y-0">
          
          <!-- TITULO HEADER -->
          <div class="px-2 pb-3 mb-5 text-xs font-extrabold tracking-widest uppercase text-[#dcb041] border-b border-[#FAF5F0]/15 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-[#dcb041]/20 flex items-center justify-center text-[#dcb041]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a5.97 5.97 0 00-.942 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
              </div>
              <span class="font-serif tracking-wider text-sm">Comunidad & Membresías</span>
            </div>
            <span class="text-xs text-[#FAF5F0]/60 font-serif italic">Experiencias exclusivas</span>
          </div>

          <!-- GRID HORIZONTAL DE LAS 2 OPCIONES ORIGINALES -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-start justify-items-center">
            
            <!-- 1. Comunidad Taboada -->
            <a href="/beneficios" class="flex flex-col items-center gap-3 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_30px_rgba(220,176,65,0.6)] transition-all duration-300 flex-shrink-0">
                <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" /></svg>
              </div>
              <div>
                <span class="text-sm md:text-base font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight block">Comunidad Taboada</span>
                <span class="text-xs text-[#FAF5F0]/70 font-normal leading-relaxed mt-1 block max-w-[210px]">Regístrate gratis y accede a regalos, experiencias y beneficios exclusivos.</span>
              </div>
            </a>

            <!-- 2. Membresía Legado -->
            <a href="/adulto-mayor" class="flex flex-col items-center gap-3 p-3 rounded-2xl hover:bg-white/5 transition-all duration-300 group/item text-center w-full">
              <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-[#FAF5F0]/10 border border-[#FAF5F0]/20 flex items-center justify-center text-[#dcb041] group-hover/item:bg-[#dcb041] group-hover/item:text-[#2A1612] group-hover/item:scale-110 group-hover/item:shadow-[0_0_30px_rgba(220,176,65,0.6)] transition-all duration-300 flex-shrink-0">
                <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
              </div>
              <div>
                <span class="text-sm md:text-base font-bold text-[#FAF5F0] group-hover/item:text-[#dcb041] transition-colors leading-tight block">Membresía Legado</span>
                <span class="text-xs text-[#FAF5F0]/70 font-normal leading-relaxed mt-1 block max-w-[210px]">Más experiencias, más momentos para disfrutar.</span>
              </div>
            </a>

          </div>
        </div>
      </div>
    </div>

    <!-- DERECHA (Selector Ciudad + CTA Registrarse / Perfil Limpio Sin Fondo + Hamburger) -->
    <div class="flex items-center gap-3.5 md:gap-6 ml-auto pl-4 md:pl-8 border-l border-white/15 relative overflow-visible">
      


      <!-- BOTÓN CARRITO DE COMPRAS CON INSIENIA CONTADORA DORADA -->
      <button
        type="button"
        onclick="if(typeof window.openCartDrawer === 'function') window.openCartDrawer()"
        class="relative flex items-center justify-center w-10 h-10 rounded-full bg-white/10 text-white hover:bg-white/20 border border-white/20 transition-all duration-300 cursor-pointer shadow-lg hover:scale-105 group"
        aria-label="Abrir carrito de compras"
        title="Mi Carrito"
      >
        <svg class="w-5 h-5 text-[#dcb041] transition-transform group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
        <span class="cart-nav-badge-count absolute -top-1 -right-1 w-5 h-5 rounded-full bg-[#dcb041] text-[#2A1612] font-black text-[10px] flex items-center justify-center shadow-md hidden">0</span>
      </button>

      <!-- BOTÓN REGÍSTRATE (Para usuario NO registrado) -->
      <button
        id="nav-register-btn"
        type="button"
        class="hidden sm:inline-flex items-center justify-center bg-gradient-to-r from-[#dcb041] to-[#f4c856] text-[#2A1612] font-extrabold text-xs md:text-sm px-6 py-2.5 rounded-full shadow-[0_4px_18px_rgba(220,176,65,0.35)] hover:shadow-[0_6px_22px_rgba(220,176,65,0.5)] transition-all duration-300 transform hover:scale-[1.03] active:scale-[0.98] cursor-pointer"
      >
        Regístrate
      </button>

      <!-- PERFIL LIMPIO DE USUARIO (Para usuario REGISTRADO: Sin fondo ni bordes) -->
