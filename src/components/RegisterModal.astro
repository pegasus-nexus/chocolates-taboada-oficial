---
// RegisterModal.astro - Modal Unificado de Registro de la Comunidad Taboada
---

<div
  id="taboada-register-modal"
  class="fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
>
  <div
    class="relative w-full max-w-md bg-[#1C0D0E]/95 border border-[#dcb041]/35 rounded-3xl p-6 md:p-8 shadow-[0_25px_60px_rgba(0,0,0,0.7)] backdrop-blur-xl transform scale-95 transition-all duration-300"
    id="taboada-register-card"
  >
    <!-- Botón Cerrar X -->
    <button
      id="close-reg-modal-btn"
      type="button"
      class="absolute top-5 right-5 text-white/50 hover:text-white transition-colors cursor-pointer p-1 rounded-full hover:bg-white/10"
      aria-label="Cerrar modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- ENCABEZADO -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[#dcb041]/15 text-[#dcb041] mb-3 shadow-[0_0_15px_rgba(220,176,65,0.2)]">
        <span class="text-2xl">✨</span>
      </div>
      <h3 class="font-serif text-2xl md:text-3xl font-extrabold text-[#f6d98d] tracking-wide mb-2">
        Verifica tu Identidad
      </h3>
      <p class="text-xs md:text-sm text-white/70 leading-relaxed max-w-xs mx-auto">
        Para asegurar que tus beneficios exclusivos y regalos de la Comunidad Taboada lleguen a tus manos, completa tus datos.
      </p>
    </div>

    <!-- FORMULARIO DE REGISTRO (3 CAMPOS ESTRICTOS) -->
    <form id="taboada-reg-form" class="space-y-4" novalidate>
      <div>
        <label for="reg-nombre" class="block text-xs font-bold text-[#dcb041] uppercase tracking-wider mb-1">
          Nombre *
        </label>
        <input
          type="text"
          id="reg-nombre"
          required
          placeholder="Ej. Sahian"
          autocomplete="given-name"
          class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 focus:border-[#dcb041] focus:ring-1 focus:ring-[#dcb041] text-white text-sm placeholder:text-white/30 outline-none transition-all"
        />
        <p id="reg-nombre-error" class="hidden text-xs text-amber-300 mt-1 font-medium"></p>
      </div>

      <div>
        <label for="reg-apellido" class="block text-xs font-bold text-[#dcb041] uppercase tracking-wider mb-1">
          Apellido *
        </label>
        <input
          type="text"
          id="reg-apellido"
          required
          placeholder="Ej. Mariné"
          autocomplete="family-name"
          class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 focus:border-[#dcb041] focus:ring-1 focus:ring-[#dcb041] text-white text-sm placeholder:text-white/30 outline-none transition-all"
        />
        <p id="reg-apellido-error" class="hidden text-xs text-amber-300 mt-1 font-medium"></p>
      </div>

      <div>
        <label for="reg-celular" class="block text-xs font-bold text-[#dcb041] uppercase tracking-wider mb-1">
          Número de Celular (8 dígitos) *
        </label>
        <input
          type="tel"
          id="reg-celular"
          required
          maxlength="8"
          inputmode="numeric"
          placeholder="Ej. 62679408 (Inicia con 5, 6 o 7)"
          autocomplete="tel"
          class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/15 focus:border-[#dcb041] focus:ring-1 focus:ring-[#dcb041] text-white text-sm placeholder:text-white/30 outline-none transition-all"
        />
        <p id="reg-celular-error" class="hidden text-xs text-amber-300 mt-1 font-medium"></p>
      </div>

      <button
        type="submit"
        id="reg-submit-btn"
        class="w-full py-3.5 mt-2 bg-gradient-to-r from-[#dcb041] to-[#f4c856] text-[#2A1612] font-extrabold text-sm rounded-full shadow-[0_4px_20px_rgba(220,176,65,0.35)] hover:shadow-[0_6px_25px_rgba(220,176,65,0.5)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 cursor-pointer uppercase tracking-wider"
      >
        Confirmar y Canjear
      </button>
    </form>

    <div class="text-center mt-4">
      <button
        type="button"
        id="cancel-reg-modal-btn"
        class="text-xs text-white/40 hover:text-white/70 transition-colors uppercase tracking-widest cursor-pointer"
      >
        Cancelar
      </button>
    </div>
  </div>
</div>

<script>
  let activeTicketTarget: string | null = null;

  function initRegisterModal() {
    const modal = document.getElementById('taboada-register-modal');
    const card = document.getElementById('taboada-register-card');
    const closeBtn = document.getElementById('close-reg-modal-btn');
    const cancelBtn = document.getElementById('cancel-reg-modal-btn');
    const form = document.getElementById('taboada-reg-form') as HTMLFormElement;
    const submitBtn = document.getElementById('reg-submit-btn');

    const nombreInput = document.getElementById('reg-nombre') as HTMLInputElement;
    const apellidoInput = document.getElementById('reg-apellido') as HTMLInputElement;
    const celularInput = document.getElementById('reg-celular') as HTMLInputElement;

    const nombreError = document.getElementById('reg-nombre-error');
    const apellidoError = document.getElementById('reg-apellido-error');
    const celularError = document.getElementById('reg-celular-error');

    const showError = (el: HTMLElement | null, input: HTMLInputElement | null, msg: string) => {
      if (el) {
        el.textContent = msg;
        el.classList.remove('hidden');
      }
      if (input) {
        input.classList.add('border-amber-400', 'bg-amber-400/10');
        input.classList.remove('border-white/15');
      }
    };

    const clearError = (el: HTMLElement | null, input: HTMLInputElement | null) => {
      if (el) {
        el.textContent = '';
        el.classList.add('hidden');
      }
      if (input) {
        input.classList.remove('border-amber-400', 'bg-amber-400/10');
        input.classList.add('border-white/15');
      }
    };

    // Restricción en tiempo real: NO números en nombre ni apellido
    nombreInput?.addEventListener('input', () => {
      const sanitized = nombreInput.value.replace(/[0-9]/g, '');
      if (sanitized !== nombreInput.value) {
        nombreInput.value = sanitized;
        showError(nombreError, nombreInput, 'El nombre no puede contener números.');
      } else {
        clearError(nombreError, nombreInput);
      }
    });

    apellidoInput?.addEventListener('input', () => {
      const sanitized = apellidoInput.value.replace(/[0-9]/g, '');
      if (sanitized !== apellidoInput.value) {
        apellidoInput.value = sanitized;
        showError(apellidoError, apellidoInput, 'El apellido no puede contener números.');
      } else {
        clearError(apellidoError, apellidoInput);
      }
    });

    // Restricción en tiempo real: Solo números y máximo 8 dígitos en celular
    celularInput?.addEventListener('input', () => {
      const sanitized = celularInput.value.replace(/\D/g, '').slice(0, 8);
      celularInput.value = sanitized;

      if (sanitized.length > 0 && !['5', '6', '7'].includes(sanitized.charAt(0))) {
        showError(celularError, celularInput, 'El número de celular debe iniciar con 5, 6 o 7.');
      } else if (sanitized.length > 0 && sanitized.length < 8) {
        clearError(celularError, celularInput);
      } else {
        clearError(celularError, celularInput);
      }
    });

    const openModal = (ticketId: string | null = null) => {
      activeTicketTarget = ticketId;
      modal?.classList.remove('opacity-0', 'pointer-events-none');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
    };

    const closeModal = () => {
      card?.classList.remove('scale-100');
      card?.classList.add('scale-95');
      modal?.classList.add('opacity-0', 'pointer-events-none');
      clearError(nombreError, nombreInput);
      clearError(apellidoError, apellidoInput);
      clearError(celularError, celularInput);
    };

    // Exponer funciones globales
    (window as any).openRegisterModal = openModal;
    (window as any).closeRegisterModal = closeModal;

    // Escuchar eventos globales de apertura
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#nav-register-btn') || target.closest('#mobile-register-btn') || target.closest('[data-open-register-modal]')) {
        e.preventDefault();
        openModal(null);
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Envío del Formulario con Validación Estricta
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      let hasError = false;
      const nombreVal = nombreInput?.value.trim();
      const apellidoVal = apellidoInput?.value.trim();
      const celularVal = celularInput?.value.trim();

      // Validación Nombre: Sin números y no vacío
      if (!nombreVal) {
        showError(nombreError, nombreInput, 'Por favor, ingresa tu nombre.');
        hasError = true;
      } else if (/\d/.test(nombreVal)) {
        showError(nombreError, nombreInput, 'El nombre no puede contener números.');
        hasError = true;
      } else {
        clearError(nombreError, nombreInput);
      }

      // Validación Apellido: Sin números y no vacío
      if (!apellidoVal) {
        showError(apellidoError, apellidoInput, 'Por favor, ingresa tu apellido.');
        hasError = true;
      } else if (/\d/.test(apellidoVal)) {
        showError(apellidoError, apellidoInput, 'El apellido no puede contener números.');
        hasError = true;
      } else {
        clearError(apellidoError, apellidoInput);
      }

      // Validación Celular: Exactamente 8 dígitos numéricos iniciando en 5, 6 o 7
      if (!celularVal) {
        showError(celularError, celularInput, 'Por favor, ingresa tu número de celular.');
        hasError = true;
      } else if (!/^[567]\d{7}$/.test(celularVal)) {
        if (!['5', '6', '7'].includes(celularVal.charAt(0))) {
          showError(celularError, celularInput, 'El número de celular debe iniciar con 5, 6 o 7.');
        } else if (celularVal.length !== 8) {
          showError(celularError, celularInput, `Debe tener exactamente 8 dígitos (ingresaste ${celularVal.length}).`);
        } else {
          showError(celularError, celularInput, 'Formato de celular inválido (Ej. 62679408).');
        }
        hasError = true;
      } else {
        clearError(celularError, celularInput);
      }

      if (hasError) return;
      
      const originalBtnText = submitBtn?.textContent || 'Confirmar y Canjear';
      if (submitBtn) {
        submitBtn.textContent = 'Procesando...';
        (submitBtn as HTMLButtonElement).disabled = true;
      }

      try {
        const apiUrl = (window as any).GLOBAL_API_URL || "https://sales-system-production-f30c.up.railway.app/api/v1"; 
        const response = await fetch(`${apiUrl}/fidelizacion/register?tenant_id=69cd7f0a8f3f6866d4cfbb62`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            nombre: nombreVal,
            apellido: apellidoVal,
            telefono: celularVal,
            premio_id: activeTicketTarget
          })
        });

        if (!response.ok) {
          throw new Error('Error al conectar con el servidor');
        }

        const data = await response.json();
        
        // 1. Guardar en localStorage
        localStorage.setItem('taboada_user_registered', 'true');
        localStorage.setItem('taboada_user_nombre', data.nombre || nombreVal);
        localStorage.setItem('taboada_user_apellido', apellidoVal);
        localStorage.setItem('taboada_user_celular', data.telefono || celularVal);
        localStorage.setItem('taboada_cliente_id', data.cliente_id);
        if (data.codigo_miembro) {
          localStorage.setItem('taboada_user_codigo_miembro', data.codigo_miembro);
        }

        // 2. Disparar evento de sincronización en vivo para Navbar y Banner de Bienvenida
        window.dispatchEvent(new CustomEvent('taboadaUserRegistered', {
          detail: {
            nombre: data.nombre || nombreVal,
            apellido: apellidoVal,
            celular: data.telefono || celularVal,
            cliente_id: data.cliente_id,
            ticketId: activeTicketTarget
          }
        }));

        // 3. Guardar el ID de ticket objetivo y cerrar modal
        const ticketToExecute = activeTicketTarget;
        activeTicketTarget = null;
        closeModal();
        form.reset();

        // 4. Si fue abierto desde un ticket, continuar la animación automáticamente
        if (ticketToExecute && typeof (window as any).ejecutarCanjeTicket === 'function') {
          (window as any).ejecutarCanjeTicket(ticketToExecute);
        }
      } catch (error) {
        console.error('Error de registro:', error);
        alert('Hubo un problema con el registro. Por favor, inténtalo de nuevo.');
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalBtnText;
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRegisterModal);
  } else {
    initRegisterModal();
  }
</script>
