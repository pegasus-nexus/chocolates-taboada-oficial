---
// Componente de Pop-Up Promocional "Celebra Bolivia a tu manera" (6 de Agosto)
---

<div
  id="promo-popup-overlay"
  style="display: none;"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-[9999] opacity-0 pointer-events-none transition-all duration-500 items-center justify-center p-4 sm:p-6"
>
  <div
    id="promo-popup-card"
    class="relative w-full max-w-2xl bg-[#1d0c10] border border-[#dcb041]/50 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden scale-95 transition-all duration-500 text-center flex flex-col items-center"
  >
    <!-- Botón de Cerrar (X) -->
    <button
      id="promo-popup-close-btn"
      type="button"
      class="absolute top-3 right-3 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black text-[#dcb041] hover:text-white border border-[#dcb041]/40 flex items-center justify-center transition-all duration-300 shadow-lg cursor-pointer hover:scale-110"
      aria-label="Cerrar ventana emergente"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Imagen de la Edición Especial Bolivia -->
    <div class="relative w-full overflow-hidden bg-[#180a0e]">
      <img
        id="promo-popup-img"
        data-src="/img/popup_bolivia_edicion_especial.webp"
        alt="Celebra Bolivia a tu manera - 6 de Agosto Edición Especial Chocolates Taboada"
        width="662"
        height="441"
        class="w-full h-auto object-cover max-h-[85vh] rounded-3xl"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<script>
  function initPromoPopup() {
    const overlay = document.getElementById('promo-popup-overlay');
    const card = document.getElementById('promo-popup-card');
    const closeBtn = document.getElementById('promo-popup-close-btn');

    if (!overlay || !card) return;

    function openPopup() {
      const img = document.getElementById('promo-popup-img');
      if (img && img.dataset.src && !img.src) {
        img.src = img.dataset.src;
      }
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });
    }

    function closePopup() {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      document.body.style.overflow = '';
      sessionStorage.setItem('taboada_promo_seen_v1', 'true');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 400);
    }

    // Exponer globalmente
    window.openPromoPopup = openPopup;
    window.closePromoPopup = closePopup;

    // Mostrar automáticamente tras 3.2 segundos solo si no ha sido cerrado en esta sesión
    setTimeout(() => {
      const hasSeen = sessionStorage.getItem('taboada_promo_seen_v1');
      if (!hasSeen) {
        openPopup();
      }
    }, 3200);

    if (closeBtn) closeBtn.addEventListener('click', closePopup);

    // Cerrar al hacer click en el fondo sombreado
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closePopup();
      }
    });

    // Cerrar al presionar la tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('opacity-100')) {
        closePopup();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPromoPopup);
  } else {
    initPromoPopup();
  }
</script>
