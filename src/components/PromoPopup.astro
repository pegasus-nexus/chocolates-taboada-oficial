---
// Componente de Pop-Up Promocional "Celebra Bolivia a tu manera" (6 de Agosto)
---

<div
  id="promo-popup-overlay"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-[9999] opacity-0 pointer-events-none transition-all duration-500 flex items-center justify-center p-4 sm:p-6"
>
  <div
    id="promo-popup-card"
    class="relative w-full max-w-2xl bg-[#1d0c10] border border-[#dcb041]/50 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden scale-95 transition-all duration-500 text-center flex flex-col items-center"
  >
    <!-- Botón de Cerrar (X) -->
    <button
      id="promo-popup-close-btn"
      type="button"
      class="absolute top-3 right-3 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black text-[#dcb041] hover:text-white border border-[#dcb041]/40 flex items-center justify-center transition-all duration-300 shadow-lg cursor-pointer hover:scale-110"
      aria-label="Cerrar ventana emergente"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Imagen de la Edición Especial Bolivia -->
    <div class="relative w-full overflow-hidden bg-[#180a0e]">
      <img
        src="/img/popup_bolivia_edicion_especial.jpg"
        alt="Celebra Bolivia a tu manera - 6 de Agosto Edición Especial Chocolates Taboada"
        class="w-full h-auto object-cover max-h-[70vh] sm:max-h-[75vh]"
        loading="eager"
      />
      <!-- Resplandor Dorado Inferior -->
      <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#1d0c10] to-transparent pointer-events-none"></div>
    </div>

    <!-- Barra Inferior de Acción -->
    <div class="w-full px-5 py-4 bg-[#1d0c10] flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-[#dcb041]/20">
      <div class="text-center sm:text-left">
        <span class="block text-xs uppercase tracking-[0.2em] text-[#dcb041] font-bold">Edición Limitada</span>
        <span class="block text-sm font-serif font-bold text-white">6 de Agosto • Chocolates Taboada</span>
      </div>

      <a
        id="promo-popup-cta-btn"
        href="/#cajas-especiales"
        class="w-full sm:w-auto px-6 py-3 rounded-full bg-gradient-to-r from-[#dcb041] via-[#f4c856] to-[#dcb041] text-[#2A1612] font-black text-xs uppercase tracking-wider shadow-[0_4px_20px_rgba(220,176,65,0.4)] hover:shadow-[0_6px_25px_rgba(220,176,65,0.6)] hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Ver Edición Especial</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Lógica de Aparición y Cierre del Pop-up Promocional
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('promo-popup-overlay');
    const card = document.getElementById('promo-popup-card');
    const closeBtn = document.getElementById('promo-popup-close-btn');
    const ctaBtn = document.getElementById('promo-popup-cta-btn');

    if (!overlay || !card) return;

    function openPopup() {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      document.body.style.overflow = '';
      sessionStorage.setItem('taboada_promo_popup_seen', 'true');
    }

    // Mostrar el pop-up automáticamente 500ms después de ingresar a la página
    setTimeout(() => {
      openPopup();
    }, 500);

    if (closeBtn) closeBtn.addEventListener('click', closePopup);

    if (ctaBtn) {
      ctaBtn.addEventListener('click', (e) => {
        closePopup();
        const target = document.getElementById('cajas-especiales');
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // Cerrar al hacer click en el fondo sombreado
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closePopup();
      }
    });

    // Cerrar al presionar la tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('opacity-100')) {
        closePopup();
      }
    });
  });
</script>
