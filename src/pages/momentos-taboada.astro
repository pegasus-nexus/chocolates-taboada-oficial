---
// momentos-taboada.astro - Campaña Oficial de Fidelización "Momentos Taboada"
import AppLayout from '../layouts/AppLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const premios = [
  {
    id: 'taza-negra',
    nombre: 'Taza Negra Elegante',
    categoria: 'Edición Clásica',
    imagen: '/img/premio-taza-negra.webp',
    sellos: '5 sellos',
    aporte: 'Bs 19',
    icono: '☕',
    descripcion: 'Cerámica negra de alto brillo con logotipo oficial Chocolates Taboada impreso en oro metalizado.',
    destacado: false
  },
  {
    id: 'taza-corcho',
    nombre: 'Taza de Corcho',
    categoria: 'Línea Eco-Natural',
    imagen: '/img/premio-taza-blanca-corcho.webp',
    sellos: '10 sellos',
    aporte: 'Bs 39',
    icono: '☕',
    descripcion: 'Diseño nórdico minimalista en cerámica blanca satinada, con tapa hermética de bambú y base de corcho.',
    destacado: true
  },
  {
    id: 'set-corazon',
    nombre: 'Set de Dos Tazas Corazón',
    categoria: 'Set para Dos',
    imagen: '/img/premio-duo-tazas-vino.webp',
    sellos: '20 sellos',
    aporte: 'Bs 69',
    icono: '🤍',
    descripcion: 'Juego exclusivo de dos tazas cerámicas en tono vino artesanal con el sello dorado Taboada.',
    destacado: false
  },
  {
    id: 'set-espumador',
    nombre: 'Set Taza & Batidor Espumador',
    categoria: 'Experiencia Barista',
    imagen: '/img/premio-set-batidor.webp',
    sellos: '30 sellos',
    aporte: 'Bs 99',
    icono: '☕',
    descripcion: 'Taza blanca con tapa de bambú noble más mini batidor espumador eléctrico de acero inoxidable.',
    destacado: true
  }
];

const pasos = [
  {
    numero: '1',
    titulo: 'Solicita tu cartilla',
    descripcion: 'Pídela gratis en cualquiera de nuestras sucursales participantes.',
    iconPath: 'M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z'
  },
  {
    numero: '2',
    titulo: 'Acumula sellos',
    descripcion: 'Por cada Bs 30 de compra recibirás 1 sello en tu cartilla física.',
    iconPath: 'M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z'
  },
  {
    numero: '3',
    titulo: 'Elige tu premio',
    descripcion: 'Revisa los premios disponibles y la cantidad de sellos requeridos.',
    iconPath: 'M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m0-13.5H3.75m8.25 0h8.25'
  },
  {
    numero: '4',
    titulo: 'Canjea en tienda',
    descripcion: 'Presenta tu cartilla, realiza el aporte correspondiente y llévate tu premio.',
    iconPath: 'M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009 9c.636 0 1.23-.2 1.72-.544a3 3 0 004.56 0c.49.344 1.084.544 1.72.544 1.12 0 2.1-.617 2.625-1.536M3.75 9.35V6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v2.6M3 6.75h18'
  }
];

const sucursales = [
  {
    ciudad: 'Cochabamba',
    nombre: 'Sucursal Heroínas',
    direccion: 'Av. Heroínas #121 casi Av. Ayacucho',
    horario: 'Lunes a Domingo: 08:00 a 20:00 (Continuo)',
    telefono: '62679408',
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=Chocolates+Taboada+SRL+Sucursal+Heroinas+Cochabamba'
  },
  {
    ciudad: 'Cochabamba',
    nombre: 'Sucursal Recoleta',
    direccion: 'Av. Pando esquina Av. Portales',
    horario: 'Lunes a Domingo: 08:00 a 20:00 (Continuo)',
    telefono: '62679408',
    mapsUrl: 'https://www.google.com/maps/place/Chocolates+Taboada+SRL+-+Sucursal+Recoleta/@-17.3785545,-66.1548723,17z'
  },
  {
    ciudad: 'La Paz',
    nombre: 'Sucursal Calacoto',
    direccion: 'Av. 21 de Calacoto 8401, La Paz',
    horario: 'Lunes a Domingo: 08:00 a 20:00 (Continuo)',
    telefono: '62679408',
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=Chocolates+Taboada+Calacoto+La+Paz'
  }
];
---

<AppLayout title="Momentos Taboada · Colecciona sellos y canjea premios exclusivos">
  <Navbar isDarkSolid={true} />

  <main class="min-h-screen bg-[#FAF4EC] text-[#2A1612] pt-[72px] md:pt-[92px] overflow-x-hidden">
    
    <!-- ═══════════════════════════════════════════════════════════
         PORTADA OFICIAL: MOMENTOS TABOADA (COMPLETA DE FONDO A ANCHO COMPLETO)
    ═══════════════════════════════════════════════════════════ -->
    <section class="relative w-full overflow-hidden bg-[#FAF4EC]">
      <div class="w-full relative shadow-[0_12px_35px_rgba(74,21,33,0.12)]">
        <img
          src="/img/portada-momentos-taboada.webp"
          alt="Campaña de Fidelización 2026 - Momentos Taboada"
          width="2560"
          height="885"
          class="w-full h-auto object-cover min-h-[170px] sm:min-h-0 block select-none"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECCIÓN: ¿CÓMO FUNCIONA?
    ═══════════════════════════════════════════════════════════ -->
    <section class="py-10 sm:py-14 bg-[#FAF4EC] text-[#2A1612] relative">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center">
        
        <!-- Categoría Superior Centrada -->
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="w-6 sm:w-8 h-[1.5px] bg-[#4A1521]/60"></span>
          <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#4A1521] font-extrabold font-sans">
            ¿CÓMO FUNCIONA?
          </span>
          <span class="w-6 sm:w-8 h-[1.5px] bg-[#4A1521]/60"></span>
        </div>

        <!-- Título Principal -->
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#2A1612] tracking-tight mb-2">
          Colecciona, acumula y canjea
        </h2>
        <p class="text-xs sm:text-sm text-[#5D4037]/85 font-sans mb-10 sm:mb-12">
          Participar es muy fácil. Solo sigue estos pasos:
        </p>

        <!-- Grilla de 4 Pasos con Flechas de Flujo -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 items-stretch relative">
          
          {pasos.map((p, idx) => (
            <div class="relative bg-white/95 rounded-2xl p-5 sm:p-6 border border-[#e8dccb] shadow-[0_4px_18px_rgba(74,21,33,0.06)] hover:shadow-[0_8px_25px_rgba(74,21,33,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group">
              
              <!-- Ícono Circular con Insignia de Número -->
              <div class="relative mb-3.5">
                <div class="w-14 h-14 rounded-full bg-[#4A1521] text-[#FAF5F0] flex items-center justify-center shadow-md group-hover:scale-110 group-hover:bg-[#5D1425] transition-all duration-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={p.iconPath} />
                  </svg>
                </div>
                <!-- Badge de número -->
                <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-5 h-5 rounded-full bg-[#2A1612] border border-[#dcb041] text-[#f6d98d] font-bold text-[10px] flex items-center justify-center shadow-sm">
                  {p.numero}
                </span>
              </div>

              <!-- Título del Paso -->
              <h3 class="font-serif text-base font-bold text-[#2A1612] mb-1.5 leading-snug">
                {p.titulo}
              </h3>

              <!-- Descripción -->
              <p class="text-xs text-[#5D4037]/90 leading-relaxed font-sans">
                {p.descripcion}
              </p>

              <!-- Flecha de separación en pantallas grandes -->
              {idx < pasos.length - 1 && (
                <div class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 z-20 w-6 h-6 rounded-full bg-[#FAF4EC] text-[#4A1521]/40 items-center justify-center text-xs font-black pointer-events-none">
                  ❯
                </div>
              )}

            </div>
          ))}

        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECCIÓN: PREMIOS DE LA CAMPAÑA
    ═══════════════════════════════════════════════════════════ -->
    <section class="py-14 sm:py-20 text-[#FAF5F0] relative overflow-hidden bg-[#3D0A11]">
      
      <!-- Fondo artístico de la sección: ondulaciones doradas y tonos cacao vino -->
      <div
        class="absolute inset-0 bg-cover bg-center pointer-events-none"
        style="background-image: url('/img/fondo-premios-momentos.webp');"
      >
      </div>

      <!-- Sutil capa de iluminación ambiental -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#3D0A11]/25 via-transparent to-[#3D0A11]/35 pointer-events-none"></div>

      <!-- Sutil brillo y polvo de cacao decorativo -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-[#dcb041]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center">
        
        <!-- Encabezado con hojas de cacao doradas -->
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-[#dcb041] text-lg">🍃</span>
          <h2 class="font-serif italic font-bold text-2xl sm:text-3xl md:text-4xl text-white tracking-tight drop-shadow-sm">
            Premios de la campaña
          </h2>
          <span class="text-[#dcb041] text-lg">🍃</span>
        </div>

        <p class="text-xs sm:text-sm text-[#FAF5EE]/75 font-sans mb-10 sm:mb-12 max-w-lg mx-auto">
          Canjea tus sellos por nuestras tazas y sets exclusivos.
        </p>

        <!-- Grilla de 4 Premios en 1 Sola Fila (Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 items-stretch">
          
          {premios.map((p) => (
            <div class="rounded-2xl bg-gradient-to-b from-white/[0.08] via-white/[0.03] to-black/40 border border-[#dcb041]/35 p-5 sm:p-6 flex flex-col items-center justify-between text-center backdrop-blur-xs hover:border-[#dcb041] hover:scale-[1.02] transition-all duration-300 shadow-[0_12px_35px_rgba(0,0,0,0.5)] group">
              
              <!-- Imagen del producto con resplandor ambiental suave -->
              <div class="relative w-full h-44 sm:h-48 flex items-center justify-center mb-3">
                <div class="absolute inset-0 bg-radial from-[#dcb041]/15 to-transparent rounded-full blur-xl pointer-events-none"></div>
                <img
                  src={p.imagen}
                  alt={p.nombre}
                  width="800"
                  height="800"
                  class="max-h-40 sm:max-h-44 w-auto object-contain relative z-10 drop-shadow-[0_12px_24px_rgba(0,0,0,0.7)] group-hover:scale-108 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <!-- Título del Premio -->
              <h3 class="font-serif text-base sm:text-lg font-bold text-white mb-4 group-hover:text-[#f6d98d] transition-colors leading-snug">
                {p.nombre}
              </h3>

              <!-- Píldora de Requisitos: Sellos + Aporte -->
              <div class="w-full mt-auto py-2 px-3 rounded-full bg-[#140705]/95 border border-[#dcb041]/45 text-[#f6d98d] text-xs font-black tracking-wide flex items-center justify-center gap-1.5 shadow-inner">
                <span class="text-sm">{p.icono}</span>
                <span>{p.sellos} + {p.aporte}</span>
              </div>

            </div>
          ))}

        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECCIÓN DUAL: "TU CARTILLA FÍSICA" & "SUCURSALES PARTICIPANTES"
    ═══════════════════════════════════════════════════════════ -->
    <section class="py-12 sm:py-16 bg-[#FAF4EC] text-[#2A1612]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 items-stretch">
          
          <!-- TARJETA IZQUIERDA: TU CARTILLA FÍSICA -->
          <div class="bg-white rounded-3xl border border-[#dcb041]/35 shadow-[0_8px_30px_rgba(74,21,33,0.08)] p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
            <!-- Imagen / Vista Previa de la Cartilla -->
            <div class="w-40 sm:w-44 flex-shrink-0">
              <img
                src="/img/cartilla-fisica-preview.webp"
                alt="Cartilla Física Oficial Chocolates Taboada"
                width="185"
                height="125"
                class="w-full h-auto object-contain rounded-xl shadow-md border border-[#dcb041]/40"
                loading="lazy"
              />
            </div>

            <!-- Lista de Beneficios / Características de la Cartilla -->
            <div class="flex-1 text-left">
              <h3 class="font-serif text-xl font-bold text-[#2A1612] mb-3">
                Tu cartilla física
              </h3>
              
              <ul class="space-y-2 text-xs sm:text-sm text-[#5D4037]">
                <li class="flex items-center gap-2">
                  <span class="text-[#dcb041] font-bold text-sm">✓</span>
                  <span class="font-medium">Exclusiva de la campaña</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[#dcb041] font-bold text-sm">✓</span>
                  <span class="font-medium">Válida en sucursales participantes</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[#dcb041] font-bold text-sm">✓</span>
                  <span class="font-medium">Sellos por tus compras</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-[#dcb041] font-bold text-sm">✓</span>
                  <span class="font-medium">Canjea cuando tú decidas</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- TARJETA DERECHA: SUCURSALES PARTICIPANTES -->
          <div class="bg-gradient-to-br from-[#4A1521] via-[#351018] to-[#250A10] rounded-3xl border border-[#dcb041]/50 shadow-[0_10px_35px_rgba(74,21,33,0.35)] p-6 sm:p-8 text-[#FAF5F0] flex flex-col justify-between relative overflow-hidden group">
            
            <!-- Silueta de tienda en marca de agua decorativa -->
            <div class="absolute right-4 bottom-2 text-white/5 pointer-events-none group-hover:scale-105 transition-transform duration-700">
              <svg class="w-36 h-36" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3L2 9l2 1v10h16V10l2-1-10-6zm6 15H6v-6h12v6zm0-8H6l-2-.8L12 5.5l8 3.7-2 .8z"/>
              </svg>
            </div>

            <div class="relative z-10">
              <div class="flex items-center gap-2.5 mb-2.5">
                <div class="w-8 h-8 rounded-full bg-[#dcb041]/20 border border-[#dcb041]/50 flex items-center justify-center text-[#dcb041]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-white">
                  Sucursales participantes
                </h3>
              </div>

              <p class="text-xs sm:text-sm text-[#FAF5EE]/85 max-w-sm mb-6 leading-relaxed">
                Disponible en nuestras tiendas oficiales de Cochabamba y La Paz.
              </p>
            </div>

            <div class="relative z-10 pt-2">
              <a
                href="#sucursales-detalle"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-gradient-to-r from-[#f6d98d] via-[#dcb041] to-[#c99a2e] text-[#2A1612] font-black text-xs uppercase tracking-wider shadow-[0_4px_15px_rgba(220,176,65,0.4)] hover:shadow-[0_6px_20px_rgba(220,176,65,0.6)] hover:scale-105 active:scale-95 transition-all"
              >
                <span>Ver sucursales</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECCIÓN: LISTA DETALLADA DE SUCURSALES (ANCLAJE)
    ═══════════════════════════════════════════════════════════ -->
    <section id="sucursales-detalle" class="py-12 sm:py-16 bg-[#F5EEE4] text-[#2A1612] border-t border-[#e8dccb]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <div class="text-center max-w-xl mx-auto mb-10">
          <h3 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#2A1612]">
            Nuestras Sucursales Habilitadas
          </h3>
          <p class="text-xs sm:text-sm text-[#5D4037]/80 mt-1.5">
            Pide tu cartilla y canjea tus premios en cualquiera de estos puntos oficiales:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {sucursales.map(s => (
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-[#dcb041]/30 shadow-md flex flex-col justify-between hover:shadow-lg transition-all">
              <div>
                <div class="flex items-center justify-between mb-2.5">
                  <span class="px-2.5 py-0.5 rounded-full bg-[#FAF5EE] text-[#4A1521] font-black text-[10px] uppercase tracking-wider border border-[#4A1521]/20">
                    {s.ciudad}
                  </span>
                  <span class="text-xs text-[#25D366] font-bold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
                    Atención Continua
                  </span>
                </div>

                <h4 class="font-serif text-lg font-bold text-[#2A1612] mb-2">{s.nombre}</h4>

                <div class="space-y-2 text-xs text-[#5D4037] mb-5">
                  <div class="flex items-start gap-2">
                    <span class="text-[#dcb041] mt-0.5">📍</span>
                    <span>{s.direccion}</span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#dcb041] mt-0.5">⏰</span>
                    <span>{s.horario}</span>
                  </div>
                </div>
              </div>

              <a
                href={s.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-xl bg-[#2A1612] hover:bg-[#4A1521] text-[#FAF5F0] font-bold text-xs transition-colors"
              >
                <span>Ver en Google Maps</span>
                <svg class="w-3 h-3 text-[#dcb041]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
              </a>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECCIÓN: PREGUNTAS FRECUENTES (ACCORDION)
    ═══════════════════════════════════════════════════════════ -->
    <section class="py-12 sm:py-16 bg-[#FAF4EC] text-[#2A1612] border-t border-[#e8dccb]">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        
        <!-- Categoría Superior Centrada -->
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="w-6 sm:w-8 h-[1.5px] bg-[#4A1521]/60"></span>
          <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#4A1521] font-extrabold font-sans">
            PREGUNTAS FRECUENTES
          </span>
          <span class="w-6 sm:w-8 h-[1.5px] bg-[#4A1521]/60"></span>
        </div>

        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-center text-[#2A1612] mb-8">
          Todo lo que necesitas saber
        </h2>

        <div class="space-y-3.5">
          
