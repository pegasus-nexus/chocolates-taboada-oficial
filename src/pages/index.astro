  <script>
    // Selectores de Categorías
    // El manejo de productos y el catálogo se encarga el componente Products.astro

    // Selectores de Ubicación
    const bgOverlay = document.getElementById("cajas-especiales-bg");
    const heroBgCover = document.getElementById("hero-bg-cover");

    // Selectores de Ver Más
    const seeMoreContainer = null;
    const seeMoreBtn = null;

    // Estados actuales
    let currentCategory = "todo";
    let currentCity = "cochabamba"; // Valor inicial / fallback
    let isExpanded = false; // Estado del botón Ver Más

    // â”€â”€ MENÃš MÃ“VIL (DRAWER) â”€â”€
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileCloseBtn = document.getElementById("mobile-close-btn");
    const mobileDrawer = document.getElementById("mobile-drawer");
    const drawerOverlay = document.getElementById("drawer-overlay");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    function openDrawer() {
      mobileDrawer?.classList.remove("translate-x-full");
      drawerOverlay?.classList.remove("opacity-0", "pointer-events-none");
    }

    function closeDrawer() {
      mobileDrawer?.classList.add("translate-x-full");
      drawerOverlay?.classList.add("opacity-0", "pointer-events-none");
    }

    mobileMenuBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openDrawer();
    });

    mobileCloseBtn?.addEventListener("click", closeDrawer);
    drawerOverlay?.addEventListener("click", closeDrawer);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    // â”€â”€ ACTUALIZAR CIUDAD SELECCIONADA â”€â”€
    function updateCity(city: string) {
      currentCity = city;
      localStorage.setItem("taboada_selected_city", city); // Changed to match Navbar

      // Inyectar clase al document.body (Para manejo CSS global si es necesario)
      document.body.classList.remove(
        "city-cochabamba",
        "city-lapaz",
        "city-la-paz",
      );
      document.body.classList.add(`city-${city}`);

      // Actualizar la portada del Hero con una transición (Fade Out / Fade In)
      if (heroBgCover) {
        const bgCbba =
          heroBgCover.getAttribute("data-bg-cochabamba") ||
          "/img/agostocbba.webp";
        const bgLpz =
          heroBgCover.getAttribute("data-bg-lapaz") || "/img/agostolp.webp";

        // Transición ultra suave de opacidad (fade-out / fade-in) y transform con curva cubic-bezier premium
        heroBgCover.style.transition =
          "opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)";
        heroBgCover.style.opacity = "0"; // Disparar fade-out

        setTimeout(() => {
          if (city === "la-paz" || city === "lapaz") {
            heroBgCover.style.backgroundImage = `url('${bgLpz}')`;
          } else {
            heroBgCover.style.backgroundImage = `url('${bgCbba}')`;
          }
          heroBgCover.style.opacity = "1"; // Disparar fade-in tras aplicar nueva imagen
        }, 500); // Sincronizado con los 500ms del desvanecimiento cubic-bezier
      }

      const mobileHeroImg = document.getElementById("mobile-hero-img") as HTMLImageElement;
      if (mobileHeroImg) {
        mobileHeroImg.src = (city === "la-paz" || city === "lapaz") ? "/img/agostolp.webp" : "/img/agostocbba.webp";
      }

      // Actualizar el degradado de fondo de Colecciones
      if (bgOverlay) {
        // Remover clases viejas de gradientes
        bgOverlay.classList.remove(
          "from-[#FAF5F0]",
          "via-[#F3ECE3]",
          "to-[#FAF5F0]",
          "from-[#FAF6F2]",
          "via-[#EADCD0]",
          "to-[#FAF6F2]",
          "from-[#FAF7F5]",
          "via-[#E2DFD8]",
          "to-[#FAF7F5]",
        );

        // Añadir clases nuevas basadas en la ciudad y aplicar transición
        bgOverlay.style.transition = "all 0.6s ease-in-out";
        if (city === "cochabamba") {
          bgOverlay.classList.add(
            "from-[#FAF6F2]",
            "via-[#EADCD0]",
            "to-[#FAF6F2]",
          );
        } else if (city === "la-paz") {
          bgOverlay.classList.add(
            "from-[#FAF7F5]",
            "via-[#E2DFD8]",
            "to-[#FAF7F5]",
          );
        }
      }

      // Refrescar el filtrado de productos y los precios
      // filterProducts();
    }

    // â”€â”€ MANTENER SINCRONIZADA LA IMAGEN HERO SEGÃšN LA CIUDAD â”€â”€

    // Escuchar cambios de ciudad desde Navbar
    window.addEventListener("cityChanged", (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.city) {
        updateCity(detail.city);
      }
    });

    // â”€â”€ LÃ“GICA DE COLAPSAR/GUARDAR BARRA LATERAL DE CATEGORÍAS â”€â”€
    const catSidebar = document.getElementById("cat-sidebar");
    const toggleSidebarBtn = document.getElementById("toggle-cat-sidebar-btn");
    const arrowIcon = document.getElementById("cat-sidebar-arrow-icon");
    const headerTitle = document.getElementById("cat-sidebar-header-title");
    const productGridColumn = document.getElementById("product-grid-column");

    toggleSidebarBtn?.addEventListener("click", () => {
      const isCollapsed = catSidebar?.classList.contains(
        "is-collapsed-sidebar",
      );

      if (isCollapsed) {
        // EXPANDIR
        catSidebar?.classList.remove("is-collapsed-sidebar");
        catSidebar?.classList.remove("lg:col-span-1", "lg:w-[70px]");
        catSidebar?.classList.add("lg:col-span-2", "w-full");

        productGridColumn?.classList.remove("lg:col-span-11");
        productGridColumn?.classList.add("lg:col-span-10");

        if (arrowIcon) arrowIcon.style.transform = "rotate(0deg)";
        if (headerTitle) headerTitle.style.display = "";

        document
          .querySelectorAll(".cat-btn-label")
          .forEach((el) => ((el as HTMLElement).style.display = ""));
        document.querySelectorAll(".cat-btn").forEach((btn) => {
          btn.classList.remove("justify-center");
          btn.classList.add("gap-2.5");
        });
      } else {
        // COLAPSAR / GUARDAR (MODO SOLO ÍCONOS)
        catSidebar?.classList.add("is-collapsed-sidebar");
        catSidebar?.classList.remove("lg:col-span-2", "w-full");
        catSidebar?.classList.add("lg:col-span-1", "lg:w-[70px]");

        productGridColumn?.classList.remove("lg:col-span-10");
        productGridColumn?.classList.add("lg:col-span-11");

        if (arrowIcon) arrowIcon.style.transform = "rotate(180deg)";
        if (headerTitle) headerTitle.style.display = "none";

        document
          .querySelectorAll(".cat-btn-label")
          .forEach((el) => ((el as HTMLElement).style.display = "none"));
        document.querySelectorAll(".cat-btn").forEach((btn) => {
          btn.classList.add("justify-center");
          btn.classList.remove("gap-2.5");
        });
      }
    });

    // â”€â”€ ANÁLISIS SILENCIOSO Y ULTRA-PRECISO DE DEPARTAMENTO (HTTPS + FALLBACK SIN CORS) â”€â”€
    async function detectDepartmentSilently() {
      try {
        let data = null;
        try {
          const res = await fetch("https://freeipapi.com/api/json").catch(() => null);
          if (res && res.ok) data = await res.json();
        } catch (e) {}

        if (data) {
          const regionStr = (
            (data.cityName || "") +
            " " +
            (data.regionName || "") +
            " " +
            (data.regionCode || "")
          ).toLowerCase();

          // Si la región es explícitamente La Paz / El Alto / Murillo / Código 'L'
          if (
            (regionStr.includes("paz") ||
              regionStr.includes("alto") ||
              regionStr.includes("murillo") ||
              data.regionCode === "L") &&
            data.regionCode !== "C" &&
            !regionStr.includes("cochabamba")
          ) {
            updateCity("la-paz");
            return;
          }

          // Si es Cochabamba (Código 'C' o nombre Cochabamba / Quillacollo / Sacaba)
          if (data.regionCode === "C" || regionStr.includes("cochabamba") || regionStr.includes("cbba")) {
            updateCity("cochabamba");
            return;
          }
        }
      } catch (err) {
        // Fallback silencioso a Cochabamba
      }
      // Por defecto siempre Cochabamba (Sede Principal)
      updateCity("cochabamba");
    }

    // Inicializar primero con valor almacenado o Cochabamba por defecto
    const savedCity = (localStorage.getItem("taboada_selected_city") || "cochabamba").toLowerCase();
    const initialCity = (savedCity === "la-paz" || savedCity === "lapaz") ? "la-paz" : "cochabamba";
    updateCity(initialCity);

    // Analizar departamento en segundo plano 100% transparente sin pedir permisos
    detectDepartmentSilently();

    // â”€â”€ DETECTAR Y FILTRAR POR PARÁMETROS URL (?cat=...) â”€â”€
    function checkUrlParams() {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get("cat");
      if (catParam) {
        const targetBtn = document.querySelector(
          `.cat-btn[data-target="${catParam}"]`,
        ) as HTMLButtonElement;
        if (targetBtn) {
          setTimeout(() => {
            targetBtn.click();
            const targetSection = document.getElementById("cajas-especiales");
            if (targetSection) {
              targetSection.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          }, 300);
        }
      }
    }

    checkUrlParams();

    // Interceptar clicks en enlaces del menu dropdown cuando estamos en el home
    const dropdownLinks = document.querySelectorAll('a[href*="?cat="]');
    dropdownLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const hrefAttr = link.getAttribute("href") || "";
        const isHomePage =
          window.location.pathname === "/" ||
          window.location.pathname === "/index.html" ||
          window.location.pathname === "";
        if (isHomePage) {
          const url = new URL(hrefAttr, window.location.href);
          const cat = url.searchParams.get("cat");
          if (cat) {
            const targetBtn = document.querySelector(
              `.cat-btn[data-target="${cat}"]`,
            ) as HTMLButtonElement;
            if (targetBtn) {
              e.preventDefault();
              targetBtn.click();
              const targetSection = document.getElementById("cajas-especiales");
              if (targetSection) {
                targetSection.scrollIntoView({
                  behavior: "smooth",
                  block: "start",
                });
              }
              // Limpiar la query de la URL sin recargar
              window.history.pushState({}, "", window.location.pathname);
            }
          }
        }
      });
    });

    // â”€â”€ GESTIÃ“N DEL MODAL DE CANTIDAD Y BOTONES DE COMPRA â”€â”€
    const qtyModal = document.getElementById("quantity-modal");
    const qtyModalOverlay = document.getElementById("quantity-modal-overlay");
    const qtyModalClose = document.getElementById("quantity-modal-close");
    const modalProdName = document.getElementById("modal-product-name");
    const modalProdSize = document.getElementById("modal-product-size");
    const modalProdImg = document.getElementById(
      "modal-product-img",
    ) as HTMLImageElement;
    const modalQtyVal = document.getElementById("modal-qty-val");
    const modalQtyMinus = document.getElementById("modal-qty-minus");
    const modalQtyPlus = document.getElementById("modal-qty-plus");
    const modalAddBtn = document.getElementById("modal-add-btn");
    const floatingCartBtn = document.getElementById("floating-cart-btn");

    let modalActiveProduct = {
      id: "",
      name: "",
      size: "",
      img: "",
      price: 0,
      quantity: 1,
    };

    function parsePrice(priceStr: string): number {
      const cleanStr = priceStr
        .replace(/BS\./i, "")
        .replace(/Bs\./i, "")
        .replace(/BS/i, "")
        .replace(/Bs/i, "");
      return parseFloat(cleanStr.replace(/[^\d.]/g, "")) || 0;
    }

    const modalProdDesc = document.getElementById("modal-product-desc");

    function updateQtyModalUI() {
      if (modalQtyVal)
        modalQtyVal.textContent = modalActiveProduct.quantity.toString();
      const subtotal = modalActiveProduct.price * modalActiveProduct.quantity;
      const modalTotalPrice = document.getElementById("modal-total-price");
      if (modalTotalPrice)
        modalTotalPrice.textContent = `Bs. ${subtotal.toFixed(2)}`;
      const modalAddBtnText = document.getElementById("modal-add-btn-text");
      if (modalAddBtnText)
        modalAddBtnText.textContent = `Agregar al Carrito â€¢ Bs. ${subtotal.toFixed(2)}`;
    }

    function openQtyModal(
      id: string,
      name: string,
      size: string,
      img: string,
      price: number,
      desc: string = "",
    ) {
      modalActiveProduct = { id, name, size, img, price, quantity: 1 };

      if (modalProdName) modalProdName.textContent = name;
      if (modalProdSize) modalProdSize.textContent = size;
      if (modalProdImg) modalProdImg.src = img;
      if (modalProdDesc) {
        if (desc && desc.trim() !== "") {
          modalProdDesc.textContent = desc;
          modalProdDesc.classList.remove("hidden");
        } else {
          modalProdDesc.textContent = "";
          modalProdDesc.classList.add("hidden");
        }
      }

      updateQtyModalUI();

      qtyModalOverlay?.classList.remove("hidden");
      qtyModal?.classList.remove("hidden");

      setTimeout(() => {
        qtyModal?.classList.remove("scale-95", "opacity-0");
        qtyModal?.classList.add("scale-100", "opacity-100");
      }, 10);
    }

    function closeQtyModal() {
      qtyModal?.classList.remove("scale-100", "opacity-100");
      qtyModal?.classList.add("scale-95", "opacity-0");

      setTimeout(() => {
        qtyModal?.classList.add("hidden");
        qtyModalOverlay?.classList.add("hidden");
      }, 300);
    }

    qtyModalClose?.addEventListener("click", closeQtyModal);
    qtyModalOverlay?.addEventListener("click", closeQtyModal);

    modalQtyMinus?.addEventListener("click", () => {
      if (modalActiveProduct.quantity > 1) {
        modalActiveProduct.quantity -= 1;
        updateQtyModalUI();
      }
    });

    modalQtyPlus?.addEventListener("click", () => {
      modalActiveProduct.quantity += 1;
      updateQtyModalUI();
    });

    modalAddBtn?.addEventListener("click", () => {
      if (typeof (window as any).addToCart === "function") {
        (window as any).addToCart({
          id:
            modalActiveProduct.id ||
            modalActiveProduct.name.toLowerCase().replace(/\s+/g, "-"),
          name: modalActiveProduct.name,
          size: modalActiveProduct.size,
          img: modalActiveProduct.img,
          price: modalActiveProduct.price,
          quantity: modalActiveProduct.quantity,
        });
      }
      closeQtyModal();
    });

    // Enlaces de botones y tarjetas para agregar al carrito (Delegado dinámicamente al hacer clic en la tarjeta o botón)
    document.addEventListener("click", (e) => {
      const clickedEl = e.target as HTMLElement;

      // Si hace clic en el botón direct-buy-btn ("Comprar" vía WhatsApp directo), ignorar apertura de modal
      if (clickedEl.closest(".direct-buy-btn")) return;

      const target = clickedEl.closest(
        ".product-card, .add-to-cart-btn",
      ) as HTMLElement | null;
      if (!target) return;

      e.preventDefault();
      const name = target.getAttribute("data-name") || "Chocolate Taboada";
      const size = target.getAttribute("data-size") || "Edición Especial";
      const img = target.getAttribute("data-img") || "/img/produc1.png";
      const desc =
        target.getAttribute("data-desc") ||
        "Elaborado artesanalmente con 100% cacao fino de aroma sucrense y la más alta tradición chocolatera de Bolivia.";

      const selectedCity = (
        localStorage.getItem("taboada_selected_city") || "cochabamba"
      ).toLowerCase();
      const priceKey =
        selectedCity === "la-paz" || selectedCity === "lapaz"
          ? "data-price-lapaz"
          : "data-price-cochabamba";
      const priceStr =
        target.getAttribute(priceKey) ||
        target.getAttribute("data-price") ||
        target.getAttribute("data-price-cochabamba") ||
        "75";
      const price = parsePrice(priceStr);

      const id =
        target.getAttribute("data-id") ||
        name.toLowerCase().replace(/\s+/g, "-");

      openQtyModal(id, name, size, img, price, desc);
    });

    // Compra directa WhatsApp de un solo producto
    const directBuyButtons = document.querySelectorAll(".direct-buy-btn");
    directBuyButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const name = target.getAttribute("data-name") || "";
        const size = target.getAttribute("data-size") || "";

        const priceKey =
          currentCity === "cochabamba"
            ? "data-price-cochabamba"
            : "data-price-lapaz";
        const priceStr =
          target.getAttribute(priceKey) ||
          target.getAttribute("data-price-cochabamba") ||
          "";
        const priceVal = parsePrice(priceStr);

        const cityLabel =
          currentCity === "cochabamba" ? "Cochabamba" : "La Paz";

        let message = `¡Hola! Quisiera comprar el siguiente producto de Chocolates Taboada:\n\n`;
        message += `Ciudad de entrega: ${cityLabel}\n`;
        message += `------------------------------------------\n`;
        message += `â€¢ 1 x ${name} (${size})\n`;
        message += `  Precio unitario: BS. ${priceVal.toFixed(1)}\n`;
        message += `  Subtotal: BS. ${priceVal.toFixed(1)}\n`;
        message += `------------------------------------------\n`;
        message += `Total a pagar: BS. ${priceVal.toFixed(1)}\n\n`;
        message += `¡Muchas gracias!`;

        const waNumber = "59162679408";
        const encodedMsg = encodeURIComponent(message);
        const waLink = `https://wa.me/${waNumber}?text=${encodedMsg}`;

        window.open(waLink, "_blank");
      });
    });

    floatingCartBtn?.addEventListener("click", () => {
      if (typeof (window as any).openCartDrawer === "function") {
        (window as any).openCartDrawer();
      }
    });

    // â”€â”€ CAMBIO DE COLOR DEL NAVBAR AL HACER SCROLL â”€â”€
    const navbar = document.getElementById("main-navbar");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        navbar?.classList.add(
          "bg-[#2A1612]/95",
          "backdrop-blur-[14px]",
          "border-b",
          "border-white/10",
          "shadow-lg",
        );
        navbar?.classList.remove(
          "bg-transparent",
          "border-transparent",
          "hover:bg-white/10",
        );
      } else {
        navbar?.classList.remove(
          "bg-[#2A1612]/95",
          "backdrop-blur-[14px]",
          "border-b",
          "border-white/10",
          "shadow-lg",
        );
        navbar?.classList.add(
          "bg-transparent",
          "border-transparent",
          "hover:bg-white/10",
        );
      }
    });
  </script>

