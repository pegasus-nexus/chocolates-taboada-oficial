      >
      </p>

      <!-- Selector de cantidad pill -->
      <div class="flex items-center justify-center gap-5 my-3">
        <button
          id="modal-qty-minus"
          type="button"
          class="w-11 h-11 rounded-full border border-[#2A1612]/20 flex items-center justify-center font-black text-xl text-[#2A1612] bg-white hover:bg-[#2A1612] hover:text-[#dcb041] active:scale-95 transition-all shadow-sm cursor-pointer"
        >
          -
        </button>
        <span
          id="modal-qty-val"
          class="w-12 text-center text-2xl font-black text-[#2A1612] font-serif"
          >1</span
        >
        <button
          id="modal-qty-plus"
          type="button"
          class="w-11 h-11 rounded-full border border-[#2A1612]/20 flex items-center justify-center font-black text-xl text-[#2A1612] bg-white hover:bg-[#2A1612] hover:text-[#dcb041] active:scale-95 transition-all shadow-sm cursor-pointer"
        >
          +
        </button>
      </div>

      <!-- Subtotal Precio -->
      <div class="text-center mt-2 mb-4">
        <span
          class="text-xs text-[#8f6c49] font-medium uppercase tracking-wider block"
          >Total Estimado</span
        >
        <span
          id="modal-total-price"
          class="text-2xl font-serif font-black text-[#2A1612]">Bs. 0.00</span
        >
      </div>

      <!-- Botón de agregar -->
      <button
        id="modal-add-btn"
        type="button"
        class="w-full py-4 rounded-full bg-gradient-to-r from-[#dcb041] via-[#f4c856] to-[#dcb041] text-[#2A1612] font-black text-sm uppercase tracking-wide shadow-lg hover:shadow-[0_6px_25px_rgba(220,176,65,0.5)] hover:scale-[1.02] active:scale-95 transition-all duration-300 cursor-pointer flex items-center justify-center gap-2"
      >
        <span id="modal-add-btn-text">Agregar al Carrito</span>
      </button>
    </div>
  </div>
  <CallToAction />
  <Testimonials />
  <Footer />
  <MobileCTA />
</Layout>


