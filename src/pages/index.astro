---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CallToAction from "../components/CallToAction.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
import Products from "../components/Products.astro";
import MobileCTA from "../components/MobileCTA.astro";
---

<Layout
  title="El sabor de la tradición | Chocolates Taboada"
  description="Descubre Chocolates Taboada, la primera industria chocolatera de Bolivia desde 1948. Tradición, elegancia y un sabor inolvidable."
>
  <Navbar />

  <header
    id="inicio"
    class="relative min-h-screen overflow-hidden bg-[#14080d]"
  >    <div
      id="hero-bg-cover"
      class="absolute inset-0 bg-no-repeat
           bg-cover bg-[position:80%_top] sm:bg-[position:80%_center] scale-100
           lg:bg-center lg:scale-105 transition-all duration-700"
      data-bg-cochabamba="/img/agostocbba.webp"
      data-bg-lapaz="/img/agostolp.webp"
      style="background-image:url('/img/agostocbba.webp')"
    >
    </div>

    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(10,5,7,0.72)_0%,rgba(20,10,15,0.55)_50%,rgba(14,8,13,0.88)_100%)] lg:bg-[linear-gradient(to_right,rgba(10,5,7,0.96)_0%,rgba(20,10,15,0.92)_20%,rgba(38,18,25,0.82)_42%,rgba(62,28,40,0.58)_68%,rgba(120,70,85,0.18)_88%,rgba(255,255,255,0)_100%)]"
    >
    </div>

    <!-- BRILLO PREMIUM -->

    <div
      class="absolute top-[-180px] left-[-120px] w-[500px] h-[500px] rounded-full bg-[#f6d98d]/10 blur-[120px]"
    >
    </div>

    <!-- PARTICULAS -->

    <div class="absolute inset-0 overflow-hidden z-[2]">
      <!-- LUCES -->

      <svg
        class="chocolate-fall absolute left-[5%] w-4 opacity-70"
        style="animation-duration:12s; animation-delay:0s;"
        viewBox="0 0 30 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M15,5 L17,12 L24,15 L17,18 L15,25 L13,18 L6,15 L13,12 Z"
          fill="#D4AF37"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[12%] w-6 opacity-80"
        style="animation-duration:14s; animation-delay:0s;"
        viewBox="0 0 40 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path d="M20,10 C32,20 32,40 20,50 C8,40 8,20 20,10 Z" fill="#3D1C06"
        ></path><path
          d="M20,15 C24,22 24,38 20,45"
          stroke="#D4AF37"
          stroke-width="1.5"
          stroke-linecap="round"
          opacity="0.6"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[22%] w-5 opacity-60"
        style="animation-duration:9s; animation-delay:1s;"
        viewBox="0 0 30 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M15,5 L17,12 L24,15 L17,18 L15,25 L13,18 L6,15 L13,12 Z"
          fill="#2A1612"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[33%] w-5 opacity-65"
        style="animation-duration:13s; animation-delay:6s;"
        viewBox="0 0 40 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path d="M20,15 C28,23 28,37 20,45 C12,37 12,23 20,15 Z" fill="#42200D"
        ></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[45%] w-8 opacity-80"
        style="animation-duration:11s; animation-delay:3s;"
        viewBox="0 0 40 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path d="M20,12 C30,22 30,38 20,48 C10,38 10,22 20,12 Z" fill="#5C3821"
        ></path><path
          d="M20,17 C23,24 23,36 20,43"
          stroke="#F6D98D"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity="0.5"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[53%] w-4 opacity-60"
        style="animation-duration:12s; animation-delay:5s;"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><polygon points="10,3 17,7 15,15 7,17 3,10" fill="#2E160A"
        ></polygon></svg
      >
      <svg
        class="chocolate-fall absolute left-[62%] w-4 opacity-75"
        style="animation-duration:8s; animation-delay:4s;"
        viewBox="0 0 30 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M15,7 L17,12 L22,15 L17,18 L15,23 L13,18 L8,15 L13,12 Z"
          fill="#D4AF37"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[70%] w-3 opacity-80"
        style="animation-duration:7s; animation-delay:0.5s;"
        viewBox="0 0 10 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><circle cx="5" cy="5" r="4" fill="#D4AF37"></circle></svg
      >
      <svg
        class="chocolate-fall absolute left-[78%] w-6 opacity-70"
        style="animation-duration:16s; animation-delay:1.5s;"
        viewBox="0 0 40 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M20,10 C32,20 32,40 20,50 C8,40 8,20 20,10 Z"
          fill="url(#goldGrad)"></path><defs
          ><linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%"
            ><stop offset="0%" stop-color="#D4AF37"></stop><stop
              offset="50%"
              stop-color="#F6D98D"></stop><stop
              offset="100%"
              stop-color="#AA7C11"></stop></linearGradient
          ></defs
        ></svg
      >
      <svg
        class="chocolate-fall absolute left-[88%] w-5 opacity-70"
        style="animation-duration:10s; animation-delay:2s;"
        viewBox="0 0 30 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M15,5 L17,12 L24,15 L17,18 L15,25 L13,18 L6,15 L13,12 Z"
          fill="#7A4B29"></path></svg
      >
      <svg
        class="chocolate-fall absolute left-[93%] w-2.5 opacity-75"
        style="animation-duration:8s; animation-delay:7s;"
        viewBox="0 0 10 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        ><circle cx="5" cy="5" r="4" fill="#F6D98D"></circle></svg
      >
    </div>

    <!-- CONTENIDO -->

    <!-- ══════════════════════════════════════════════════
         DISEÑO MÓVIL EDITORIAL LUXURY (Solo celular < lg)
         Inspirado en estética editorial moderna: fondo crema,
         tipografía a la izquierda, recorte curvo orgánico a la derecha
         y tarjeta inferior de 3 pilares de confianza.
    ══════════════════════════════════════════════════ -->
    <div class="lg:hidden relative z-[5] w-full min-h-[90vh] flex flex-col justify-between pt-24 pb-6 px-4 bg-[#FAF5F0] overflow-hidden">
      
      <!-- Fondo sutil degradado crema -->
      <div class="absolute inset-0 bg-gradient-to-br from-[#FAF6F0] via-[#F4ECE3] to-[#EFE4D8] pointer-events-none -z-10"></div>
      <div class="absolute -top-12 -right-12 w-52 h-52 bg-[#dcb041]/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

      <!-- SECCIÓN SUPERIOR: TEXTO EDITORIAL + RECORTE CURVO DE IMAGEN -->
      <div class="relative w-full flex items-center justify-between pt-2 pb-4">
        
        <!-- Contenido de Texto a la Izquierda -->
        <div class="w-[58%] text-left pr-2 relative z-10 hero-anim-1">
          
          <!-- Ícono Emblema Asterisco Dorado -->
          <div class="w-8 h-8 rounded-full bg-[#2A1612] text-[#dcb041] flex items-center justify-center mb-3 shadow-md">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l2.4 6.8H21l-5.6 4.2 2.1 6.8-5.5-4.1-5.5 4.1 2.1-6.8L3 8.8h6.6L12 2z"/>
            </svg>
          </div>

          <!-- Título Principal -->
          <h1 class="font-serif text-[1.65rem] sm:text-[1.85rem] leading-[1.12] font-black text-[#2A1612] tracking-tight mb-2.5">
            Hay momentos que merecen un buen chocolate.
          </h1>

          <!-- Descripción -->
          <p class="text-[12px] text-[#5D4037]/85 leading-relaxed font-sans mb-4">
            Chocolates elaborados con tradición, elegancia y el auténtico sabor boliviano desde 1948.
          </p>

          <!-- Botón de Acción Principal (Pill oscuro elegante) -->
          <a
            href="#cajas-especiales"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#2A1612] text-[#f6d98d] hover:bg-[#3D1E15] active:scale-95 text-[11px] font-bold shadow-[0_4px_15px_rgba(42,22,18,0.25)] transition-all whitespace-nowrap"
          >
            <span>Explorar Catálogo</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>

        <!-- Imagen con Curva Orgánica Fluida a la Derecha -->
        <div class="w-[42%] h-72 sm:h-80 rounded-l-[45px] overflow-hidden shadow-[0_15px_30px_rgba(42,22,18,0.15)] border-y border-l border-[#e2d5c3] relative -mr-4 z-0 hero-anim-2">
          <img
            id="mobile-hero-img"
            src="/img/agostocbba.webp"
            alt="Chocolates Taboada"
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#2A1612]/30 via-transparent to-transparent"></div>
        </div>

      </div>

      <!-- SECCIÓN INFERIOR: TARJETA FLOTANTE DE 3 CARACTERÍSTICAS -->
      <div class="bg-white/95 backdrop-blur-md rounded-[1.75rem] p-3.5 sm:p-4 border border-[#e8dccb] shadow-[0_10px_25px_rgba(42,22,18,0.06)] grid grid-cols-3 gap-2 text-left relative z-10 hero-anim-3">
        
        <!-- Columna 1 -->
        <div class="flex flex-col items-start border-r border-[#f0e6d8] pr-2">
          <div class="w-7 h-7 rounded-lg bg-[#FAF5F0] text-[#5e4225] flex items-center justify-center mb-1.5 flex-shrink-0">
            <svg class="w-4 h-4 text-[#8f6c49]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>
          </div>
          <span class="text-[11px] font-bold text-[#2A1612] leading-tight font-serif">100% Cacao</span>
          <span class="text-[9px] text-[#8f6c49] leading-tight mt-0.5">Sabor noble</span>
        </div>

        <!-- Columna 2 -->
        <div class="flex flex-col items-start border-r border-[#f0e6d8] pr-2">
          <div class="w-7 h-7 rounded-lg bg-[#FAF5F0] text-[#5e4225] flex items-center justify-center mb-1.5 flex-shrink-0">
            <svg class="w-4 h-4 text-[#8f6c49]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="text-[11px] font-bold text-[#2A1612] leading-tight font-serif">Tradición</span>
          <span class="text-[9px] text-[#8f6c49] leading-tight mt-0.5">Desde 1948</span>
        </div>

        <!-- Columna 3 -->
        <div class="flex flex-col items-start">
          <div class="w-7 h-7 rounded-lg bg-[#FAF5F0] text-[#5e4225] flex items-center justify-center mb-1.5 flex-shrink-0">
            <svg class="w-4 h-4 text-[#8f6c49]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.004 0V5.625c0-.621-.504-1.125-1.125-1.125H9.375c-.621 0-1.125.504-1.125 1.125v8.625m5.004 0H8.25"/></svg>
          </div>
          <span class="text-[11px] font-bold text-[#2A1612] leading-tight font-serif">Calidad</span>
          <span class="text-[9px] text-[#8f6c49] leading-tight mt-0.5">Boliviana pura</span>
        </div>

      </div>

    </div>

    <!-- ══════════════════════════════════════════════════
         DISEÑO DESKTOP CINEMÁTICO (Solo Laptop / Desktop >= lg)
    ══════════════════════════════════════════════════ -->
    <div
      class="hidden lg:grid relative z-[5] w-full max-w-[1440px] mx-auto min-h-screen px-8 lg:pl-16 lg:pr-10 pt-[120px] pb-20 grid-cols-2 items-center gap-8"
    >
      <div class="max-w-[650px] text-left flex flex-col items-start relative w-full">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#dcb041]/15 border border-[#dcb041]/35 backdrop-blur-md shadow-[0_0_15px_rgba(220,176,65,0.2)] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#dcb041] animate-ping"></span>
          <span id="hero-subtitle" class="uppercase tracking-[0.38em] text-[#f6d98d] text-[0.75rem] font-black">
            DESDE 1948 CREANDO MOMENTOS ESPECIALES
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#dcb041]"></span>
        </div>

        <!-- Título -->
        <h1 id="hero-title" class="font-playfair text-[clamp(2.2rem,4.8vw,4.2rem)] leading-tight tracking-tight text-[#fff7f8] drop-shadow-[0_8px_25px_rgba(0,0,0,0.7)]">
          <span class="block text-white">Hay momentos que</span>
          <span class="bg-gradient-to-r from-[#ffe8b3] via-[#dcb041] to-[#f6d98d] bg-clip-text text-transparent italic font-[700] block mt-1 drop-shadow-[0_2px_12px_rgba(220,176,65,0.35)]">
            merecen un buen chocolate.
          </span>
        </h1>

        <!-- Descripción -->
        <p id="hero-description" class="mt-5 text-[clamp(0.95rem,1.5vw,1.1rem)] leading-relaxed text-[#f7e8ec] max-w-[460px] font-normal drop-shadow-sm">
          Cada ocasión merece un detalle especial. Descubre chocolates
          elaborados con tradición, elegancia y el auténtico sabor boliviano.
        </p>

        <!-- Botones -->
        <div class="mt-8 flex items-center gap-3">
          <a
            href="#cajas-especiales"
            class="group inline-flex items-center gap-2 px-7 py-4 rounded-full bg-gradient-to-r from-[#f6d98d] via-[#dcb041] to-[#c99a2e] text-[#2e1119] font-black text-sm shadow-[0_8px_25px_rgba(220,176,65,0.35)] hover:shadow-[0_10px_30px_rgba(220,176,65,0.55)] hover:scale-[1.03] active:scale-95 transition-all duration-300 relative overflow-hidden"
          >
            <span class="relative z-10 tracking-wide">Explorar Colecciones</span>
            <svg class="w-3.5 h-3.5 relative z-10 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent -translate-x-[130%] group-hover:animate-shimmer"></div>
          </a>

          <a
            href="/nosotros"
            class="group inline-flex items-center gap-1.5 px-7 py-4 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md text-white hover:text-[#dcb041] font-bold text-sm transition-all duration-300 relative overflow-hidden active:scale-95"
          >
            <span class="relative z-10 tracking-wide">Nuestra tradición</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const fetchWebConfig = async () => {
        try {
          const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:10000/api/v1";
          const response = await fetch(`${apiUrl}/fidelizacion/catalog`);
          if (response.ok) {
            const data = await response.json();
            if (data.status === "success" && data.web_config) {
              const wc = data.web_config;
              const subEl = document.getElementById("hero-subtitle");
              const titleEl = document.getElementById("hero-title");
              const descEl = document.getElementById("hero-description");
              
              if (wc.hero_subtitle && subEl && subEl.textContent !== wc.hero_subtitle)
                subEl.textContent = wc.hero_subtitle;
              if (wc.hero_title && titleEl && titleEl.textContent !== wc.hero_title)
                titleEl.textContent = wc.hero_title;
              if (wc.hero_description && descEl && descEl.textContent !== wc.hero_description)
                descEl.textContent = wc.hero_description;

              const bgElement = document.getElementById("hero-bg-cover");
              if (bgElement) {
                const currentCity = localStorage.getItem("taboada_selected_city") || "cochabamba";
                window.dispatchEvent(
                  new CustomEvent("cityChanged", {
                    detail: { city: currentCity },
                  }),
                );
              }

              // Render featured products
              if (wc.featured_products && wc.featured_products.length > 0 && data.productos) {
                const destacadosContainer = document.getElementById("destacados-container");
                if (destacadosContainer) {
                  let html = '';
                  wc.featured_products.forEach((id, index) => {
                    const product = data.productos.find(p => p.id === id);
                    if (product) {
                      const isReverse = index % 2 !== 0;
                      const currentCity = localStorage.getItem('taboada_selected_city') || 'cochabamba';
                      const currentPrice = product.precios && product.precios[currentCity] ? product.precios[currentCity] : 0;
                      
                      html += `
                      <div class="product-card bg-[#18090d]/35 backdrop-blur-md border border-white/10 rounded-[2rem] p-6 md:p-8 flex flex-col ${isReverse ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-8 shadow-2xl transition-all duration-500 group cursor-pointer" style="-webkit-backdrop-filter: blur(12px);" data-id="${product.id}" data-name="${product.nombre}" data-size="Unidad" data-img="${product.imagen}" data-desc="${product.descripcion || ''}" data-price-cochabamba="${product.precios?.cochabamba || 0}" data-price-lapaz="${product.precios?.lapaz || 0}">
                        <div class="md:w-[42%] flex items-center justify-center relative overflow-hidden">
                          <img src="${product.imagen}" alt="${product.nombre}" class="object-contain w-full h-full max-h-56 relative z-10 drop-shadow-[0_15px_25px_rgba(0,0,0,0.6)] group-hover:scale-105 transition-transform duration-500" />
                        </div>
                        <div class="md:w-[58%] flex flex-col justify-center text-left ${isReverse ? 'md:text-right md:items-end' : ''}">
                          <h3 class="text-4xl md:text-5xl font-serif font-bold text-white mb-2 drop-shadow-sm">Bs. ${currentPrice}</h3>
                          <h4 class="text-xl md:text-2xl font-bold text-[#dcb041] mb-1 font-serif tracking-wide">${product.nombre}</h4>
                          <p class="text-white/80 text-sm leading-relaxed mb-6 font-sans">Destacado exclusivo de la temporada.</p>
                          <div class="flex flex-wrap items-center gap-3 mt-auto">
                            <span class="bg-black/40 border border-white/15 text-white/80 text-xs font-semibold px-4 py-2 rounded-full font-sans tracking-wide">Destacado</span>
                            <button type="button" class="add-to-cart-btn bg-[#dcb041] hover:bg-white text-[#1C0C12] text-xs font-extrabold px-5 py-2.5 rounded-full transition-all duration-300 shadow-lg hover:scale-105 cursor-pointer flex items-center gap-2" data-id="${product.id}" data-name="${product.nombre}" data-size="Unidad" data-img="${product.imagen}" data-desc="${product.descripcion || ''}" data-price-cochabamba="${product.precios?.cochabamba || 0}" data-price-lapaz="${product.precios?.lapaz || 0}">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path></svg>
                              <span>Añadir al Carrito</span>
                            </button>
                            <button type="button" class="direct-buy-btn bg-black/50 hover:bg-black/70 border border-white/20 text-white text-xs font-bold px-5 py-2.5 rounded-full transition-all duration-300 shadow-md hover:scale-105 text-center cursor-pointer flex items-center gap-2" data-name="${product.nombre}" data-size="Unidad" data-price-cochabamba="${product.precios?.cochabamba || 0}" data-price-lapaz="${product.precios?.lapaz || 0}">
