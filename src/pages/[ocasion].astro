---
import Index from './index.astro';

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || "https://sales-system-aptb.onrender.com/api/v1";
  let collections = [];
  
  try {
    const response = await fetch(`${apiUrl}/fidelizacion/catalog`);
    const data = await response.json();
    if (data.status === 'success' && data.colecciones) {
      collections = data.colecciones;
    }
  } catch (error) {
    console.error("Error fetching collections for static paths:", error);
  }

  // Fallback if API fails or no collections
  if (collections.length === 0) {
    collections = [
      { name: 'Regala' },
      { name: 'Sorprende' },
      { name: 'Disfruta con amigos' },
      { name: 'Comparte' },
      { name: 'Festeja' },
      { name: 'Ver todo' }
    ];
  }

  return collections.map((col: any) => ({
    params: { ocasion: col.name }
  }));
}

const { ocasion } = Astro.params;
---

<Index />
