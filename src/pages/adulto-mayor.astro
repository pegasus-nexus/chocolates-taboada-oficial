---
import AppLayout from '../layouts/AppLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<AppLayout title="Programa Legado · Credencial de Honor para Adultos Mayores | Chocolates Taboada">

<style is:global>
  :root {
    --oro-viejo: #FAF5F0;
    --beige-seda: #FAF5F0;
    --cafe-profundo: #2A1612;
    --cafe-claro: #8f6c49;
    --font-serif: "Playfair Display", serif;
  }

  body { 
    background: #12080a url('/img/fondo_legado.webp') center/cover no-repeat fixed;
    margin: 0; 
    color: #ffffff;
  }

  /* ── EFECTO CRISTAL Y RESPLANDOR DORADO ── */
  .gold-glow {
    box-shadow: 0 0 50px rgba(220, 176, 65, 0.35);
  }

  /* ── TARJETA CRÉDITO INTERACTIVA ── */
  .card-3d-wrapper {
    perspective: 1000px;
  }

  .credit-card-preview {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1.586 / 1;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(55, 28, 20, 0.96) 0%, rgba(24, 10, 14, 0.98) 50%, rgba(42, 22, 18, 0.96) 100%);
    border: 1.5px solid rgba(220, 176, 65, 0.55);
    border-radius: 22px;
    padding: 24px;
    box-shadow: 
      0 30px 60px -12px rgba(0, 0, 0, 0.9),
      0 0 35px rgba(220, 176, 65, 0.15),
      inset 0 1px 2px rgba(246, 217, 141, 0.4),
      inset 0 -1px 2px rgba(0, 0, 0, 0.7);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease-out, box-shadow 0.3s ease;
    transform-style: preserve-3d;
  }

  .credit-card-preview::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0) 30%,
      rgba(220, 176, 65, 0.15) 48%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(220, 176, 65, 0.15) 52%,
      rgba(255, 255, 255, 0) 70%
    );
    pointer-events: none;
    z-index: 5;
    animation: cardShimmer 6s infinite ease-in-out;
  }

  @keyframes cardShimmer {
    0% { transform: translate(-30%, -30%) rotate(0deg); }
    50% { transform: translate(10%, 10%) rotate(5deg); }
    100% { transform: translate(-30%, -30%) rotate(0deg); }
  }

  .card-chip-emv {
    width: 44px;
    height: 34px;
    background: linear-gradient(135deg, #f3d482 0%, #c69b43 50%, #e7c269 100%);
    border-radius: 7px;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.6), 0 2px 5px rgba(0,0,0,0.5);
  }

  .card-chip-emv::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(42, 22, 18, 0.4);
    border-radius: 4px;
    background-image: 
      linear-gradient(90deg, transparent 45%, rgba(42, 22, 18, 0.35) 50%, transparent 55%),
      linear-gradient(0deg, transparent 45%, rgba(42, 22, 18, 0.35) 50%, transparent 55%);
  }

  .embossed-gold {
    font-family: 'OCR-A Extended', monospace, 'Courier New', serif;
    letter-spacing: 2px;
    color: #f6d98d;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95), 0 0 12px rgba(246, 217, 141, 0.4);
  }

  /* ── ESTILOS DEL FORMULARIO GLASSMORPHISM DORADO ── */
  .field-input {
    width: 100%;
    padding: 14px 18px;
    border: 1.5px solid rgba(220, 176, 65, 0.35);
    border-radius: 14px;
    background: rgba(24, 10, 14, 0.85);
    font-family: inherit;
    font-size: 14px;
    color: #f6d98d;
    font-weight: 600;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .field-input::placeholder {
    color: rgba(246, 217, 141, 0.45);
  }

  .field-input:focus {
    outline: none;
    border-color: #dcb041;
    box-shadow: 0 0 0 4px rgba(220, 176, 65, 0.25);
    background: rgba(36, 16, 22, 0.95);
  }

  .btn-gold-action {
    width: 100%;
    padding: 18px 24px;
    background: linear-gradient(135deg, #dcb041 0%, #f4c856 50%, #c9982b 100%);
    color: #2A1612;
    border: none;
    border-radius: 9999px;
    font-weight: 900;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(220, 176, 65, 0.4);
  }

  .btn-gold-action:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 14px 35px rgba(220, 176, 65, 0.6);
    filter: brightness(1.08);
  }

  /* ── ANIMACIÓN AL COMPLETAR ── */
  .card-success-flip {
    animation: flipGlow 0.8s ease-out forwards;
  }

  @keyframes flipGlow {
    0% { transform: scale(1) rotateY(0deg); }
    50% { transform: scale(1.08) rotateY(180deg); }
    100% { transform: scale(1) rotateY(360deg); }
  }
</style>

<div class="am-page flex flex-col min-h-screen">
  
  <!-- NAVBAR REUTILIZABLE OFICIAL -->
  <Navbar />

  <!-- HERO SECTION CON ESTILO BOUTIQUE LUXURY -->
  <section class="relative pt-32 pb-12 md:pt-40 md:pb-16 text-center px-4 overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
      
      <!-- Insignia Dorada -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#dcb041]/15 border border-[#dcb041]/50 mb-6 backdrop-blur-md shadow-[0_4px_20px_rgba(220,176,65,0.2)]">
        <span class="w-2 h-2 rounded-full bg-[#dcb041] animate-pulse"></span>
        <span class="text-xs font-extrabold tracking-widest text-[#f6d98d] uppercase">Programa Legado Taboada</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold text-white leading-tight mb-6 drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)]">
        Credencial de Honor para <span class="text-[#f6d98d] italic">Adultos Mayores</span>
      </h1>

      <p class="text-sm sm:text-base md:text-lg text-[#f3dfe5]/90 max-w-2xl mx-auto leading-relaxed font-sans mb-8 drop-shadow-md">
        Otorgamos un <strong class="text-[#f6d98d]">descuento vitalicio del 5%</strong> en nuestras sucursales. 
        Completa los datos para generar tu tarjeta digital instantánea y preséntala al realizar tu compra.
      </p>

      <!-- Sucursales badge -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-[#f6d98d]">
        <a href="https://n9.cl/cg9lw" target="_blank" rel="noopener noreferrer" class="px-5 py-2 rounded-full bg-black/40 border border-[#dcb041]/50 hover:bg-[#dcb041] hover:text-[#2A1612] transition-all font-bold backdrop-blur-md shadow-lg">
          📍 Recoger en Sucursal La Recoleta ↗
        </a>
      </div>

    </div>
  </section>

  <!-- CONTENIDO PRINCIPAL: TARJETA INTERACTIVA + FORMULARIO -->
  <main class="max-w-6xl mx-auto px-4 md:px-8 pb-20 w-full flex-grow">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
      
      <!-- COLUMNA IZQUIERDA: TARJETA DIGITAL INTERACTIVA (PREVIEW EN TIEMPO REAL) -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center">
        
        <div class="w-full text-center mb-3">
          <span class="text-xs font-bold uppercase tracking-widest text-[#f6d98d] flex items-center justify-center gap-2 drop-shadow-md">
            <svg class="w-4 h-4 text-[#dcb041]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            Vista Previa de la Credencial
          </span>
        </div>

        <!-- CONTENEDOR 3D DE LA TARJETA -->
        <div class="card-3d-wrapper w-full">
          <div id="credit-card" class="credit-card-preview flex flex-col justify-between relative z-10">
            
            <!-- HEADER DE LA TARJETA -->
            <div class="flex justify-between items-start z-10">
              <img src="/img/taboada-logo.png" alt="Taboada" class="h-7 sm:h-9 object-contain drop-shadow-md" />
              <div class="text-right">
                <span class="text-[9px] font-black uppercase tracking-widest text-[#f6d98d] block opacity-90">VIP LEGADO</span>
                <span class="text-[8px] text-white/70 tracking-wider uppercase font-semibold">Credencial Honorífica</span>
              </div>
            </div>

            <!-- CUERPO DE LA TARJETA (CHIP Y DATOS EN TIEMPO REAL) -->
            <div class="my-3 z-10">
              <div class="flex items-center justify-between mb-3">
                <div class="card-chip-emv"></div>
                <!-- Holograma / Marca de agua -->
                <div class="w-8 h-8 rounded-full border border-[#f6d98d]/50 bg-gradient-to-tr from-[#dcb041]/30 to-[#f4c856]/50 flex items-center justify-center text-[#f6d98d] text-[9px] font-bold shadow-md">
                  5%
                </div>
              </div>

              <!-- NOMBRE COMPLETO DINÁMICO EN TIEMPO REAL -->
              <div class="mb-1">
                <span class="text-[8px] uppercase tracking-widest text-[#f6d98d]/80 font-bold block">Titular Beneficiario</span>
                <div id="live-card-name" class="embossed-gold text-lg sm:text-xl font-bold truncate">
                  NOMBRE APELLIDO
                </div>
              </div>
            </div>

            <!-- FOOTER DE LA TARJETA (CÓDIGO ID, PARENTESCO Y DESCUENTO) -->
            <div class="border-t border-[#f6d98d]/30 pt-2.5 flex justify-between items-end z-10">
              <div>
                <span class="text-[7px] uppercase tracking-widest text-[#f6d98d]/80 font-bold block">Código Único ID</span>
                <div id="live-card-id" class="embossed-gold text-xs sm:text-sm">
                  #LEG-2026-8942
                </div>
              </div>

              <div class="text-center px-2 py-0.5 rounded bg-[#f6d98d]/15 border border-[#f6d98d]/40">
                <span class="text-[7px] uppercase tracking-widest text-[#f6d98d] font-bold block">Parentesco</span>
                <span id="live-card-relation" class="text-[10px] font-extrabold text-white uppercase block">
                  TITULAR
                </span>
              </div>

              <div class="text-right">
                <div class="font-serif font-black text-xl sm:text-2xl text-[#f6d98d] leading-none">
                  5%
                </div>
                <span class="text-[7px] uppercase tracking-widest text-white/80 font-bold block">Desc. Vitalicio</span>
              </div>
            </div>

          </div>
        </div>

        <p class="text-[11px] text-[#f6d98d]/70 mt-4 text-center italic drop-shadow-md">
          ✨ La tarjeta se actualiza automáticamente al escribir en el formulario.
        </p>

      </div>


      <!-- COLUMNA DERECHA: FORMULARIO DE REGISTRO CON DISEÑO BOUTIQUE DORADO -->
      <div class="lg:col-span-7">
        
        <div class="bg-[#180a0e]/85 backdrop-blur-xl rounded-3xl p-6 sm:p-10 border border-[#dcb041]/40 shadow-[0_25px_60px_rgba(0,0,0,0.85)] text-white relative overflow-hidden">
          
          <!-- Borde decorativo superior dorado -->
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#dcb041] via-[#f4c856] to-[#8f6c49]"></div>

          <div class="mb-6 border-b border-[#dcb041]/20 pb-4">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-1">
              Registro del Beneficiario
            </h2>
            <p class="text-xs sm:text-sm text-[#f3dfe5]/80 font-medium">
              Ingresa los datos requeridos para emitir la Credencial de Honor.
            </p>
          </div>

          <form id="am-form" class="space-y-4 sm:space-y-5">
            
            <!-- NOMBRE Y APELLIDOS EN PARALELO -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#f6d98d] mb-1.5">
                  Nombre (s)
                </label>
                <input 
                  type="text" 
                  id="am-nombre" 
                  class="field-input" 
                  placeholder="Ej. Juan" 
                  required 
                  autocomplete="off"
                />
              </div>

              <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#f6d98d] mb-1.5">
                  Apellidos
                </label>
                <input 
                  type="text" 
                  id="am-apellido" 
                  class="field-input" 
                  placeholder="Ej. Pérez" 
                  required 
                  autocomplete="off"
                />
              </div>
            </div>

            <!-- PARENTESCO Y FECHA DE NACIMIENTO -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#f6d98d] mb-1.5">
                  Parentesco / Relación
                </label>
                <input 
                  type="text" 
                  id="am-parentezco" 
                  class="field-input" 
                  placeholder="Ej. Hijo(a) / Beneficiario" 
                  required 
                  autocomplete="off"
                />
              </div>

              <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#f6d98d] mb-1.5">
                  Fecha de Nacimiento
                </label>
                <input 
                  type="date" 
                  id="am-fecha" 
                  class="field-input" 
                  required 
                />
              </div>
            </div>

            <!-- BOTÓN GENERAR -->
            <div class="pt-3">
              <button type="submit" id="submit-btn" class="btn-gold-action flex items-center justify-center gap-3">
                <span>Generar Código y Visitar Recoleta</span>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
                </svg>
              </button>

              <p class="text-[11px] text-center text-[#f6d98d]/70 italic font-sans mt-3">
                * Preséntate con el código ID generado en caja para validar tu beneficio.
              </p>
            </div>

          </form>

          <!-- MENSAJE DE ÉXITO DE DESPLIEGUE TRAS GUARDAR -->
          <div id="success-panel" class="hidden text-center py-6">
            <div class="w-16 h-16 rounded-full bg-[#dcb041]/20 border-2 border-[#dcb041] flex items-center justify-center mx-auto mb-4 text-[#f6d98d]">
              <svg class="w-9 h-9 text-[#f6d98d]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-white mb-2">
              ¡Credencial Generada Exitosamente!
            </h3>

            <p class="text-sm text-[#f3dfe5]/90 max-w-md mx-auto mb-6 leading-relaxed">
              La tarjeta ha sido registrada y vinculada en el sistema de Chocolates Taboada. Preséntate con el código <strong id="success-code-display" class="text-[#f6d98d] font-bold">#LEG-2026</strong> en Sucursal La Recoleta.
            </p>

            <div class="flex flex-wrap items-center justify-center gap-3">
              <button 
                type="button" 
                onclick="window.print()" 
                class="px-6 py-2.5 rounded-full bg-[#2A1612] text-[#f6d98d] font-bold text-xs border border-[#dcb041]/40 hover:bg-[#dcb041] hover:text-[#2A1612] transition-all cursor-pointer shadow-lg"
              >
                🖨️ Imprimir / Guardar
              </button>
              <a 
                href="/" 
                class="px-6 py-2.5 rounded-full bg-gradient-to-r from-[#dcb041] to-[#f4c856] text-[#2A1612] font-black text-xs hover:scale-105 transition-all shadow-lg"
              >
                Volver al Inicio →
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>

  </main>

  <!-- FOOTER OFICIAL COMPLETO -->
  <Footer />

</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const inputNombre = document.getElementById('am-nombre');
    const inputApellido = document.getElementById('am-apellido');
    const inputParentezco = document.getElementById('am-parentezco');
    
    const liveCardName = document.getElementById('live-card-name');
    const liveCardRelation = document.getElementById('live-card-relation');
    const liveCardId = document.getElementById('live-card-id');
    const successCodeDisplay = document.getElementById('success-code-display');
    const creditCard = document.getElementById('credit-card');

    const form = document.getElementById('am-form');
    const successPanel = document.getElementById('success-panel');

    // Generar un ID único de tarjeta
    const generatedId = "LEG-2026-" + Math.floor(1000 + Math.random() * 9000);
    if (liveCardId) liveCardId.textContent = "#" + generatedId;
    if (successCodeDisplay) successCodeDisplay.textContent = "#" + generatedId;

    // Actualización dinámica en tiempo real al escribir
    function updateLiveCard() {
      const nombre = (inputNombre?.value || "").trim();
      const apellido = (inputApellido?.value || "").trim();
      const parentezco = (inputParentezco?.value || "").trim();

      if (liveCardName) {
        if (nombre || apellido) {
          liveCardName.textContent = `${nombre} ${apellido}`.toUpperCase();
        } else {
          liveCardName.textContent = "NOMBRE APELLIDO";
        }
      }

      if (liveCardRelation) {
        liveCardRelation.textContent = parentezco ? parentezco.toUpperCase() : "TITULAR";
      }
    }

    inputNombre?.addEventListener('input', updateLiveCard);
    inputApellido?.addEventListener('input', updateLiveCard);
    inputParentezco?.addEventListener('input', updateLiveCard);

    // Efecto 3D interactivo al mover el cursor sobre la tarjeta
    const cardWrapper = document.querySelector('.card-3d-wrapper');
    if (cardWrapper && creditCard) {
      cardWrapper.addEventListener('mousemove', (e) => {
        const rect = cardWrapper.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        const rotateX = (-y / rect.height) * 20;
        const rotateY = (x / rect.width) * 20;
        creditCard.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      cardWrapper.addEventListener('mouseleave', () => {
        creditCard.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });
    }

    // Manejo de envío del formulario
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = document.getElementById('submit-btn');
      if (submitBtn) {
        submitBtn.innerHTML = `<span>GENERANDO CREDENCIAL...</span>`;
        submitBtn.style.opacity = '0.7';
        submitBtn.style.pointerEvents = 'none';
      }

      // Animación de resplandor / giro en la tarjeta
      if (creditCard) {
        creditCard.classList.add('card-success-flip');
      }

      await new Promise(r => setTimeout(r, 1200));

      if (form && successPanel) {
        form.classList.add('hidden');
        successPanel.classList.remove('hidden');
      }
    });
  });
</script>

</AppLayout>
