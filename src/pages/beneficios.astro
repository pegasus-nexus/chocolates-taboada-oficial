---
import AppLayout from '../layouts/AppLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// 1. Datos de los beneficios con VALIDEZ PERSONALIZADA e imágenes corregidas
const apiUrl = process.env.PUBLIC_API_URL || import.meta.env.PUBLIC_API_URL || "https://app.pegasus-nexus.com/api/v1";
let rewards = [];
try {
    const res = await fetch(`${apiUrl}/fidelizacion/catalog`);
    const data = await res.json();
    if (data && data.web_config && data.web_config.rewards) {
        rewards = data.web_config.rewards.filter(r => r.is_active);
    }
} catch (e) {
    console.error("Error fetching rewards:", e);
}

if (rewards.length === 0) {
    rewards = [
        { id:'trufa', title:'Chocolate Amargo', tag:'Regalo VIP', desc:'Pieza maestra de cacao belga.', img:'/img/chocolate_amargo_beneficio.webp', validity: '2 Semanas' },
        { id:'choco', title:'Trufas de Chocolate', tag:'Exclusivo', desc:'70% cacao amazónico.', img:'/img/trufas_beneficio.webp', validity: '2 Semanas' },
        { id:'cupon2', title:'Gesto 2%', tag:'Cortesía', desc:'Descuento especial de bienvenida.', img:'/img/descuento_porcentaje.webp', validity: 'Un mes' },
        { id:'choco3', title:'Gesto 3%', tag:'Exclusivo', desc:'70% cacao amazónico en tu compra.', img:'/img/descuento_porcentaje.webp', validity: '2 Semanas' },
        { id:'cupon4', title:'Gesto 4%', tag:'Cortesía', desc:'Descuento especial por compras.', img:'/img/descuento_porcentaje.webp', validity: '1 Semana' },
    ];
}

// Fecha actual formateada elegante
const rawFecha = new Date().toLocaleDateString('es-ES', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const fechaHoyFormatted = rawFecha.charAt(0).toUpperCase() + rawFecha.slice(1);
---

<AppLayout title="Comunidad Taboada · Beneficios Exclusivos">

<style is:global>
  :root {
    --oro-viejo: #8f6c49;
    --beige-seda: #FAF5F0;
    --cafe-profundo: #2A1612;
    --font-serif: "Playfair Display", serif; 
  }

  body { background-color: var(--cafe-profundo); color: var(--beige-seda); margin: 0; }

  /* ══════════════════════════════════════════════════
     SECCIÓN DE BIENVENIDA
  ══════════════════════════════════════════════════ */
  .welcome-container {
    position: relative;
    min-height: 100vh;
    padding: 70px 1.25rem 30px;
    display: flex;
    flex-direction: column;
    background-color: var(--cafe-profundo);
    overflow: visible !important;
  }

  @media (min-width: 768px) {
    .welcome-container {
      padding: 115px 2rem 60px;
    }
  }

  /* ══════════════════════════════════════════════════
     BARRA SUPERIOR CON BOTÓN DE REGRESO Y FECHA
  ══════════════════════════════════════════════════ */
  .top-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto 6px;
    padding: 0;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 768px) {
    .top-nav-bar {
      margin: 0 auto 20px;
    }
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: var(--beige-seda);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border: none;
    padding: 0;
    transition: color 0.3s ease;
  }

  @media (min-width: 640px) {
    .btn-back {
      font-size: 0.95rem;
      gap: 10px;
    }
  }

  .btn-back:hover {
    color: #dcb041;
  }

  .current-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #dcb041;
    font-weight: 600;
    font-style: italic;
    font-family: var(--font-serif);
    background: transparent;
    border: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .current-date-badge {
      font-size: 1.15rem;
      gap: 10px;
    }
  }

  .welcome-section {
    text-align: left;
    max-width: 80rem;
    margin: 0 auto 6px;
    padding: 0;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .welcome-section {
      margin: 0 auto 24px;
    }
  }

  /* ══════════════════════════════════════════════════
     SECCIÓN DE TICKETS RESPONSIVOS
  ══════════════════════════════════════════════════ */
  .ticket-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 80rem;
    margin: 10px auto 25px;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .ticket-container {
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 24px;
      margin: 20px auto 40px;
    }
  }

  .ticket-wrapper {
    position: relative;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.35));
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    height: fit-content;
    overflow: visible !important;
  }
  .ticket-wrapper:hover { transform: translateY(-3px) scale(1.008); }

  .ticket {
    background: transparent;
    display: flex;
    flex-direction: row; 
    border-radius: 18px;
    overflow: visible !important;
    position: relative;
    border: none;
  }

  @media (min-width: 640px) {
    .ticket {
      border-radius: 24px;
    }
  }

  .ticket-main, .ticket-stub, .ticket-divider { transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease; }
  
  .ticket-main { 
    flex: 1; 
    padding: 14px 12px; 
    display: flex; 
    align-items: center; 
    gap: 12px;
    background: linear-gradient(135deg, #FAF5F0 0%, #F3ECE3 100%);
    border-radius: 18px 0 0 18px;
  }

  @media (min-width: 640px) {
    .ticket-main {
      padding: 24px;
      gap: 20px;
      border-radius: 24px 0 0 24px;
    }
  }
  
  .ticket-img { 
    width: 62px; 
    height: 62px; 
    background: transparent; 
    border-radius: 12px; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    flex-shrink: 0; 
    border: none;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ticket-img {
      width: 90px;
      height: 90px;
      border-radius: 18px;
    }
  }

  .ticket-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; filter: drop-shadow(0 4px 12px rgba(42,22,18,0.2)); }
  @media (min-width: 640px) {
    .ticket-img img { border-radius: 18px; }
  }

  .ticket-info { 
    text-align: left; 
    position: relative;
    z-index: 10;
  }
  .ticket-tag { font-size: 8px; font-weight: 800; color: #8f6c49; letter-spacing: 0.12em; text-transform: uppercase; }
  .ticket-title { font-family: var(--font-serif); font-size: 1.05rem; color: #2A1612; margin: 2px 0 3px; font-weight: bold; line-height: 1.2; }
  .ticket-desc { font-size: 10.5px; color: #5D4037; opacity: 0.9; margin-bottom: 4px; line-height: 1.35; font-family: sans-serif; }
  .ticket-loc { font-size: 7.5px; font-weight: 700; color: #8f6c49; opacity: 0.8; letter-spacing: 0.03em; }

  @media (min-width: 640px) {
    .ticket-tag { font-size: 9px; letter-spacing: 0.15em; }
    .ticket-title { font-size: 1.45rem; margin: 4px 0; }
    .ticket-desc { font-size: 11.5px; margin-bottom: 8px; line-height: 1.4; }
    .ticket-loc { font-size: 8px; letter-spacing: 0.05em; }
  }

  .ticket-divider { position: relative; display: flex; align-items: center; justify-content: center; width: 2px; }
  .dash-line { width: 2px; height: 100%; border-left: 2px dashed rgba(42, 22, 18, 0.2); }
  .hole { position: absolute; width: 22px; height: 22px; background-color: var(--cafe-profundo); border-radius: 50%; z-index: 5; }
  .hole-start { top: -11px; left: -10px; }
  .hole-end { bottom: -11px; left: -10px; }

  @media (min-width: 640px) {
    .hole { width: 28px; height: 28px; }
    .hole-start { top: -14px; left: -13px; }
    .hole-end { bottom: -14px; left: -13px; }
  }

  .ticket-stub { 
    width: 90px; 
    background: #F3ECE3;
    background: linear-gradient(135deg, #F3ECE3 0%, #EFE5D8 100%);
    border-radius: 0 18px 18px 0;
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    justify-content: center; 
    padding: 12px 8px; 
    text-align: center; 
    border-left: none; 
  }

  @media (min-width: 640px) {
    .ticket-stub {
      width: 125px;
      padding: 18px 14px;
      border-radius: 0 24px 24px 0;
    }
  }

  .stub-barcode { font-family: monospace; font-size: 13px; font-weight: 500; color: #2A1612; opacity: 0.45; letter-spacing: 1px; margin-bottom: 4px; }
  .stub-label { font-size: 7.5px; font-weight: 700; color: #8f6c49; margin-bottom: 8px; letter-spacing: 0.04em; }

  @media (min-width: 640px) {
    .stub-barcode { font-size: 17px; margin-bottom: 8px; }
    .stub-label { font-size: 8px; margin-bottom: 12px; }
  }

  .btn-redeem { background: var(--cafe-profundo); color: var(--beige-seda); border: none; padding: 7px 10px; border-radius: 9999px; font-size: 9px; font-weight: 800; cursor: pointer; transition: all 0.3s ease; letter-spacing: 0.06em; width: 100%; box-shadow: 0 3px 8px rgba(42, 22, 18, 0.2); }
  .btn-redeem:hover { background: #8f6c49; color: #ffffff; transform: translateY(-1px); }
  .btn-redeem:active { transform: scale(0.97); }

  @media (min-width: 640px) {
    .btn-redeem {
      padding: 10px 14px;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
  }

  .stamp-redeemed {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(4) rotate(-25deg);
    font-family: var(--font-serif); font-size: 1.4rem; color: #3a1823; border: 2px solid #3a1823;
    padding: 4px 12px; border-radius: 8px; font-weight: 900; opacity: 0; z-index: 100; transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    background: #FAF5F0; pointer-events: none; box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  }

  @media (min-width: 640px) {
    .stamp-redeemed {
      font-size: 2.2rem;
      border-width: 3px;
      padding: 8px 20px;
      border-radius: 12px;
    }
  }

  /* ══════════════════════════════════════════════════
     STAGE PORTAL CINEMATOGRÁFICO DE CANJE
  ══════════════════════════════════════════════════ */
  #redeem-portal-stage {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: visible !important;
  }
  #redeem-portal-stage.active {
    display: flex;
  }

  #redeem-portal-stage .ticket-wrapper {
    position: relative !important;
    transform: scale(1.05) !important;
    width: 100% !important;
    max-width: 370px !important;
    margin: 0 !important;
    filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.95)) !important;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    overflow: visible !important;
  }

  @media (min-width: 640px) {
    #redeem-portal-stage .ticket-wrapper {
      transform: scale(1.25) !important;
      max-width: 500px !important;
    }
  }

  #redeem-portal-stage .ticket-wrapper.is-broken .ticket-main { transform: translateX(-25px) rotate(-3deg) !important; }
  #redeem-portal-stage .ticket-wrapper.is-broken .ticket-stub { transform: translate(25px, 15px) rotate(8deg) !important; }
  #redeem-portal-stage .ticket-wrapper.is-broken .ticket-divider { opacity: 0 !important; }
  #redeem-portal-stage .ticket-wrapper.is-stamped .stamp-redeemed { opacity: 1 !important; transform: translate(-50%, -50%) scale(1.1) rotate(-14deg) !important; }

  @media (min-width: 640px) {
    #redeem-portal-stage .ticket-wrapper.is-broken .ticket-main { transform: translateX(-45px) rotate(-4deg) !important; }
    #redeem-portal-stage .ticket-wrapper.is-broken .ticket-stub { transform: translate(45px, 25px) rotate(12deg) !important; }
  }

  /* ══════════════════════════════════════════════════
     ESTADO DE RECOMPENSA PERMANENTE
  ══════════════════════════════════════════════════ */
  .ticket-container.estado-recompensa-permanente {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    max-width: 1200px !important;
    margin: 20px auto 30px !important;
    overflow: visible !important;
  }

  @media (min-width: 640px) {
    .ticket-container.estado-recompensa-permanente {
      margin: 40px auto 40px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final {
    position: relative !important;
    width: 100% !important;
    max-width: 900px !important;
    margin: 0 auto !important;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.7)) !important;
    transition: all 0.5s ease;
    overflow: visible !important;
  }

  .ticket-wrapper.ticket-gigante-final .ticket {
    overflow: visible !important;
    min-height: auto !important;
    border-radius: 18px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket {
      border-radius: 28px !important;
      min-height: 220px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-main {
    padding: 16px 14px !important;
    gap: 12px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-main {
      padding: 32px 38px !important;
      gap: 26px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-img {
    width: 65px !important;
    height: 65px !important;
    border-radius: 12px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-img {
      width: 105px !important;
      height: 105px !important;
      border-radius: 20px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-title {
    font-size: 1.15rem !important;
    margin: 2px 0 4px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-title {
      font-size: 2.1rem !important;
      margin: 4px 0 6px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-desc {
    font-size: 11px !important;
    line-height: 1.35 !important;
    margin-bottom: 6px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-desc {
      font-size: 14px !important;
      line-height: 1.5 !important;
      margin-bottom: 10px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-tag {
    font-size: 8px !important;
    letter-spacing: 0.14em !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-tag {
      font-size: 10px !important;
      letter-spacing: 0.18em !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .ticket-stub {
    width: 95px !important;
    padding: 14px 10px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .ticket-stub {
      width: 160px !important;
      padding: 22px 18px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .stub-barcode {
    font-size: 13px !important;
    margin-bottom: 4px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .stub-barcode {
      font-size: 20px !important;
      margin-bottom: 8px !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final .stub-label {
    font-size: 7.5px !important;
    margin-bottom: 8px !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .stub-label {
      font-size: 9.5px !important;
      margin-bottom: 12px !important;
    }
  }

  /* SELLO MARCA DE AGUA SEMITRANSPARENTE */
  .ticket-wrapper.ticket-gigante-final .stamp-redeemed {
    display: block !important;
    font-size: 1.7rem !important;
    border: 3px solid #3a1823 !important;
    color: #3a1823 !important;
    padding: 6px 20px !important;
    border-radius: 10px !important;
    opacity: 0.1 !important;
    z-index: 0 !important;
    transform: translate(-50%, -50%) scale(1) rotate(-14deg) !important;
    background: transparent !important;
    box-shadow: none !important;
    white-space: nowrap !important;
    pointer-events: none !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.ticket-gigante-final .stamp-redeemed {
      font-size: 3.2rem !important;
      border-width: 4px !important;
      padding: 8px 30px !important;
      border-radius: 14px !important;
    }
  }

  /* BORDE RASGADO */
  .ticket-wrapper.is-broken .ticket-main {
    transform: translateX(-15px) rotate(-1.5deg) !important;
    clip-path: polygon(
      0 0, 100% 0, calc(100% - 6px) 5%, 100% 10%, calc(100% - 6px) 15%, 100% 20%, 
      calc(100% - 6px) 25%, 100% 30%, calc(100% - 6px) 35%, 100% 40%, calc(100% - 6px) 45%, 
      100% 50%, calc(100% - 6px) 55%, 100% 60%, calc(100% - 6px) 65%, 100% 70%, 
      calc(100% - 6px) 75%, 100% 80%, calc(100% - 6px) 85%, 100% 90%, calc(100% - 6px) 95%, 
      100% 100%, 0 100%
    ) !important;
  }

  .ticket-wrapper.is-broken .ticket-stub {
    transform: translate(15px, 8px) rotate(4deg) !important;
    clip-path: polygon(
      0 0, 100% 0, 100% 100%, 0 100%, 0 95%, 6px 90%, 0 85%, 6px 80%, 0 75%, 6px 70%, 
      0 65%, 6px 60%, 0 55%, 6px 50%, 0 45%, 6px 40%, 0 35%, 6px 30%, 0 25%, 6px 20%, 
      0 15%, 6px 10%, 0 5%
    ) !important;
  }

  @media (min-width: 640px) {
    .ticket-wrapper.is-broken .ticket-main {
      transform: translateX(-35px) rotate(-3deg) !important;
      clip-path: polygon(
        0 0, 100% 0, calc(100% - 8px) 5%, 100% 10%, calc(100% - 8px) 15%, 100% 20%, 
        calc(100% - 8px) 25%, 100% 30%, calc(100% - 8px) 35%, 100% 40%, calc(100% - 8px) 45%, 
        100% 50%, calc(100% - 8px) 55%, 100% 60%, calc(100% - 8px) 65%, 100% 70%, 
        calc(100% - 8px) 75%, 100% 80%, calc(100% - 8px) 85%, 100% 90%, calc(100% - 8px) 95%, 
        100% 100%, 0 100%
      ) !important;
    }

    .ticket-wrapper.is-broken .ticket-stub {
      transform: translate(35px, 18px) rotate(9deg) !important;
      clip-path: polygon(
        0 0, 100% 0, 100% 100%, 0 100%, 0 95%, 8px 90%, 0 85%, 8px 80%, 0 75%, 8px 70%, 
        0 65%, 8px 60%, 0 55%, 8px 50%, 0 45%, 8px 40%, 0 35%, 8px 30%, 0 25%, 8px 20%, 
        0 15%, 8px 10%, 0 5%
      ) !important;
    }
  }

  .ticket-wrapper.ticket-gigante-final.is-broken .ticket-divider {
    opacity: 0 !important;
  }
</style>

<div id="page-root" class="flex flex-col min-h-screen bg-[#2A1612] text-[#FAF5F0] overflow-x-hidden">
  
  <!-- STAGE PORTAL TEMPORAL DE CANJE -->
  <div id="redeem-portal-stage"></div>

  <!-- NAVBAR COMPLETO -->
  <Navbar />

  <!-- BOTÓN DE REGRESO Y FECHA ACTUAL (Librando el navbar fijo con pt-20 / pt-28) -->
  <div class="pt-20 sm:pt-28 pb-1 max-w-7xl mx-auto px-5 md:px-8 w-full relative z-10">
    <div class="flex justify-between items-center py-1">
      <a href="/" onclick="if(history.length > 1){ history.back(); return false; }" class="btn-back group">
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#dcb041] group-hover:-translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
        </svg>
        <span>Regresar</span>
      </a>
      <div class="current-date-badge">
        <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#dcb041] flex-shrink-0 not-italic" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zM14.25 12h.008v.008H14.25v-.008zm0 2.25h.008v.008H14.25V15zm0 2.25h.008v.008H14.25v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"></path>
        </svg>
        <span>{fechaHoyFormatted}</span>
      </div>
    </div>
  </div>

